@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using apc.Client.Layout.Navigation
@using apc.Client.Services.Bancos
@using apc.Client.Services.Tenant
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject TenantCompanyContextClient TenantCompanyContextClient
@inject ChequeEmisionState ChequeEmision
@inject IAuthorizationService AuthorizationService
@implements IDisposable

<nav class="sidebar-nav @(IsCollapsed ? "sidebar-nav--collapsed" : "") @(IsMobile ? "sidebar-nav--mobile" : "")">
@if (!IsMobile)
{
    <div class="sidebar-brand">
        <i class="bi bi-h-square-fill sidebar-brand__logo"></i>
        <span class="sidebar-brand__text">HODSOFT</span>
    </div>
}

    @foreach (var navSection in visibleSections)
    {
        <div class="nav-section">
            @if (!string.IsNullOrEmpty(navSection.Label))
            {
                <div class="nav-section__label">@navSection.Label</div>
            }
            @foreach (var item in navSection.Items)
            {
                <SidebarNavNode Item="@item"
                                CurrentPath="@currentPath"
                                IsCollapsed="@IsCollapsed" />
            }
        </div>
    }
</nav>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsMobile { get; set; }

    private string currentPath = "/";
    private IReadOnlyList<SidebarNavSection> visibleSections = Array.Empty<SidebarNavSection>();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        ChequeEmision.Cambiado += HandleCapacidadesCambiadas;
        currentPath = GetCurrentPath();
    }

    protected override async Task OnInitializedAsync()
    {
        // Capacidades que dependen de la configuración de la empresa (no de permisos).
        await ChequeEmision.EnsureLoadedAsync();
        await ConstruirSeccionesAsync();
    }

    private async Task ConstruirSeccionesAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        esSuperAdmin = user.IsInRole(SIAD.Core.Constants.RoleNames.SuperAdministrador);

        usuarioActual = user;

        var sections = new List<SidebarNavSection>();
        foreach (var section in SidebarNavigationDefinition.Sections)
        {
            if (await TienePermisoAsync(section.RequiredPolicy))
            {
                sections.Add(section);
            }
        }

        if (user.Identity?.IsAuthenticated == true)
        {
            try
            {
                var tenantContext = await TenantCompanyContextClient.ObtenerAsync();
                if (!tenantContext.HasValidCompany)
                {
                    sections = FilterSectionsForRecovery(sections).ToList();
                }
            }
            catch (UnauthorizedAccessException)
            {
            }
            catch (HttpRequestException)
            {
            }
        }

        visibleSections = await FiltrarAsync(sections);
    }

    // Filtra por permiso del usuario, por capacidad de la empresa y por el flag de Super Admin.
    private async Task<IReadOnlyList<SidebarNavSection>> FiltrarAsync(IEnumerable<SidebarNavSection> sections)
    {
        var resultado = new List<SidebarNavSection>();

        foreach (var section in sections)
        {
            var items = new List<SidebarNavItem>();
            foreach (var item in section.Items)
            {
                var filtrado = await FiltrarItemAsync(item);
                if (filtrado is not null)
                {
                    items.Add(filtrado);
                }
            }

            if (items.Count == 0)
            {
                continue;
            }

            resultado.Add(new SidebarNavSection
            {
                Label = section.Label,
                Items = items,
                RequiredPolicy = section.RequiredPolicy
            });
        }

        return resultado;
    }

    private bool esSuperAdmin;
    private System.Security.Claims.ClaimsPrincipal usuarioActual = new(new System.Security.Claims.ClaimsIdentity());

    /// <summary>
    /// Evalúa la policy del permiso. Cada policy de <c>PermissionNames.Policies</c> ya incluye la
    /// cascada endpoint → opción → módulo → legacy, así que el menú oculta exactamente lo mismo
    /// que la API rechaza, sin duplicar la lógica aquí.
    /// </summary>
    private async Task<bool> TienePermisoAsync(string? policy)
    {
        if (string.IsNullOrEmpty(policy))
        {
            return true;
        }

        // Las policies ya contemplan el bypass, pero cortar antes evita ~100 evaluaciones por render.
        if (esSuperAdmin)
        {
            return true;
        }

        var resultado = await AuthorizationService.AuthorizeAsync(usuarioActual, policy);
        return resultado.Succeeded;
    }

    private async Task<SidebarNavItem?> FiltrarItemAsync(SidebarNavItem item)
    {
        if (item.SoloSuperAdmin && !esSuperAdmin)
        {
            return null;
        }

        if (!CapacidadDisponible(item.RequiredCapability))
        {
            return null;
        }

        if (!await TienePermisoAsync(item.RequiredPermission))
        {
            return null;
        }

        if (!item.HasChildren)
        {
            return item;
        }

        var children = new List<SidebarNavItem>();
        foreach (var child in item.Children)
        {
            var filtrado = await FiltrarItemAsync(child);
            if (filtrado is not null)
            {
                children.Add(filtrado);
            }
        }

        // Un grupo cuyos hijos quedaron todos ocultos no tiene nada que abrir: se oculta el grupo.
        // (Los grupos no navegan por sí mismos; su NavigateUrl, cuando existe, apunta al primer hijo.)
        if (children.Count == 0)
        {
            return null;
        }

        if (children.Count == item.Children.Count)
        {
            return item;
        }

        return new SidebarNavItem
        {
            Id = item.Id,
            Text = item.Text,
            IconCssClass = item.IconCssClass,
            NavigateUrl = item.NavigateUrl,
            MatchPrefixes = item.MatchPrefixes,
            Children = children,
            MatchExact = item.MatchExact,
            RequiredCapability = item.RequiredCapability,
            RequiredPermission = item.RequiredPermission,
            SoloSuperAdmin = item.SoloSuperAdmin
        };
    }

    private bool CapacidadDisponible(string? capability) => capability switch
    {
        null or "" => true,
        SidebarCapabilities.ChequeManual => ChequeEmision.Disponible,
        _ => true
    };

    // La configuración de tipos de transacción invalida el estado al guardar: el menú se
    // rearma sin recargar la aplicación.
    private void HandleCapacidadesCambiadas()
        => _ = InvokeAsync(async () =>
        {
            await ChequeEmision.EnsureLoadedAsync();
            await ConstruirSeccionesAsync();
            StateHasChanged();
        });

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentPath = GetCurrentPath();
        InvokeAsync(StateHasChanged);
    }

    private string GetCurrentPath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        var cleaned = relative.Split('?', '#')[0];
        if (!cleaned.StartsWith("/"))
        {
            cleaned = "/" + cleaned;
        }

        cleaned = cleaned.TrimEnd('/');
        return string.IsNullOrEmpty(cleaned) ? "/" : cleaned.ToLowerInvariant();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        ChequeEmision.Cambiado -= HandleCapacidadesCambiadas;
    }

    private static IReadOnlyList<SidebarNavSection> FilterSectionsForRecovery(IEnumerable<SidebarNavSection> sections)
    {
        var filteredSections = new List<SidebarNavSection>();

        foreach (var section in sections)
        {
            var filteredItems = section.Items
                .Select(FilterItemForRecovery)
                .Where(item => item is not null)
                .Cast<SidebarNavItem>()
                .ToArray();

            if (filteredItems.Length == 0)
            {
                continue;
            }

            filteredSections.Add(new SidebarNavSection
            {
                Label = section.Label,
                Items = filteredItems,
                RequiredPolicy = section.RequiredPolicy
            });
        }

        return filteredSections;
    }

    private static SidebarNavItem? FilterItemForRecovery(SidebarNavItem item)
    {
        var filteredChildren = item.Children
            .Select(FilterItemForRecovery)
            .Where(child => child is not null)
            .Cast<SidebarNavItem>()
            .ToArray();

        var filteredPrefixes = item.MatchPrefixes
            .Where(IsRecoveryAllowedPath)
            .ToArray();

        var allowSelf = IsRecoveryAllowedPath(item.NavigateUrl) || filteredPrefixes.Length > 0;
        if (!allowSelf && filteredChildren.Length == 0)
        {
            return null;
        }

        return new SidebarNavItem
        {
            Id = item.Id,
            Text = item.Text,
            IconCssClass = item.IconCssClass,
            NavigateUrl = allowSelf ? item.NavigateUrl : null,
            MatchPrefixes = filteredPrefixes,
            Children = filteredChildren,
            MatchExact = item.MatchExact,
            RequiredCapability = item.RequiredCapability,
            RequiredPermission = item.RequiredPermission,
            SoloSuperAdmin = item.SoloSuperAdmin
        };
    }

    private static bool IsRecoveryAllowedPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        return path.Equals("/contabilidad/empresas", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("/contabilidad/empresas/nueva", StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith("/contabilidad/empresas/editar/", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("/Account/Manage", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("/Account/Logout", StringComparison.OrdinalIgnoreCase);
    }
}
