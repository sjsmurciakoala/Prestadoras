@page "/facturacion/caja"
@using System.Globalization
@using SIAD.Core.Constants
@using SIAD.Core.DTOs.Caja
@using SIAD.Core.DTOs.CaptacionPagos
@using SIAD.Core.DTOs.Cobros
@using apc.Client.Services.Caja
@using apc.Client.Services.Cobros
@using apc.Client.Services.Tenant
@using apc.Client.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject CajaClient CajaHttp
@inject AbonoClient AbonoHttp
@inject CobrosClient CobrosHttp
@inject IToastNotificationService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TenantState TenantState

<PageTitle>SIAD - Caja</PageTitle>

<div class="page-container">

    <div class="header-section">
        <div>
            <h2 class="page-title">Caja</h2>
            <p class="page-subtitle">Cobro de documentos, reversos y control de la sesión de caja.</p>
        </div>
        <DxButton Text="Mantenimiento de cajas" IconCssClass="bi bi-gear"
                  RenderStyle="ButtonRenderStyle.Secondary" CssClass="btn-modern"
                  Click="@(() => Nav.NavigateTo("/facturacion/cajas"))" />
    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
        </div>
    }
    else
    {
        @* ---- Estado de MI caja / sesión ---- *@
        <div class="modern-card mb-3">
            <div class="p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (_sesionActiva is not null)
                    {
                        <span class="badge bg-success px-3 py-2 fs-6">ABIERTA</span>
                        <div>
                            <h5 class="mb-0 fw-bold">@(_miCaja?.Nombre ?? "Caja") · Turno #@_sesionActiva.Id</h5>
                            <small class="text-muted">
                                Cajero: <strong>@_usuario</strong> · abierto el @_sesionActiva.FechaApertura.ToString("dd/MM/yyyy HH:mm")
                                @if (_sesionActiva.MontoApertura is > 0)
                                {
                                    <text> · fondo inicial: <strong>@_sesionActiva.MontoApertura.Value.ToString("C", Culture)</strong></text>
                                }
                            </small>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2 fs-6">CERRADA</span>
                        <div>
                            @if (_miCaja is null)
                            {
                                <h5 class="mb-0 fw-bold">Sin caja asignada</h5>
                                <small class="text-muted">Solicite al administrador que le asigne una caja en el mantenimiento.</small>
                            }
                            else
                            {
                                <h5 class="mb-0 fw-bold">Su caja: @_miCaja.Nombre (@_miCaja.Codigo)</h5>
                                <small class="text-muted">
                                    @(_miCaja.Ocupada ? $"Ocupada por {_miCaja.OcupadaPor}." : "Disponible. Abra la sesión para comenzar a cobrar.")
                                </small>
                            }
                        </div>
                    }
                </div>
                <div>
                    @if (_sesionActiva is not null)
                    {
                        <DxButton Text="Cerrar caja" RenderStyle="ButtonRenderStyle.Danger"
                                  IconCssClass="bi bi-lock-fill" Click="AbrirConfirmarCierre" />
                    }
                    else
                    {
                        <DxButton Text="Abrir caja" RenderStyle="ButtonRenderStyle.Success"
                                  IconCssClass="bi bi-unlock-fill" Click="AbrirConfirmarApertura"
                                  Enabled="@(_miCaja is not null && !_miCaja.Ocupada)" />
                    }
                </div>
            </div>
        </div>

        <DxTabs @bind-ActiveTabIndex="_tabActiva" CssClass="modern-tabs">

            @* =============================== COBRAR =============================== *@
            <DxTabPage Text="Cobrar">
                <div class="p-3">
                    @if (_sesionActiva is null)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-lock fs-1 d-block mb-3"></i>
                            <p class="mb-0">Abra su caja para comenzar a cobrar.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted fw-bold">CLIENTE</label>
                                <ClienteLookup Value="@_clienteClave" ValueChanged="OnClienteSeleccionado"
                                               NullText="Buscar cliente por clave o nombre..." />
                            </div>
                            @* Entrada por documento: el cajero tiene el recibo impreso en la mano
                               y teclea el número (era la pestaña "Lectoras" del módulo viejo).
                               DxTextBox no tiene evento de tecla Enter (solo TextChanged/TextChanging,
                               ver docs DX); el Enter se captura con el submit del form y el texto se
                               mantiene al día con BindValueMode.OnInput. *@
                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">FACTURA / RECIBO</label>
                                <form @onsubmit="OnBuscarDocumento" @onsubmit:preventDefault>
                                    <div class="d-flex gap-1">
                                        <div class="flex-grow-1">
                                            <DxTextBox @bind-Text="_busquedaDocumento"
                                                       BindValueMode="BindValueMode.OnInput"
                                                       NullText="N° de factura o recibo..."
                                                       Enabled="@(!_buscandoDocumento)"
                                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </div>
                                        <DxButton IconCssClass="bi bi-search" SubmitFormOnClick="true"
                                                  RenderStyle="ButtonRenderStyle.Secondary"
                                                  Enabled="@(!_buscandoDocumento)" />
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-muted fw-bold">FECHA DE PAGO</label>
                                <DxDateEdit @bind-Date="_fechaPago" NullText="Hoy" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">FORMA DE PAGO</label>
                                <DxComboBox Data="@_formasPago" @bind-Value="_formaPago" />
                            </div>
                            @if (_formaPago == "BANCO")
                            {
                                <div class="col-md-4">
                                    <label class="form-label small text-muted fw-bold">CUENTA BANCARIA</label>
                                    <DxComboBox TData="BancoDto" TValue="long?" Data="@_bancos"
                                                TextFieldName="@nameof(BancoDto.Nombre)"
                                                ValueFieldName="@nameof(BancoDto.BancoCuentaId)"
                                                @bind-Value="_bancoCuentaId"
                                                NullText="Seleccione cuenta..." />
                                </div>
                            }
                        </div>

                        <div class="modern-card position-relative">
                            @* También cubre la búsqueda por N° de documento, con su propio texto,
                               para que el cajero vea qué está pasando y no un campo "pegado". *@
                            @* La señal de carga vive en el overlay modal de página (abajo),
                               común a búsqueda, carga de documentos, cobro y cobros del día. *@
                            <div class="grid-wrapper">
                                <DxGrid Data="@_documentos" KeyFieldName="DocKey" PageSize="10"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        ShowGroupPanel="false" CssClass="grid-solicitudes">
                                    <Columns>
                                        <DxGridDataColumn Caption="" Width="52px" AllowSort="false">
                                            <CellDisplayTemplate>
                                                @{ var row = (DocumentoCobroRow)context.DataItem; }
                                                <DxCheckBox Checked="@row.Seleccionado"
                                                            CheckedChanged="@((bool v) => ToggleSeleccion(row, v))" />
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="NumFactura" Caption="Factura" />
                                        <DxGridDataColumn FieldName="NumRecibo" Caption="Recibo" Width="110px" DisplayFormat="0" TextAlignment="GridTextAlignment.Center" />
                                        <DxGridDataColumn FieldName="FechaEmision" Caption="Emisión" DisplayFormat="dd/MM/yyyy" Width="110px" />
                                        <DxGridDataColumn FieldName="Estado" Caption="Estado" Width="90px" TextAlignment="GridTextAlignment.Center">
                                            <CellDisplayTemplate>
                                                @{ var row = (DocumentoCobroRow)context.DataItem; }
                                                <span class="badge @(row.Estado == "B" ? "bg-warning text-dark" : "bg-primary")">
                                                    @(row.Estado == "B" ? "PARCIAL" : "PENDIENTE")
                                                </span>
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="SaldoPendiente" Caption="Saldo" DisplayFormat="{0:N2}" Width="130px" TextAlignment="GridTextAlignment.Right" />
                                        <DxGridDataColumn Caption="Monto a cobrar" Width="170px" TextAlignment="GridTextAlignment.Right" AllowSort="false">
                                            <CellDisplayTemplate>
                                                @{ var row = (DocumentoCobroRow)context.DataItem; }
                                                <DxSpinEdit Value="@row.MontoCobrar"
                                                            ValueChanged="@((decimal v) => CambiarMonto(row, v))"
                                                            ValueExpression="@(() => row.MontoCobrar)"
                                                            MinValue="0" MaxValue="@row.SaldoPendiente"
                                                            DisplayFormat="N2" Enabled="@row.Seleccionado" />
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn Caption="" Width="60px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
                                            <CellDisplayTemplate>
                                                @{ var row = (DocumentoCobroRow)context.DataItem; }
                                                @* El recibo para banco aplica a facturas; las cuotas de plan se cobran en caja (F6). *@
                                                @if (row.DocumentoTipo == DocumentoCobroTipo.Factura)
                                                {
                                                    <DxButton IconCssClass="bi bi-bank" RenderStyle="ButtonRenderStyle.Secondary"
                                                              RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                              title="Generar recibo para pagar en banco"
                                                              Click="@(() => AbrirReciboBanco(row))" />
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                </DxGrid>
                            </div>
                        </div>

                        @if (_pendientes.Count > 0)
                        {
                            <div class="modern-card mt-3">
                                <div class="p-2">
                                    <h6 class="fw-bold mb-2"><i class="bi bi-bank me-1"></i>Recibos pendientes para banco</h6>
                                    <DxGrid Data="@_pendientes" KeyFieldName="PendienteId" PageSize="5"
                                            ShowGroupPanel="false" CssClass="grid-solicitudes">
                                        <Columns>
                                            <DxGridDataColumn FieldName="NumFactura" Caption="Factura" />
                                            <DxGridDataColumn FieldName="Monto" Caption="Monto" DisplayFormat="{0:N2}" Width="130px" TextAlignment="GridTextAlignment.Right" />
                                            <DxGridDataColumn FieldName="FechaGenerado" Caption="Generado" Width="110px" />
                                            <DxGridDataColumn FieldName="Operador" Caption="Operador" Width="160px" />
                                            <DxGridDataColumn Caption="Acciones" Width="160px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
                                                <CellDisplayTemplate>
                                                    @{ var p = (ReciboPendienteDto)context.DataItem; }
                                                    <div class="d-flex gap-1 justify-content-center">
                                                        <DxButton IconCssClass="bi bi-cash-coin" RenderStyle="ButtonRenderStyle.Success"
                                                                  RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                                  title="Cobrar este recibo en caja"
                                                                  Click="@(() => CobrarPendiente(p))" />
                                                        <DxButton IconCssClass="bi bi-printer" RenderStyle="ButtonRenderStyle.Secondary"
                                                                  RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                                  title="Reimprimir"
                                                                  Click="@(() => AbrirReciboPendiente(p.PendienteId))" />
                                                        <DxButton IconCssClass="bi bi-x-circle" RenderStyle="ButtonRenderStyle.Danger"
                                                                  RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                                  title="Anular recibo pendiente"
                                                                  Click="@(() => AbrirAnularPendiente(p))" />
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>
                                        </Columns>
                                    </DxGrid>
                                </div>
                            </div>
                        }

                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-3">
                            <div class="text-muted">
                                Documentos seleccionados: <strong>@_documentos.Count(d => d.Seleccionado)</strong>
                                · Saldo total del cliente: <strong>@_documentos.Sum(d => d.SaldoPendiente).ToString("C", Culture)</strong>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fs-5">Total a cobrar: <strong class="text-success">@TotalACobrar.ToString("C", Culture)</strong></span>
                                <DxButton Text="@(_cobrando ? "Registrando..." : "Cobrar")"
                                          RenderStyle="ButtonRenderStyle.Success" SizeMode="SizeMode.Large"
                                          IconCssClass="bi bi-cash-coin" Click="OnCobrar"
                                          Enabled="@(TotalACobrar > 0 && !_cobrando)" />
                            </div>
                        </div>
                    }
                </div>
            </DxTabPage>

            @* =========================== COBROS DEL DÍA =========================== *@
            <DxTabPage Text="Cobros del día">
                <div class="p-3">
                    <div class="modern-card position-relative">
                        <div class="grid-wrapper">
                            <DxGrid Data="@_cobrosDelDia" KeyFieldName="PagoId" PageSize="15"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    ShowGroupPanel="false" CssClass="grid-solicitudes">
                                <ToolbarTemplate>
                                    <div class="d-flex flex-wrap gap-2 align-items-center w-100 p-2">
                                        <DxCheckBox Checked="@_soloMiCaja" CheckedChanged="@((bool v) => CambiarFiltroCobros(v))"
                                                    Enabled="@(_miCaja is not null)">Solo mi caja (@(_miCaja?.Nombre ?? "sin asignar"))</DxCheckBox>
                                        @* Consulta rápida de días anteriores. Lista por fecha de REGISTRO
                                           (creado_en): lo tecleado ese día, aunque su fecha valor sea otra. *@
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="text-muted small">Día:</span>
                                            <DxDateEdit Date="@_fechaCobrosDia"
                                                        DateChanged="@((DateTime v) => CambiarFechaCobros(v))" />
                                        </div>
                                        <DxButton Text="Actualizar" IconCssClass="bi bi-arrow-clockwise"
                                                  RenderStyle="ButtonRenderStyle.Secondary" Click="CargarCobrosDelDiaAsync" />
                                        <div class="ms-auto text-muted small">
                                            Total cobrado (@(_soloMiCaja ? "mi caja" : "todas las cajas")):
                                            <span class="fw-bold">@_cobrosDelDia.Where(c => c.EstadoId == EstadoPago.Aplicado).Sum(c => c.MontoTotal).ToString("C", Culture)</span>
                                        </div>
                                    </div>
                                </ToolbarTemplate>
                                <Columns>
                                    <DxGridDataColumn FieldName="NumeroRecibo" Caption="Recibo" Width="140px" />
                                    <DxGridDataColumn FieldName="ClienteClave" Caption="Clave" Width="110px" />
                                    <DxGridDataColumn FieldName="ClienteNombre" Caption="Cliente" />
                                    <DxGridDataColumn FieldName="MontoTotal" Caption="Monto" DisplayFormat="{0:N2}" Width="120px" TextAlignment="GridTextAlignment.Right" />
                                    <DxGridDataColumn FieldName="FormaPago" Caption="Forma" Width="100px" TextAlignment="GridTextAlignment.Center" />
                                    <DxGridDataColumn FieldName="CajaNombre" Caption="Caja" Width="120px" />
                                    <DxGridDataColumn FieldName="Usuario" Caption="Cajero" Width="140px" />
                                    <DxGridDataColumn FieldName="Estado" Caption="Estado" Width="110px" TextAlignment="GridTextAlignment.Center">
                                        <CellDisplayTemplate>
                                            @{ var c = (CobroDelDiaDto)context.DataItem; }
                                            <span class="badge @(c.EstadoId == EstadoPago.Aplicado ? "bg-success" : "bg-danger")">@c.Estado</span>
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn Caption="Acciones" Width="130px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
                                        <CellDisplayTemplate>
                                            @{ var c = (CobroDelDiaDto)context.DataItem; }
                                            <div class="d-flex gap-1 justify-content-center">
                                                @* Siempre disponible: el recibo se imprime desde adm_pago (F7 2c-1). *@
                                                <DxButton IconCssClass="bi bi-printer" RenderStyle="ButtonRenderStyle.Secondary"
                                                          RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                          title="Reimprimir recibo"
                                                          Click="@(() => AbrirRecibo(c.PagoId))" />
                                                @if (c.EstadoId == EstadoPago.Aplicado)
                                                {
                                                    <DxButton IconCssClass="bi bi-arrow-counterclockwise" RenderStyle="ButtonRenderStyle.Danger"
                                                              RenderStyleMode="ButtonRenderStyleMode.Outline" SizeMode="SizeMode.Small"
                                                              title="Reversar cobro"
                                                              Click="@(() => AbrirReverso(c))" />
                                                }
                                            </div>
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                </Columns>
                            </DxGrid>
                        </div>
                    </div>
                </div>
            </DxTabPage>

            @* =========================== RESUMEN DEL TURNO ======================== *@
            <DxTabPage Text="Resumen del turno">
                <div class="p-3">
                    @if (_sesionActiva is not null && _resumen is not null)
                    {
                        <p class="text-muted small mb-3">
                            El turno agrupa todo lo cobrado desde que abrió su caja hasta el cierre —
                            es la base del arqueo: cuánto debe entregar al cerrar.
                        </p>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="p-3 border rounded d-flex align-items-center justify-content-between">
                                    <div>
                                        <small class="text-muted d-block text-uppercase fw-bold">Total cobrado</small>
                                        <span class="fs-3 fw-bold text-success">@_resumen.TotalCreditos.ToString("C", Culture)</span>
                                    </div>
                                    <i class="bi bi-cash-coin fs-2 text-success"></i>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded d-flex align-items-center justify-content-between">
                                    <div>
                                        <small class="text-muted d-block text-uppercase fw-bold">Cobros</small>
                                        <span class="fs-3 fw-bold text-primary">@_resumen.CantidadTransacciones</span>
                                    </div>
                                    <i class="bi bi-receipt-cutoff fs-2 text-primary"></i>
                                </div>
                            </div>
                            @if (_resumen.TotalDebitos > 0)
                            {
                                <div class="col-md-4">
                                    <div class="p-3 border rounded d-flex align-items-center justify-content-between">
                                        <div>
                                            <small class="text-muted d-block text-uppercase fw-bold">Reversado</small>
                                            <span class="fs-3 fw-bold text-danger">@_resumen.TotalDebitos.ToString("C", Culture)</span>
                                        </div>
                                        <i class="bi bi-arrow-counterclockwise fs-2 text-danger"></i>
                                    </div>
                                </div>
                            }
                        </div>
                        <DxGrid Data="_resumen.PorTipo" ShowGroupPanel="false" CssClass="grid-solicitudes">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(ResumenPorTipoDto.Tipo)" Caption="Forma de pago" />
                                <DxGridDataColumn FieldName="@nameof(ResumenPorTipoDto.Cantidad)" Caption="Cobros" Width="120px" TextAlignment="GridTextAlignment.Center" />
                                <DxGridDataColumn FieldName="@nameof(ResumenPorTipoDto.Creditos)" Caption="Cobrado" DisplayFormat="{0:C}" Width="180px" TextAlignment="GridTextAlignment.Right" />
                            </Columns>
                        </DxGrid>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            <p class="mb-0">Abra su caja para ver el resumen del turno.</p>
                        </div>
                    }
                </div>
            </DxTabPage>

            @* ========================= HISTORIAL DE CIERRES ======================= *@
            <DxTabPage Text="Historial de cierres">
                <div class="p-3">
                    <DxGrid Data="_historial" ShowGroupPanel="false" PageSize="10" CssClass="grid-solicitudes">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.SesionId)" Caption="Sesión" Width="90px" TextAlignment="GridTextAlignment.Center" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.FechaApertura)" Caption="Apertura" DisplayFormat="dd/MM/yyyy HH:mm" Width="170px" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.FechaCierre)" Caption="Cierre" DisplayFormat="dd/MM/yyyy HH:mm" Width="170px" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.UsuarioApertura)" Caption="Cajero" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.TotalCobrado)" Caption="Total cobrado" DisplayFormat="{0:C}" Width="150px" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.MontoApertura)" Caption="Fondo inicial" DisplayFormat="{0:C}" Width="130px" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.MontoCierre)" Caption="Efectivo contado" DisplayFormat="{0:C}" Width="140px" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(HistorialCierreDto.Observacion)" Caption="Observación" />
                        </Columns>
                    </DxGrid>
                </div>
            </DxTabPage>
        </DxTabs>
    }
</div>

@* ---- Overlay modal de página completa para TODA operación de la caja ----
     Patrón PositionTarget="body" de la doc de DxLoadingPanel: panel centrado
     sobre toda la página, no sobre el área del grid. Único punto de señal:
     cobro, búsqueda por documento, carga de documentos y cobros del día. *@
<DxLoadingPanel Visible="@(_cobrando || _buscandoDocumento || _cargandoDocs || _cargandoCobrosDia)"
                PositionTarget="body"
                ApplyBackgroundShading="true"
                Text="@(_cobrando ? "Registrando el cobro, un momento..."
                      : _buscandoDocumento ? "Buscando documento..."
                      : _cargandoDocs ? "Cargando documentos del cliente..."
                      : "Cargando cobros del día...")" />

@* ---- Popup confirmar apertura de caja ---- *@
<DxPopup @bind-Visible="_aperturaVisible" HeaderText="Abrir caja" Width="420px" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="p-3">
            <p class="mb-2">
                Va a abrir el turno de <strong>@_miCaja?.Nombre (@_miCaja?.Codigo)</strong>
                como cajero <strong>@_usuario</strong>. Todos los cobros del turno
                quedarán amarrados a esta caja para el arqueo y el cierre.
            </p>
            <label class="form-label small text-muted fw-bold">FONDO INICIAL (OPCIONAL)</label>
            <DxSpinEdit @bind-Value="_montoApertura" MinValue="0" DisplayFormat="N2" CssClass="w-100"
                        NullText="Efectivo con el que inicia la caja..." />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => _aperturaVisible = false)" />
                <DxButton Text="Abrir caja" RenderStyle="ButtonRenderStyle.Success" Click="OnAbrirCaja" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@* ---- Popup confirmar cierre de caja ---- *@
<DxPopup @bind-Visible="_cierreVisible" HeaderText="Cerrar caja" Width="460px" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="p-3">
            <p class="mb-2">
                Cierre del turno <strong>#@_sesionActiva?.Id</strong> de
                <strong>@_miCaja?.Nombre</strong>:
            </p>
            <ul class="mb-3">
                <li>Cobros del turno: <strong>@(_resumen?.CantidadTransacciones ?? 0)</strong></li>
                <li>Total cobrado (sistema): <strong>@((_resumen?.TotalCreditos ?? 0m).ToString("C", Culture))</strong></li>
                <li>Fondo inicial: <strong>@((_sesionActiva?.MontoApertura ?? 0m).ToString("C", Culture))</strong></li>
                <li>Efectivo esperado en caja (fondo + efectivo cobrado):
                    <strong>@EfectivoEsperado.ToString("C", Culture)</strong></li>
            </ul>
            <label class="form-label small text-muted fw-bold">EFECTIVO CONTADO (ARQUEO) *</label>
            <DxSpinEdit @bind-Value="_montoCierre" MinValue="0" DisplayFormat="N2" CssClass="w-100 mb-2"
                        NullText="Cuente el efectivo físico de la caja..." />
            @if (_montoCierre is not null)
            {
                var dif = _montoCierre.Value - EfectivoEsperado;
                <p class="mb-2 @(dif == 0 ? "text-success" : "text-danger")">
                    <i class="bi @(dif == 0 ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
                    @(dif == 0
                        ? "El arqueo cuadra con el sistema."
                        : $"Diferencia contra el sistema: {dif.ToString("C", Culture)} ({(dif > 0 ? "sobrante" : "faltante")}). Explíquela en las observaciones.")
                </p>
            }
            <label class="form-label small text-muted fw-bold">OBSERVACIONES DEL CIERRE</label>
            <DxMemo @bind-Text="_observacionCierre" Rows="2" CssClass="w-100" NullText="Diferencias, notas del arqueo..." />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => _cierreVisible = false)" />
                <DxButton Text="Confirmar cierre" RenderStyle="ButtonRenderStyle.Danger" Click="OnCerrarCaja"
                          Enabled="@(_montoCierre is not null)" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@* ---- Popup recibo para banco ---- *@
<DxPopup @bind-Visible="_reciboBancoVisible" HeaderText="Recibo para pagar en banco" Width="420px" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="p-3">
            <p class="mb-2">
                Factura <strong>@_reciboBancoDoc?.NumFactura</strong> ·
                saldo <strong>@(_reciboBancoDoc?.SaldoPendiente.ToString("C", Culture))</strong>.
                El recibo NO rebaja la factura: el cliente lo lleva al banco y el
                pago se aplica cuando el banco lo reporta.
            </p>
            @if (_reciboBancoPendientes > 0)
            {
                <p class="mb-2 text-warning-emphasis">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Esta factura ya tiene recibos pendientes por
                    <strong>@_reciboBancoPendientes.ToString("C", Culture)</strong> —
                    disponible para nuevos recibos: <strong>@_reciboBancoDisponible.ToString("C", Culture)</strong>.
                </p>
            }
            <label class="form-label small text-muted fw-bold">MONTO DEL RECIBO</label>
            @* MinValue 0 (no 0.01): si el disponible fuera menor al mínimo el
               rango sería inválido; el botón Generar exige monto > 0. *@
            <DxSpinEdit @bind-Value="_reciboBancoMonto" MinValue="0"
                        MaxValue="@Math.Max(_reciboBancoDisponible, 0m)"
                        DisplayFormat="N2" CssClass="w-100" />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => _reciboBancoVisible = false)" />
                <DxButton Text="Generar recibo" RenderStyle="ButtonRenderStyle.Primary"
                          Click="OnGenerarReciboBanco" Enabled="@(_reciboBancoMonto > 0)" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@* ---- Popup anular pendiente ---- *@
<DxPopup @bind-Visible="_anularPendienteVisible" HeaderText="Anular recibo pendiente" Width="420px" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="p-3">
            <p class="mb-2">
                Anular el recibo de <strong>@(_anularPendienteRecibo?.Monto.ToString("C", Culture))</strong>
                de la factura <strong>@_anularPendienteRecibo?.NumFactura</strong>.
            </p>
            <label class="form-label small text-muted fw-bold">MOTIVO</label>
            <DxMemo @bind-Text="_anularPendienteMotivo" Rows="3" CssClass="w-100" NullText="Motivo de la anulación..." />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => _anularPendienteVisible = false)" />
                <DxButton Text="Anular" RenderStyle="ButtonRenderStyle.Danger"
                          Click="OnAnularPendiente" Enabled="@(!string.IsNullOrWhiteSpace(_anularPendienteMotivo))" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@* ---- Popup de reverso ---- *@
<DxPopup @bind-Visible="_reversoVisible" HeaderText="Reversar cobro" Width="420px" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="p-3">
            <p class="mb-2">
                Reversar el recibo <strong>@_reversoCobro?.NumeroRecibo</strong>
                de <strong>@_reversoCobro?.ClienteNombre</strong>
                por <strong>@_reversoCobro?.MontoTotal.ToString("C", Culture)</strong>.
            </p>
            <label class="form-label small text-muted fw-bold">MOTIVO</label>
            <DxMemo @bind-Text="_reversoMotivo" Rows="3" CssClass="w-100" NullText="Motivo del reverso..." />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => _reversoVisible = false)" />
                <DxButton Text="Reversar" RenderStyle="ButtonRenderStyle.Danger"
                          Click="OnReversar" Enabled="@(!string.IsNullOrWhiteSpace(_reversoMotivo))" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    private static readonly CultureInfo Culture = new("es-HN");
    private static readonly string[] _formasPago = ["EFECTIVO", "BANCO"];

    private bool _cargando = true;
    private bool _cargandoDocs;
    private bool _cobrando;
    private int _tabActiva;
    private string _usuario = "sistema";
    private string? _observacionCierre;
    private bool _aperturaVisible;
    private decimal? _montoApertura;
    private bool _cierreVisible;
    private decimal? _montoCierre;

    // Fondo inicial + efectivo cobrado según el sistema (lo que debe haber en el cajón).
    private decimal EfectivoEsperado =>
        (_sesionActiva?.MontoApertura ?? 0m) +
        (_resumen?.PorTipo.FirstOrDefault(t => t.Tipo == "EFECTIVO")?.Creditos ?? 0m);

    private SesionCajaDto? _sesionActiva;
    private MiCajaDto? _miCaja;
    private ResumenCajaDto? _resumen;
    private IReadOnlyList<HistorialCierreDto> _historial = [];

    private string? _clienteClave;
    private List<DocumentoCobroRow> _documentos = [];
    // Entrada por documento (flujo "Lectoras") y fecha de cobro retroactiva:
    // el motor ya soporta ambas (CobroCrearDto.FechaPago); faltaba exponerlas.
    private string _busquedaDocumento = string.Empty;
    private bool _buscandoDocumento;
    private DateTime? _fechaPago = DateTime.Today;
    private string _formaPago = "EFECTIVO";
    private long? _bancoCuentaId;
    private IReadOnlyList<BancoDto> _bancos = [];

    private IReadOnlyList<CobroDelDiaDto> _cobrosDelDia = [];
    private bool _soloMiCaja = true;
    private DateTime _fechaCobrosDia = DateTime.Today;
    private bool _cargandoCobrosDia;

    private bool _reversoVisible;
    private CobroDelDiaDto? _reversoCobro;
    private string _reversoMotivo = string.Empty;

    private IReadOnlyList<ReciboPendienteDto> _pendientes = [];
    private bool _reciboBancoVisible;
    private DocumentoCobroRow? _reciboBancoDoc;
    private decimal _reciboBancoMonto;
    private bool _anularPendienteVisible;
    private ReciboPendienteDto? _anularPendienteRecibo;
    private string _anularPendienteMotivo = string.Empty;

    private decimal TotalACobrar => _documentos.Where(d => d.Seleccionado).Sum(d => d.MontoCobrar);

    // Fila del grid de cobro: documento pendiente + selección + monto editable.
    private sealed class DocumentoCobroRow
    {
        public int FacturaId { get; init; }
        // F6/F7: la caja también cobra cuotas de plan y notas de débito.
        public short DocumentoTipo { get; init; } = DocumentoCobroTipo.Factura;
        public int? PlanCuotaId { get; init; }
        public long? NotaDebitoId { get; init; }
        public string NumFactura { get; init; } = string.Empty;
        public int NumRecibo { get; init; }
        public DateTime FechaEmision { get; init; }
        public string Estado { get; init; } = "A";
        public decimal SaldoPendiente { get; init; }
        public bool Seleccionado { get; set; }
        public decimal MontoCobrar { get; set; }

        // Clave única del grid: facturas, cuotas y ND comparten la lista.
        public string DocKey => DocumentoTipo switch
        {
            DocumentoCobroTipo.CuotaPlan => $"C{PlanCuotaId}",
            DocumentoCobroTipo.NotaDebito => $"D{NotaDebitoId}",
            _ => $"F{FacturaId}"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await TenantState.EnsureCompanyAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _usuario = authState.User.Identity?.Name ?? "sistema";

        _bancos = await CobrosHttp.GetBancosAsync();
        await CargarEstadoAsync();
        await CargarCobrosDelDiaAsync();
        _cargando = false;
    }

    private async Task CargarEstadoAsync()
    {
        _miCaja = await CajaHttp.GetMiCajaAsync();
        _sesionActiva = await CajaHttp.GetSesionActivaAsync(_usuario);
        if (_sesionActiva is not null)
            _resumen = await CajaHttp.GetResumenAsync(_sesionActiva.Id);
        _historial = await CajaHttp.GetHistorialAsync(_usuario) ?? [];
    }

    private void AbrirConfirmarApertura()
    {
        _montoApertura = null;
        _aperturaVisible = true;
    }

    private async Task OnAbrirCaja()
    {
        try
        {
            var result = await CajaHttp.AbrirAsync(new AbrirCajaRequestDto(_usuario, null, _montoApertura));
            Notificar(result?.Success == true, result?.Message ?? "Error al abrir caja.");
            if (result?.Success == true)
            {
                _aperturaVisible = false;
                await CargarEstadoAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    private async Task AbrirConfirmarCierre()
    {
        if (_sesionActiva is null) return;
        // Refrescar el resumen para que el popup muestre los totales al momento.
        _resumen = await CajaHttp.GetResumenAsync(_sesionActiva.Id);
        _observacionCierre = null;
        _montoCierre = null;
        _cierreVisible = true;
    }

    private async Task OnCerrarCaja()
    {
        if (_sesionActiva is null) return;
        try
        {
            var result = await CajaHttp.CerrarAsync(new CerrarCajaRequestDto(_sesionActiva.Id, _usuario, _observacionCierre, _montoCierre));
            Notificar(result?.Success == true, result?.Message ?? "Error al cerrar caja.");
            if (result?.Success == true)
            {
                _cierreVisible = false;
                _observacionCierre = null;
                _clienteClave = null;
                _documentos = [];
                _pendientes = [];
                await CargarEstadoAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    // ---------------- Cobro ----------------

    /// <summary>
    /// Búsqueda por N° de factura o recibo: carga al cliente dueño del documento
    /// y deja ese documento preseleccionado con su saldo. Reemplaza la pestaña
    /// "Lectoras" del módulo viejo, donde se cobraba con el recibo en la mano.
    /// </summary>
    private async Task OnBuscarDocumento()
    {
        var term = _busquedaDocumento?.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        // El panel de carga aparece solo si la operación supera 200 ms (patrón
        // anti-parpadeo de la doc de DxLoadingPanel): la búsqueda indexada
        // resuelve en milisegundos y no amerita flash; una lenta (disco frío)
        // sí muestra señal en vez de quedarse "pegada".
        var busqueda = BuscarYSeleccionarDocumentoAsync(term);
        var umbral = Task.Delay(200);
        if (await Task.WhenAny(busqueda, umbral) == umbral && !busqueda.IsCompleted)
        {
            _buscandoDocumento = true;
            StateHasChanged();
        }
        try
        {
            await busqueda;
        }
        finally
        {
            _buscandoDocumento = false;
        }
    }

    private async Task BuscarYSeleccionarDocumentoAsync(string term)
    {
        {
            var encontradas = await AbonoHttp.BuscarFacturasConSaldoAsync(term) ?? [];
            if (encontradas.Count == 0)
            {
                Notificar(false, $"No se encontró ninguna factura o recibo con saldo para «{term}».");
                return;
            }

            // Coincidencia exacta por número de factura o de recibo; si no la hay
            // y el término trajo un solo resultado, se usa ese.
            var doc = encontradas.FirstOrDefault(f =>
                          string.Equals(f.NumFactura?.Trim(), term, StringComparison.OrdinalIgnoreCase)
                          || f.NumRecibo.ToString() == term)
                      ?? (encontradas.Count == 1 ? encontradas[0] : null);

            if (doc is null)
            {
                // Si todo lo hallado pertenece a UN MISMO cliente (p. ej. se
                // tecleó la clave del cliente en este campo), se carga ese
                // cliente con todos sus documentos, sin preseleccionar ninguno.
                var claves = encontradas.Select(f => f.ClienteClave).Distinct().ToList();
                if (claves.Count == 1)
                {
                    await OnClienteSeleccionado(claves[0]);
                    _busquedaDocumento = string.Empty;
                    return;
                }

                Notificar(false, $"«{term}» coincide con {encontradas.Count} documentos de {claves.Count} clientes. Precise el número.");
                return;
            }

            await OnClienteSeleccionado(doc.ClienteClave);

            var fila = _documentos.FirstOrDefault(d =>
                d.DocumentoTipo == doc.DocumentoTipo
                && d.FacturaId == doc.FacturaId
                && d.PlanCuotaId == doc.PlanCuotaId
                && d.NotaDebitoId == doc.NotaDebitoId);

            if (fila is null)
            {
                Notificar(false, "El documento ya no tiene saldo pendiente.");
                return;
            }

            // Solo el documento buscado queda marcado.
            foreach (var d in _documentos) d.Seleccionado = false;
            fila.Seleccionado = true;
            fila.MontoCobrar = fila.SaldoPendiente;
            _busquedaDocumento = string.Empty;
        }
    }

    private async Task OnClienteSeleccionado(string? clave)
    {
        _clienteClave = clave;
        _documentos = [];
        _pendientes = [];
        if (string.IsNullOrWhiteSpace(clave)) return;

        // Mismo umbral anti-parpadeo de 200 ms que la búsqueda por documento.
        var carga = CargarDocumentosClienteAsync(clave);
        var umbral = Task.Delay(200);
        if (await Task.WhenAny(carga, umbral) == umbral && !carga.IsCompleted)
        {
            _cargandoDocs = true;
            StateHasChanged();
        }
        try
        {
            await carga;
        }
        finally
        {
            _cargandoDocs = false;
        }
    }

    private async Task CargarDocumentosClienteAsync(string clave)
    {
        {
            var facturas = await AbonoHttp.ListarFacturasPendientesPorClienteAsync(clave) ?? [];
            _documentos = facturas
                .Where(f => f.SaldoPendiente > 0)
                .Select(f => new DocumentoCobroRow
                {
                    FacturaId = f.FacturaId,
                    DocumentoTipo = f.DocumentoTipo,
                    PlanCuotaId = f.PlanCuotaId,
                    NotaDebitoId = f.NotaDebitoId,
                    NumFactura = f.NumFactura,
                    NumRecibo = f.NumRecibo,
                    FechaEmision = f.FechaEmision,
                    Estado = f.Estado,
                    SaldoPendiente = f.SaldoPendiente,
                    MontoCobrar = f.SaldoPendiente
                })
                .ToList();

            _pendientes = await AbonoHttp.ListarRecibosPendientesPorClienteAsync(clave) ?? [];
        }
    }

    // ---------------- Recibo para banco (pendiente, NO rebaja la factura) ----------------

    private decimal _reciboBancoPendientes;
    private decimal _reciboBancoDisponible;

    private void AbrirReciboBanco(DocumentoCobroRow doc)
    {
        // Control de recibos: lo ya emitido en pendientes descuenta el disponible
        // (el backend valida lo mismo — esto solo evita el error al usuario).
        var pendientes = _pendientes.Where(p => p.NumRecibo == doc.NumRecibo).Sum(p => p.Monto);
        var disponible = Math.Max(doc.SaldoPendiente - pendientes, 0m);
        if (disponible <= 0)
        {
            // Sin disponible no se abre el popup: el DxSpinEdit no admite
            // MaxValue < MinValue y el saldo ya está cubierto por pendientes.
            Notificar(false, $"La factura {doc.NumFactura} ya tiene recibos pendientes por todo su saldo ({pendientes.ToString("C", Culture)}). Anule un pendiente si necesita emitir otro.");
            return;
        }

        _reciboBancoDoc = doc;
        _reciboBancoPendientes = pendientes;
        _reciboBancoDisponible = disponible;
        _reciboBancoMonto = disponible;
        _reciboBancoVisible = true;
    }

    private async Task OnGenerarReciboBanco()
    {
        if (_reciboBancoDoc is null || string.IsNullOrWhiteSpace(_clienteClave)) return;

        try
        {
            var result = await AbonoHttp.GenerarReciboPendienteAsync(new GenerarReciboDto
            {
                NumFactura = _reciboBancoDoc.NumFactura,
                ClienteClave = _clienteClave,
                Monto = _reciboBancoMonto
            });

            Notificar(result?.Success == true, result?.Message ?? "No se pudo generar el recibo.");
            if (result?.Success == true)
            {
                _reciboBancoVisible = false;
                var datos = Deserializar<GenerarReciboResponseDto>(result.Data);
                if (datos?.PendienteId is > 0)
                    await AbrirReciboPendiente(datos.PendienteId);
                _pendientes = await AbonoHttp.ListarRecibosPendientesPorClienteAsync(_clienteClave) ?? [];
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    private async Task CobrarPendiente(ReciboPendienteDto pendiente)
    {
        var doc = _documentos.FirstOrDefault(d => d.NumRecibo == pendiente.NumRecibo);
        if (doc is null)
        {
            Notificar(false, "La factura del recibo ya no tiene saldo pendiente; anule el recibo.");
            return;
        }

        try
        {
            var monto = Math.Min(pendiente.Monto, doc.SaldoPendiente);
            var result = await CobrosHttp.RegistrarAsync(new CobroCrearDto
            {
                Canal = CanalCobro.Caja,
                ClienteClave = _clienteClave!,
                FormaPago = "EFECTIVO",
                ReciboPendienteId = pendiente.PendienteId,
                Aplicaciones =
                [
                    new CobroAplicacionDto { DocumentoTipo = DocumentoCobroTipo.Factura, FacturaId = doc.FacturaId, Monto = monto }
                ]
            });

            if (result?.Success == true)
            {
                var datos = Deserializar<CobroResultadoDto>(result.Data);
                Notificar(true, $"Recibo cobrado. Folio {datos?.NumeroRecibo}.");
                if (datos?.PagoId is > 0)
                    await AbrirRecibo(datos.PagoId);
                await OnClienteSeleccionado(_clienteClave);
                await CargarCobrosDelDiaAsync();
            }
            else
            {
                Notificar(false, result?.Message ?? "No se pudo cobrar el recibo.");
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    private void AbrirAnularPendiente(ReciboPendienteDto pendiente)
    {
        _anularPendienteRecibo = pendiente;
        _anularPendienteMotivo = string.Empty;
        _anularPendienteVisible = true;
    }

    private async Task OnAnularPendiente()
    {
        if (_anularPendienteRecibo is null) return;
        try
        {
            var result = await AbonoHttp.AnularReciboPendienteAsync(new AnularReciboPendienteDto
            {
                PendienteId = _anularPendienteRecibo.PendienteId,
                Usuario = _usuario,
                Motivo = _anularPendienteMotivo.Trim()
            });
            Notificar(result?.Success == true, result?.Message ?? "No se pudo anular.");
            if (result?.Success == true)
            {
                _anularPendienteVisible = false;
                _pendientes = await AbonoHttp.ListarRecibosPendientesPorClienteAsync(_clienteClave!) ?? [];
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    private static T? Deserializar<T>(object? data) where T : class
        => data is null ? null : System.Text.Json.JsonSerializer.Deserialize<T>(
            System.Text.Json.JsonSerializer.Serialize(data),
            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

    private void ToggleSeleccion(DocumentoCobroRow row, bool valor)
    {
        row.Seleccionado = valor;
        if (valor && row.MontoCobrar <= 0) row.MontoCobrar = row.SaldoPendiente;
    }

    private void CambiarMonto(DocumentoCobroRow row, decimal valor) => row.MontoCobrar = valor;

    private async Task OnCobrar()
    {
        var seleccionados = _documentos.Where(d => d.Seleccionado && d.MontoCobrar > 0).ToList();
        if (seleccionados.Count == 0) return;
        if (_formaPago == "BANCO" && _bancoCuentaId is null or <= 0)
        {
            Notificar(false, "Seleccione la cuenta bancaria.");
            return;
        }

        _cobrando = true;
        try
        {
            var dto = new CobroCrearDto
            {
                Canal = CanalCobro.Caja,
                ClienteClave = _clienteClave!,
                FormaPago = _formaPago,
                BancoCuentaId = _formaPago == "BANCO" ? _bancoCuentaId : null,
                // Permite registrar la recaudación de días anteriores; el motor
                // usa hoy solo si viene nula.
                FechaPago = _fechaPago,
                Aplicaciones = seleccionados
                    .Select(d => new CobroAplicacionDto
                    {
                        DocumentoTipo = d.DocumentoTipo,
                        FacturaId = d.DocumentoTipo == DocumentoCobroTipo.Factura ? d.FacturaId : null,
                        PlanCuotaId = d.PlanCuotaId,
                        NotaDebitoId = d.NotaDebitoId,
                        Monto = d.MontoCobrar
                    })
                    .ToList()
            };

            var result = await CobrosHttp.RegistrarAsync(dto);
            if (result?.Success == true)
            {
                var datos = System.Text.Json.JsonSerializer.Deserialize<CobroResultadoDto>(
                    System.Text.Json.JsonSerializer.Serialize(result.Data),
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                Notificar(true, $"Cobro registrado. Recibo {datos?.NumeroRecibo}.");
                if (datos?.PagoId is > 0)
                    await AbrirRecibo(datos.PagoId);

                await OnClienteSeleccionado(_clienteClave);
                await CargarCobrosDelDiaAsync();
                _resumen = _sesionActiva is not null ? await CajaHttp.GetResumenAsync(_sesionActiva.Id) : null;
            }
            else
            {
                Notificar(false, result?.Message ?? "No se pudo registrar el cobro.");
            }
        }
        catch (HttpRequestException ex)
        {
            // Un 4xx del API (p.ej. cliente BLOQUEADO por cobranza) llega como
            // excepción desde las extensiones WithAuthCheck; sin este catch
            // tumbaba el circuito Blazor completo (pruebas 31-jul).
            Notificar(false, ex.Message);
        }
        finally
        {
            _cobrando = false;
        }
    }

    // ---------------- Cobros del día / reverso ----------------

    private async Task CargarCobrosDelDiaAsync()
    {
        // Mismo umbral anti-parpadeo de 200 ms que las demás cargas de la caja.
        var carga = CargarCobrosDelDiaInternoAsync();
        var umbral = Task.Delay(200);
        if (await Task.WhenAny(carga, umbral) == umbral && !carga.IsCompleted)
        {
            _cargandoCobrosDia = true;
            StateHasChanged();
        }
        try
        {
            await carga;
        }
        finally
        {
            _cargandoCobrosDia = false;
        }
    }

    private async Task CargarCobrosDelDiaInternoAsync()
    {
        // El día de la CAJA (no del cajero): con "Solo mi caja" se ven todos los
        // cobros de la caja asignada sin importar quién los registró; sin el
        // filtro, todas las cajas de la empresa. El día es seleccionable para
        // consultar rápido lo registrado en fechas anteriores.
        _cobrosDelDia = await CobrosHttp.DelDiaAsync(
            fecha: _fechaCobrosDia,
            cajaId: _soloMiCaja ? _miCaja?.CajaId : null) ?? [];
    }

    private async Task CambiarFechaCobros(DateTime valor)
    {
        _fechaCobrosDia = valor.Date;
        await CargarCobrosDelDiaAsync();
    }

    private async Task CambiarFiltroCobros(bool valor)
    {
        _soloMiCaja = valor;
        await CargarCobrosDelDiaAsync();
    }

    private void AbrirReverso(CobroDelDiaDto cobro)
    {
        _reversoCobro = cobro;
        _reversoMotivo = string.Empty;
        _reversoVisible = true;
    }

    private async Task OnReversar()
    {
        if (_reversoCobro is null) return;
        try
        {
            var result = await CobrosHttp.ReversarAsync(new CobroReversoDto
            {
                PagoId = _reversoCobro.PagoId,
                Motivo = _reversoMotivo.Trim()
            });
            Notificar(result?.Success == true, result?.Message ?? "No se pudo reversar.");
            if (result?.Success == true)
            {
                _reversoVisible = false;
                await CargarCobrosDelDiaAsync();
                if (!string.IsNullOrWhiteSpace(_clienteClave))
                    await OnClienteSeleccionado(_clienteClave);
            }
        }
        catch (HttpRequestException ex)
        {
            Notificar(false, ex.Message);
        }
    }

    // F7 H2c: el recibo se imprime desde el documento del motor (adm_pago);
    // el papel "para banco" aún no cobrado tiene su propio endpoint.
    private async Task AbrirRecibo(long pagoId)
        => await JS.InvokeVoidAsync("open", $"/api/abono/recibo-pdf/{pagoId}", "_blank");

    private async Task AbrirReciboPendiente(long pendienteId)
        => await JS.InvokeVoidAsync("open", $"/api/abono/recibo-pendiente-pdf/{pendienteId}", "_blank");

    private void Notificar(bool ok, string mensaje)
        => ToastService.ShowToast(new ToastOptions
        {
            Title = ok ? "Éxito" : "Error",
            Text = mensaje,
            RenderStyle = ok ? ToastRenderStyle.Success : ToastRenderStyle.Danger
        });
}
