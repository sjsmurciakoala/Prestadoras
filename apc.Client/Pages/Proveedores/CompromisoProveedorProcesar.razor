@page "/proveedores/compromisos-proveedor/{NumeroOrden:int}/procesar"
@attribute [Authorize(Policy = PermissionNames.Contabilidad.View)]

@using DevExpress.Blazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using SIAD.Core.Constants
@using SIAD.Core.DTOs.Bancos
@using SIAD.Core.DTOs.Contabilidad
@using SIAD.Core.DTOs.Presupuesto
@using SIAD.Core.DTOs.Retenciones
@using SIAD.Core.Retenciones
@using apc.Client.Services.Bancos
@using apc.Client.Services.Contabilidad
@using apc.Client.Services.Presupuesto
@using apc.Client.Pages.Bancos

@using Microsoft.JSInterop

@inject ChequesClient ChequesClient
@inject OrdenesPagoDirectoClient OrdenesPagoDirectoClient
@inject AccountFormatState AccountFormat
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<CompromisoProveedorProcesar> Logger
@inject IToastNotificationService ToastService

<PageTitle>SIAD - Procesar Compromiso</PageTitle>

<div class="page-container">
    <DxToastProvider Name="CompromisoProveedorProcesarToast" MaxToastCount="4" StickToViewport="true" />
    <ErrorNotice @ref="errorNotice" />

    <div class="d-flex justify-content-between align-items-center mb-4 header-section">
        <div>
            <h2 class="page-title">Procesar compromiso de proveedor</h2>
            <p class="page-subtitle">@SubtituloPagina</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (CanReturnToOrigin)
            {
                <DxButton Text="Volver al origen"
                          IconCssClass="bi bi-arrow-left-circle"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          CssClass="btn-modern shadow-sm"
                          Click="VolverAlOrigen" />
            }
            <DxButton Text="Volver"
                      IconCssClass="bi bi-arrow-left"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      CssClass="btn-modern shadow-sm"
                      Click="Volver" />
            <DxButton Text="@(isProcessing ? "Emitiendo pago..." : "Emitir pago")"
                      IconCssClass="bi bi-check2-circle"
                      RenderStyle="ButtonRenderStyle.Success"
                      CssClass="btn-modern shadow-sm"
                      Click="ProcesarAsync"
                      Enabled="@CanProcess" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="modern-card">
            <DxSkeletonLine />
            <DxSkeletonLine />
            <DxSkeletonLine />
        </div>
    }
    else if (ordenDetalle is null)
    {
        <div class="alert alert-warning" role="alert">No se encontro el compromiso solicitado.</div>
    }
    else
    {
        <div class="summary-strip mb-3">
            <div class="summary-card">
                <div class="summary-label">Compromiso</div>
                <div class="summary-value">@ordenDetalle.NumeroOrden</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Estado</div>
                <div class="summary-value">
                    <span class="badge-status @(ordenDetalle.Procesada ? "inactive" : "active")">
                        @(ordenDetalle.Procesada ? "Procesada" : "Pendiente")
                    </span>
                </div>
            </div>
            <div class="summary-card">
                <div class="summary-label">@(ordenDetalle.Abonado > 0m ? "Monto original" : "Monto")</div>
                <div class="summary-value">@ordenDetalle.Monto.ToString("N2")</div>
            </div>
            @if (ordenDetalle.Abonado > 0m)
            {
                <div class="summary-card">
                    <div class="summary-label">Abonado</div>
                    <div class="summary-value">@ordenDetalle.Abonado.ToString("N2")</div>
                </div>
                <div class="summary-card">
                    <div class="summary-label">Saldo a pagar</div>
                    <div class="summary-value">@ordenDetalle.Saldo.ToString("N2")</div>
                </div>
            }
            <div class="summary-card summary-card-full">
                <div class="summary-label">Proveedor</div>
                <div class="summary-value">@ProveedorResumenTexto</div>
            </div>
        </div>

        <div class="modern-card mb-3">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3 section-header">
                <div>
                    <h5 class="mb-0">Detalle del compromiso</h5>
                    <small class="text-muted">Informacion base del compromiso antes de generar la partida.</small>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="summary-pill">Lineas: <strong>@ordenDetalle.Detalles.Count</strong></span>
                    <span class="summary-pill">Cuenta de servicio: <strong>@FormatCuentaOrDash(ordenDetalle.CuentaContable)</strong></span>
                </div>
            </div>

            @if (ordenDetalle.Detalles.Count == 0)
            {
                <div class="alert alert-warning" role="alert">
                    El compromiso no tiene lineas presupuestarias asociadas.
                </div>
            }
            else
            {
                <div class="grid-wrapper">
                    <DxGrid Data="@ordenDetalle.Detalles"
                            TData="OrdenPagoDirectoDetalleLineaDto"
                            PageSize="10"
                            ShowFilterRow="false"
                            ShowSearchBox="false"
                            ShowGroupPanel="false"
                            SizeMode="SizeMode.Large"
                            CssClass="grid-modern">
                        <Columns>
                            <DxGridDataColumn Caption="Fecha"
                                              Width="130px">
                                <CellDisplayTemplate>
                                    @GetFechaTexto(ordenDetalle.FechaCompromiso)
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(OrdenPagoDirectoDetalleLineaDto.CuentaContable)"
                                              Caption="Cuenta de gasto"
                                              Width="160px">
                                <CellDisplayTemplate Context="cell">
                                    @FormatCuentaOrDash(((OrdenPagoDirectoDetalleLineaDto)cell.DataItem).CuentaContable)
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(OrdenPagoDirectoDetalleLineaDto.Descripcion)"
                                              Caption="Descripcion"
                                              MinWidth="220" />
                            <DxGridDataColumn FieldName="@nameof(OrdenPagoDirectoDetalleLineaDto.Monto)"
                                              Caption="Monto"
                                              Width="140px"
                                              DisplayFormat="N2"
                                              TextAlignment="GridTextAlignment.Right" />
                        </Columns>
                    </DxGrid>
                </div>
            }
        </div>

        @if (ordenDetalle.Procesada)
        {
            <div class="alert alert-warning" role="alert">
                Este compromiso ya fue procesado. Se muestra solo en modo consulta.
            </div>
        }
        else
        {
            <div class="modern-card mb-3">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3 section-header">
                    <div>
                        <h5 class="mb-0">Medio de pago</h5>
                        <small class="text-muted">Seleccione la cuenta bancaria de origen y el metodo de pago del compromiso.</small>
                    </div>
                </div>

                @if (cuentasBanco.Count == 0)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        No hay cuentas bancarias configuradas en el modulo de Bancos.
                    </div>
                }
                else
                {
                    <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                        <DxFormLayoutItem Caption="Banco" ColSpanMd="4">
                            <DxComboBox Data="@BancosDisponibles"
                                        TData="string"
                                        TValue="string"
                                        Value="@bancoSeleccionadoNombre"
                                        ValueChanged="@OnBancoChanged"
                                        NullText="Seleccione el banco"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        SearchDelay="200"
                                        DropDownStyle="DropDownStyle.DropDown"
                                        DropDownTriggerMode="DropDownTriggerMode.Input"
                                        AllowUserInput="true"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        ValidationEnabled="false"
                                        Enabled="@(!isProcessing)" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Cuenta de banco" ColSpanMd="4">
                            <DxComboBox Data="@CuentasBancoFiltradas"
                                        TData="CuentaContableLookupDto"
                                        TValue="long?"
                                        Value="@bancoCuentaSeleccionadaId"
                                        ValueChanged="@OnBancoCuentaChanged"
                                        ValueFieldName="@nameof(CuentaContableLookupDto.BancoCuentaId)"
                                        TextFieldName="@nameof(CuentaContableLookupDto.NumeroCuenta)"
                                        NullText="@(string.IsNullOrWhiteSpace(bancoSeleccionadoNombre) ? "Seleccione primero el banco" : "Seleccione la cuenta")"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        SearchDelay="200"
                                        DropDownStyle="DropDownStyle.DropDown"
                                        DropDownTriggerMode="DropDownTriggerMode.Input"
                                        AllowUserInput="true"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        ValidationEnabled="false"
                                        Enabled="@(!isProcessing && !string.IsNullOrWhiteSpace(bancoSeleccionadoNombre))" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Metodo de pago" ColSpanMd="4">
                            <DxComboBox Data="@MediosDisponibles"
                                        TData="MetodoPagoOption"
                                        TValue="string"
                                        Value="@metodoPagoSeleccionado"
                                        ValueChanged="@((string v) => OnMetodoPagoChangedAsync(v))"
                                        ValueFieldName="@nameof(MetodoPagoOption.Valor)"
                                        TextFieldName="@nameof(MetodoPagoOption.Texto)"
                                        NullText="Seleccione el metodo"
                                        DropDownStyle="DropDownStyle.DropDownList"
                                        ValidationEnabled="false"
                                        Enabled="@(!isProcessing && bancoCuentaSeleccionadaId.HasValue)" />
                        </DxFormLayoutItem>
                    </DxFormLayout>

                    @if (CuentaBancoSeleccionada is not null)
                    {
                        <div class="text-muted mt-2">
                            Tipo de cuenta: <strong>@(GetTextOrDash(CuentaBancoSeleccionada.TipoCuenta))</strong>
                            @if (!EsCuentaCheque)
                            {
                                <span>&nbsp;&middot; Cuenta de ahorro: solo permite transferencia.</span>
                            }
                        </div>
                    }

                    @if (EsMetodoCheque && bancoCuentaSeleccionadaId.HasValue)
                    {
                        @if (proximoCheque is { Agotado: true })
                        {
                            <div class="alert alert-danger mt-2 mb-0" role="alert">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                La numeración de cheques de esta cuenta está agotada (máximo @proximoCheque.ChequeMaximo.ToString("N0")).
                                Actualice la numeración en la gestión de la cuenta.
                            </div>
                        }
                        else if (proximoCheque is not null)
                        {
                            <div class="text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>Se emitirá el cheque N° <strong>@proximoCheque.ProximoCheque.ToString("N0")</strong>.
                            </div>
                        }
                    }
                }
            </div>

            <div class="modern-card">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3 section-header">
                    <div>
                        <h5 class="mb-0">Partida contable del compromiso a procesar</h5>
                        <small class="text-muted">@SubtituloPartida</small>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="summary-pill">Debito: <strong>@TotalDebitoTexto</strong></span>
                        <span class="summary-pill">Credito: <strong>@TotalCreditoTexto</strong></span>
                        <DxButton Text="@($"Retenciones y deducciones ({deducciones.Count})")"
                                  IconCssClass="bi bi-sliders"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  CssClass="btn-modern shadow-sm"
                                  SizeMode="SizeMode.Small"
                                  Click="AbrirPopupDeducciones"
                                  Enabled="@(!isProcessing)" />
                    </div>
                </div>

                @if (NetoBanco <= 0m && deducciones.Count > 0)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        El neto a pagar por banco debe ser mayor a cero. Revise las retenciones y deducciones cargadas.
                    </div>
                }

                @if (!TieneCuentaProveedorDisponible)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        El proveedor no tiene una cuenta contable valida configurada. No se puede procesar el compromiso.
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <span class="text-muted">Vista previa de la partida contable que se generara al procesar el pago.</span>
                </div>

                @if (!MedioPagoSeleccionado)
                {
                    <div class="alert alert-info mb-3" role="alert">
                        Seleccione el medio de pago para generar la contrapartida al banco. Por ahora la partida solo muestra la linea del proveedor@(deducciones.Count > 0 ? " y las deducciones cargadas" : "").
                    </div>
                }
                else if (PartidaNoCuadra)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        Precaucion: @PartidaNoCuadraMensaje
                    </div>
                }

                @{ var previewLineas = LineasPartida; }
                <div class="table-responsive detail-table mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="min-width:280px;">Cuenta</th>
                                <th style="min-width:200px;">Descripcion</th>
                                <th style="min-width:110px;">Debito</th>
                                <th style="min-width:110px;">Credito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < previewLineas.Count; i++)
                            {
                                var rowIndex = i;
                                var linea = previewLineas[rowIndex];
                                var esLineaProveedor = IsProviderLine(rowIndex, previewLineas.Count);
                                var esLineaBanco = MedioPagoSeleccionado && rowIndex == 0;
                                var esDeduccion = IsDeduccionLine(rowIndex, previewLineas.Count);
                                var cuentaDisplay = ResolveLineaCuentaDisplay(linea, esLineaProveedor, esLineaBanco);
                                <tr class="@(esDeduccion ? "ded-row" : null)">
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold">
                                                @cuentaDisplay.Codigo
                                                @if (esDeduccion)
                                                {
                                                    <span class="ded-tag">deduccion</span>
                                                }
                                            </span>
                                            <small class="text-muted">@cuentaDisplay.Nombre</small>
                                        </div>
                                    </td>
                                    <td>@GetTextOrDash(linea.Descripcion)</td>
                                    <td class="text-end">@linea.Debito.ToString("N2")</td>
                                    <td class="text-end">@linea.Credito.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="2" class="text-end">Totales</td>
                                <td class="text-end">@TotalDebitoTexto</td>
                                <td class="text-end">@TotalCreditoTexto</td>
                            </tr>
                            @if (MedioPagoSeleccionado && PartidaNoCuadra)
                            {
                                <tr class="partida-no-cuadra-message">
                                    <td colspan="4">@PartidaNoCuadraMensaje</td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>

                <div class="total-bar">
                    <div class="text-muted">
                        Usuario: <strong>@UsuarioActualTexto</strong>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <DxButton Text="Cancelar"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  CssClass="btn-modern shadow-sm"
                                  Click="Volver"
                                  Enabled="@(!isProcessing)" />
                    </div>
                </div>
            </div>

            <DxPopup @bind-Visible="popupDeduccionesVisible"
                     HeaderText="Retenciones y deducciones"
                     Width="600px"
                     MaxWidth="95vw"
                     ShowFooter="true"
                     Scrollable="true"
                     CloseOnEscape="true"
                     CloseOnOutsideClick="false">
                <BodyContentTemplate>
                    <div style="display:flex; gap:1rem; padding:0.75rem 1rem; background:#f8fafc; border-radius:10px; margin-bottom:1rem;">
                        <div style="flex:1;">
                            <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:#7f8c8d;">Saldo a pagar (bruto)</div>
                            <div style="font-size:1.05rem; font-weight:700; color:#2c3e50;">@Bruto.ToString("N2")</div>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:#7f8c8d;">Neto a pagar por banco</div>
                            <div style="font-size:1.05rem; font-weight:700; color:#185FA5;">@DraftNeto.ToString("N2")</div>
                        </div>
                    </div>

                    <div style="border:1px solid #edf1f4; border-radius:10px; padding:1rem; margin-bottom:1rem;">
                        <div style="font-size:0.8rem; font-weight:700; color:#44525e; margin-bottom:0.6rem;">
                            @(editorIndex is null ? "Agregar linea" : "Editar linea")
                        </div>

                        @* Modo: Retencion (resta; autocompleta desde el catalogo) vs Cargo (suma; manual). *@
                        <div style="display:flex; gap:0.4rem; margin-bottom:0.6rem;">
                            <button type="button" style="@SegBtnStyle(DeduccionTipo.Retencion)" @onclick="@(() => SetEditorTipo(DeduccionTipo.Retencion))">Retencion</button>
                            <button type="button" style="@SegBtnStyle(DeduccionTipo.Cargo)" @onclick="@(() => SetEditorTipo(DeduccionTipo.Cargo))">Cargo</button>
                        </div>

                        @if (editorTipo == DeduccionTipo.Retencion)
                        {
                            <div class="mb-2">
                                <label style="font-size:0.72rem; color:#7f8c8d; display:block; margin-bottom:0.15rem;">Tipo de retencion</label>
                                <DxComboBox Data="@retencionesAplicables"
                                            TData="RetencionAplicableDto"
                                            TValue="int?"
                                            Value="@editorRetencionId"
                                            ValueChanged="@((int? v) => OnRetencionTipoChanged(v))"
                                            ValueFieldName="@nameof(RetencionAplicableDto.RetencionId)"
                                            TextFieldName="@nameof(RetencionAplicableDto.Display)"
                                            NullText="Elija un tipo (o capture la linea a mano)"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                                            SearchDelay="200"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            ValidationEnabled="false"
                                            SizeMode="SizeMode.Small"
                                            CssClass="w-100" />
                            </div>
                        }

                        <div class="mb-2">
                            <label style="font-size:0.72rem; color:#7f8c8d; display:block; margin-bottom:0.15rem;">Cuenta contable</label>
                            <DxComboBox Data="@cuentasContables"
                                        TData="CuentaContableLookupDto"
                                        TValue="long?"
                                        @bind-Value="editorCuentaId"
                                        ValueFieldName="@nameof(CuentaContableLookupDto.AccountId)"
                                        TextFieldName="@nameof(CuentaContableLookupDto.DisplayText)"
                                        NullText="Seleccione la cuenta"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        SearchDelay="200"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        ValidationEnabled="false"
                                        SizeMode="SizeMode.Small"
                                        CssClass="w-100" />
                        </div>
                        <div class="mb-2">
                            <DxTextBox @bind-Text="editorDescripcion"
                                       NullText="Descripcion (opcional)"
                                       SizeMode="SizeMode.Small"
                                       CssClass="w-100" />
                        </div>

                        <div style="display:flex; gap:0.6rem; align-items:flex-start;">
                            @if (editorTipo == DeduccionTipo.Retencion)
                            {
                                <div style="flex:1;">
                                    <label style="font-size:0.72rem; color:#7f8c8d; display:block; margin-bottom:0.15rem;">Base imponible</label>
                                    <DxSpinEdit T="decimal"
                                                Value="@editorBase"
                                                ValueChanged="@((decimal v) => OnEditorBaseChanged(v))"
                                                MinValue="0"
                                                Increment="0.01m"
                                                DisplayFormat="N2"
                                                SizeMode="SizeMode.Small"
                                                CssClass="w-100" />
                                </div>
                            }
                            <div style="flex:1;">
                                <label style="font-size:0.72rem; color:#7f8c8d; display:block; margin-bottom:0.15rem;">@(editorTipo == DeduccionTipo.Retencion ? "Monto a retener" : "Monto del cargo")</label>
                                <DxSpinEdit T="decimal"
                                            @bind-Value="editorMonto"
                                            MinValue="0"
                                            Increment="0.01m"
                                            DisplayFormat="N2"
                                            SizeMode="SizeMode.Small"
                                            CssClass="w-100" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(editorRetencionAviso))
                        {
                            <div style="font-size:0.78rem; color:#8a6d3b; background:#fcf8e3; border:1px solid #faebcc; border-radius:6px; padding:0.4rem 0.55rem; margin-top:0.5rem;">
                                <i class="bi bi-exclamation-triangle me-1"></i>@editorRetencionAviso
                            </div>
                        }

                        <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem; flex-wrap:wrap; margin-top:0.6rem;">
                            <div style="font-size:0.72rem; color:#7f8c8d;">Retencion resta al pago &middot; Cargo lo suma</div>
                            <div style="display:flex; gap:0.5rem;">
                                @if (editorIndex is not null)
                                {
                                    <DxButton Text="Cancelar edicion"
                                              RenderStyle="ButtonRenderStyle.Secondary"
                                              CssClass="btn-modern"
                                              SizeMode="SizeMode.Small"
                                              Click="LimpiarEditor" />
                                }
                                <DxButton Text="@(editorIndex is null ? "Agregar linea" : "Guardar cambios")"
                                          RenderStyle="ButtonRenderStyle.Primary"
                                          CssClass="btn-modern"
                                          SizeMode="SizeMode.Small"
                                          Click="GuardarLineaEditor" />
                            </div>
                        </div>
                        @if (editorMonto > 0m)
                        {
                            <div style="font-size:0.78rem; color:#44525e; margin-top:0.55rem;">
                                Con esta linea el neto pasaria de @DraftNeto.ToString("N2") a @ProyeccionNeto.ToString("N2").
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(editorError))
                        {
                            <div style="font-size:0.78rem; color:#b00020; margin-top:0.35rem;">@editorError</div>
                        }
                    </div>

                    <div style="font-size:0.8rem; font-weight:700; color:#44525e; margin-bottom:0.4rem;">Lineas cargadas (@deduccionesDraft.Count)</div>
                    @if (deduccionesDraft.Count == 0)
                    {
                        <div style="font-size:0.82rem; color:#7f8c8d; padding:0.4rem 0;">Aun no hay lineas. Agregue la primera arriba.</div>
                    }
                    else
                    {
                        <div style="border:1px solid #edf1f4; border-radius:10px; overflow:hidden;">
                            @for (var i = 0; i < deduccionesDraft.Count; i++)
                            {
                                var idx = i;
                                var d = deduccionesDraft[idx];
                                var cuenta = cuentasContables.FirstOrDefault(c => c.AccountId == d.CuentaId);
                                var enEdicion = editorIndex == idx;
                                <div style="display:flex; align-items:center; gap:0.6rem; padding:0.5rem 0.6rem; border-bottom:1px solid #f0f3f6; @(enEdicion ? "background:#e6f1fb;" : "")">
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-size:0.82rem; font-weight:600; color:#2c3e50;">
                                            @(cuenta is not null ? FormatCuentaOrDash(cuenta.Code) : "-")
                                            <span style="font-weight:400; color:#7f8c8d;">&middot; @(cuenta is not null ? GetTextOrDash(cuenta.Description) : "Sin cuenta")</span>
                                        </div>
                                        <div style="font-size:0.76rem; color:#7f8c8d;">@(string.IsNullOrWhiteSpace(d.Descripcion) ? "-" : d.Descripcion)</div>
                                    </div>
                                    <div style="white-space:nowrap; text-align:right;">
                                        <span style="display:inline-block; padding:1px 8px; border-radius:999px; font-size:0.68rem; font-weight:700; text-transform:uppercase; background:#f8ead2; color:#854f0b;">@(d.Tipo == DeduccionTipo.Retencion ? "retencion" : "cargo")</span>
                                        <span style="font-size:0.85rem; font-weight:700; color:#2c3e50; margin-left:0.35rem;">@d.Monto.ToString("N2")</span>
                                    </div>
                                    <div style="white-space:nowrap;">
                                        <button type="button" title="Editar" style="border:none; background:#e6f1fb; color:#185FA5; width:30px; height:30px; border-radius:50%; cursor:pointer; margin-left:0.4rem;" @onclick="@(() => EditarLineaDraft(idx))"><i class="bi bi-pencil"></i></button>
                                        <button type="button" title="Quitar" style="border:none; background:rgba(220,53,69,0.12); color:#dc3545; width:30px; height:30px; border-radius:50%; cursor:pointer; margin-left:0.3rem;" @onclick="@(() => QuitarLineaDraft(idx))"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div style="display:flex; justify-content:flex-end; gap:0.5rem; flex-wrap:wrap; margin-top:0.75rem;">
                            <span style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.4rem 0.8rem; border:1px solid #dfe6ec; border-radius:999px; background:#f8fafc; color:#44525e; font-size:0.8rem; font-weight:600;">Debe deducciones: <strong>@DraftDebe.ToString("N2")</strong></span>
                            <span style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.4rem 0.8rem; border:1px solid #dfe6ec; border-radius:999px; background:#f8fafc; color:#44525e; font-size:0.8rem; font-weight:600;">Haber deducciones: <strong>@DraftHaber.ToString("N2")</strong></span>
                        </div>
                    }
                </BodyContentTemplate>
                <FooterContentTemplate>
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; width:100%; flex-wrap:wrap;">
                        <div style="font-size:0.78rem; color:@(DraftNeto > 0m ? "#0f5132" : "#b00020");">
                            @if (DraftNeto > 0m)
                            {
                                <span><i class="bi bi-check-circle"></i> Neto a pagar por banco: @DraftNeto.ToString("N2")</span>
                            }
                            else
                            {
                                <span><i class="bi bi-exclamation-triangle"></i> El neto quedaria en cero o negativo.</span>
                            }
                        </div>
                        <div style="display:flex; gap:0.5rem;">
                            <DxButton Text="Cancelar"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      CssClass="btn-modern shadow-sm"
                                      Click="CancelarPopupDeducciones" />
                            <DxButton Text="Aplicar a la partida"
                                      RenderStyle="ButtonRenderStyle.Success"
                                      CssClass="btn-modern shadow-sm"
                                      Click="AplicarDeducciones"
                                      Enabled="@(DraftNeto > 0m)" />
                        </div>
                    </div>
                </FooterContentTemplate>
            </DxPopup>
        }
    }

    <ChequeImpresionDialog Visible="impresionDialogVisible"
                           VisibleChanged="OnImpresionDialogVisibleChanged"
                           ChequeId="chequeIdEmitido"
                           DocumentoUrl="@documentoImpresionUrl"
                           DocumentoTexto="Imprimir compromiso"
                           Mensaje="El compromiso se procesó y se emitió el cheque. ¿Qué desea imprimir?" />
</div>

@code {
    [Parameter]
    public int NumeroOrden { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "originUrl")]
    public string? OriginUrlQuery { get; set; }

    private readonly List<CuentaContableLookupDto> cuentasContables = new();
    private readonly List<CuentaContableLookupDto> cuentasBanco = new();
    private readonly List<DeduccionLinea> deducciones = new();

    // Estado del modal de retenciones/deducciones. Se edita un borrador (deduccionesDraft) que solo se
    // vuelca a 'deducciones' al pulsar Aplicar; Cancelar/Escape lo descartan sin tocar la partida.
    private readonly List<DeduccionLinea> deduccionesDraft = new();
    private bool popupDeduccionesVisible;

    // Estado del dialogo de impresion post-emision de cheque (procesar con metodo CHEQUE).
    private bool impresionDialogVisible;
    private long chequeIdEmitido;
    private string? documentoImpresionUrl;

    private long? editorCuentaId;
    private string editorDescripcion = string.Empty;
    private DeduccionTipo editorTipo = DeduccionTipo.Retencion;
    private decimal editorMonto;
    private int? editorIndex;
    private string? editorError;

    // F2: catalogo de retenciones aplicable a la fecha del compromiso (concepto + % vigente + cuenta por
    // empresa) y la tasa ISV general vigente para la base SIN_ISV. La UI solo orquesta; la aritmetica vive
    // en RetencionCalculator (SIAD.Core, puro y testeado).
    private readonly List<RetencionAplicableDto> retencionesAplicables = new();
    private decimal? tasaIsvGeneral;
    private int? editorRetencionId;        // tipo de retencion elegido en el editor (null = linea manual)
    private decimal editorBase;            // base imponible editable (modo Retencion)
    private string? editorRetencionAviso;  // aviso del autocalculo: sin tasa / sin cuenta / sin ISV vigente

    private OrdenPagoDirectoDetalleDto? ordenDetalle;
    private long? cuentaProveedorId;
    private long? bancoCuentaSeleccionadaId;
    private string? bancoSeleccionadoNombre;
    private string? metodoPagoSeleccionado;
    private bool isLoading = true;
    private bool isProcessing;
    private ErrorNotice errorNotice = default!;
    private readonly List<string> validationMessages = new();
    private string usuarioActual = "SISTEMA";

    // Vista previa de la partida (banco + deducciones + proveedor). Se recalcula en cada acceso a partir
    // del bruto, la cuenta de banco elegida y las deducciones cargadas: banco/proveedor NUNCA se editan
    // directamente, asi que no hace falta sincronizar un estado mutable aparte.
    private List<PartidaLineaOrdenPagoDto> LineasPartida
    {
        get
        {
            var lineas = new List<PartidaLineaOrdenPagoDto>();
            if (ordenDetalle is null || ordenDetalle.Procesada)
            {
                return lineas;
            }

            // La contrapartida al banco solo se agrega cuando ya se eligio el medio de pago. Mientras tanto,
            // la partida muestra unicamente el debito del proveedor (mas las deducciones cargadas, si las hay),
            // para no aparentar que cuadra antes de completar el medio de pago.
            var cuentaBanco = CuentaBancoSeleccionada;
            if (cuentaBanco is not null)
            {
                lineas.Add(new PartidaLineaOrdenPagoDto
                {
                    CuentaId = cuentaBanco.AccountId,
                    BancoCuentaId = cuentaBanco.BancoCuentaId,
                    Descripcion = ordenDetalle.Concepto,
                    Debito = 0m,
                    Credito = NetoBanco
                });
            }

            foreach (var deduccion in deducciones)
            {
                lineas.Add(new PartidaLineaOrdenPagoDto
                {
                    CuentaId = deduccion.CuentaId ?? 0,
                    Descripcion = string.IsNullOrWhiteSpace(deduccion.Descripcion) ? ordenDetalle.Concepto : deduccion.Descripcion.Trim(),
                    Debito = deduccion.Debe,
                    Credito = deduccion.Haber
                });
            }

            lineas.Add(new PartidaLineaOrdenPagoDto
            {
                CuentaId = cuentaProveedorId ?? 0,
                Descripcion = ordenDetalle.Concepto,
                Debito = Bruto,
                Credito = 0m
            });

            return lineas;
        }
    }

    // El bruto del procesamiento es el SALDO pendiente (monto - abonos vigentes), no el monto
    // original: los abonos ya debitaron al proveedor y acreditaron al banco por su parte.
    private decimal Bruto => ordenDetalle?.Saldo ?? 0m;
    private decimal TotalDeduccionDebe => deducciones.Sum(x => x.Debe);
    private decimal TotalDeduccionHaber => deducciones.Sum(x => x.Haber);

    // neto = bruto + Sum(Debe deduccion) - Sum(Haber deduccion). Es el HABER que se le asienta al banco.
    private decimal NetoBanco => Bruto + TotalDeduccionDebe - TotalDeduccionHaber;

    // Totales del borrador que se edita dentro del modal (aun sin aplicar a la partida).
    private decimal DraftDebe => deduccionesDraft.Sum(x => x.Debe);
    private decimal DraftHaber => deduccionesDraft.Sum(x => x.Haber);
    private decimal DraftNeto => Bruto + DraftDebe - DraftHaber;

    // Neto proyectado con la linea que se esta capturando. Excluye la linea en edicion para no contarla dos veces.
    private decimal ProyeccionNetoBase =>
        Bruto
        + deduccionesDraft.Where((_, i) => editorIndex is null || i != editorIndex.Value).Sum(x => x.Debe)
        - deduccionesDraft.Where((_, i) => editorIndex is null || i != editorIndex.Value).Sum(x => x.Haber);
    private decimal ProyeccionNeto => ProyeccionNetoBase + (editorTipo == DeduccionTipo.Cargo ? editorMonto : -editorMonto);

    private string SubtituloPartida => deducciones.Count == 0
        ? "Sin deducciones. El pago se procesara por el saldo pendiente del compromiso."
        : $"Incluye {deducciones.Count} {(deducciones.Count == 1 ? "deduccion" : "deducciones")} - neto a banco {NetoBanco:N2}.";

    private decimal TotalDebito => LineasPartida.Sum(x => x.Debito);
    private decimal TotalCredito => LineasPartida.Sum(x => x.Credito);
    private string TotalDebitoTexto => TotalDebito.ToString("N2");
    private string TotalCreditoTexto => TotalCredito.ToString("N2");
    private bool PartidaNoCuadra => Math.Abs(TotalDebito - TotalCredito) > 0.01m;
    private string PartidaNoCuadraMensaje => $"La partida contable no cuadra. Debito: {TotalDebito:N2}, Credito: {TotalCredito:N2}.";
    private string SubtituloPagina => "Genere la partida contable y cierre el compromiso seleccionado.";
    private string UsuarioActualTexto => string.IsNullOrWhiteSpace(usuarioActual) ? "SISTEMA" : usuarioActual;
    private bool TieneCuentaProveedorDisponible => cuentaProveedorId.HasValue && cuentaProveedorId.Value > 0;
    private int ContraLineCount => LineasPartida.Count > 0 ? LineasPartida.Count - 1 : 0;
    private string CuentaProveedorCodigoTexto => FormatCuentaOrDash(ordenDetalle?.CuentaContableProveedor);
    private string CuentaProveedorNombreTexto => GetCuentaNombre(cuentaProveedorId);
    private string ProveedorResumenTexto => BuildProveedorResumenTexto();

    // Etiqueta para agrupar cuentas cuya ban_cuenta no tiene nombre de banco (p.ej. migradas de
    // SIMAFI con banco en blanco); sin esto quedarian inseleccionables en la cascada.
    private const string SinBancoLabel = "(Sin banco)";

    // Lista de bancos (distintos) de las cuentas disponibles; permite filtrar las cuentas por banco.
    private IReadOnlyList<string> BancosDisponibles
    {
        get
        {
            var bancos = cuentasBanco
                .Select(c => c.BancoNombre)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (cuentasBanco.Any(c => string.IsNullOrWhiteSpace(c.BancoNombre)))
            {
                bancos.Add(SinBancoLabel);
            }
            return bancos;
        }
    }

    // Cuentas del banco elegido. Sin banco seleccionado no se lista ninguna (se elige el banco primero).
    private IReadOnlyList<CuentaContableLookupDto> CuentasBancoFiltradas =>
        string.IsNullOrWhiteSpace(bancoSeleccionadoNombre)
            ? Array.Empty<CuentaContableLookupDto>()
            : string.Equals(bancoSeleccionadoNombre, SinBancoLabel, StringComparison.OrdinalIgnoreCase)
                ? cuentasBanco.Where(c => string.IsNullOrWhiteSpace(c.BancoNombre)).ToList()
                : cuentasBanco
                    .Where(c => string.Equals(c.BancoNombre?.Trim(), bancoSeleccionadoNombre, StringComparison.OrdinalIgnoreCase))
                    .ToList();

    private void OnBancoChanged(string? banco)
    {
        bancoSeleccionadoNombre = string.IsNullOrWhiteSpace(banco) ? null : banco.Trim();
        // La cuenta y el metodo dependen del banco: al cambiarlo se limpian.
        bancoCuentaSeleccionadaId = null;
        metodoPagoSeleccionado = null;
        proximoChequeSeq++;
        proximoCheque = null;
    }

    private CuentaContableLookupDto? CuentaBancoSeleccionada =>
        cuentasBanco.FirstOrDefault(c => c.BancoCuentaId == bancoCuentaSeleccionadaId);

    // Hay medio de pago cuando ya se resolvio una cuenta de banco valida.
    private bool MedioPagoSeleccionado => CuentaBancoSeleccionada is not null;

    private bool EsCuentaCheque
    {
        get
        {
            var tipoCuenta = CuentaBancoSeleccionada?.TipoCuenta;
            return !string.IsNullOrWhiteSpace(tipoCuenta) &&
                   tipoCuenta.Contains("CHEQ", StringComparison.OrdinalIgnoreCase);
        }
    }

    // Numeración de cheques de la cuenta elegida (solo se consulta con método CHEQUE).
    private ProximoChequeDto? proximoCheque;
    private int proximoChequeSeq; // Descarta respuestas viejas si cuenta/método cambian en vuelo.

    private bool EsMetodoCheque =>
        string.Equals(metodoPagoSeleccionado, OrdenPagoDirectoMetodoPago.Cheque, StringComparison.OrdinalIgnoreCase);

    private bool ChequeAgotado => EsMetodoCheque && proximoCheque is { Agotado: true };

    private async Task OnMetodoPagoChangedAsync(string? value)
    {
        metodoPagoSeleccionado = value;
        await RefrescarProximoChequeAsync();
    }

    private async Task RefrescarProximoChequeAsync()
    {
        var seq = ++proximoChequeSeq;
        proximoCheque = null;
        if (!EsMetodoCheque || !bancoCuentaSeleccionadaId.HasValue)
        {
            return;
        }

        try
        {
            var info = await ChequesClient.GetProximoAsync(bancoCuentaSeleccionadaId.Value);
            if (seq == proximoChequeSeq)
            {
                proximoCheque = info;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo consultar el próximo cheque de la cuenta {BancoCuentaId}", bancoCuentaSeleccionadaId);
        }
    }

    // Una cuenta de ahorro (u otro tipo distinto de cheques) solo admite transferencia;
    // una cuenta de cheques admite cheque o transferencia. Sin cuenta elegida, no hay medios.
    private List<MetodoPagoOption> MediosDisponibles
    {
        get
        {
            if (CuentaBancoSeleccionada is null)
            {
                return new List<MetodoPagoOption>();
            }

            return EsCuentaCheque
                ? new List<MetodoPagoOption>
                  {
                      new(OrdenPagoDirectoMetodoPago.Cheque, "Cheque"),
                      new(OrdenPagoDirectoMetodoPago.Transferencia, "Transferencia"),
                  }
                : new List<MetodoPagoOption>
                  {
                      new(OrdenPagoDirectoMetodoPago.Transferencia, "Transferencia"),
                  };
        }
    }

    private string BancoCuentaCodigoTexto => CuentaBancoSeleccionada is not null
        ? FormatCuentaOrDash(CuentaBancoSeleccionada.Code)
        : "-";

    private string BancoCuentaNombreTexto => CuentaBancoSeleccionada is not null
        ? GetTextOrDash(CuentaBancoSeleccionada.Description)
        : "Seleccione una cuenta de banco";

    private bool CanProcess => !isLoading &&
                               !isProcessing &&
                               ordenDetalle is not null &&
                               !ordenDetalle.Procesada &&
                               TieneCuentaProveedorDisponible &&
                               ContraLineCount > 0 &&
                               bancoCuentaSeleccionadaId.HasValue &&
                               !string.IsNullOrWhiteSpace(metodoPagoSeleccionado) &&
                               !ChequeAgotado;
    private bool CanReturnToOrigin => GetOriginUrl() is not null;

    protected override async Task OnParametersSetAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        isLoading = true;
        validationMessages.Clear();
        ordenDetalle = null;
        deducciones.Clear();
        cuentaProveedorId = null;
        bancoCuentaSeleccionadaId = null;
        bancoSeleccionadoNombre = null;
        metodoPagoSeleccionado = null;
        proximoChequeSeq++;
        proximoCheque = null;

        try
        {
            await AccountFormat.EnsureLoadedAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            usuarioActual = authState.User.Identity?.Name ?? "SISTEMA";

            var ordenTask = OrdenesPagoDirectoClient.GetByNumeroOrdenAsync(NumeroOrden);
            var cuentasContablesTask = OrdenesPagoDirectoClient.GetCuentasContablesAsync();
            var cuentasBancoTask = OrdenesPagoDirectoClient.GetCuentasContraProcesamientoAsync();
            await Task.WhenAll(ordenTask, cuentasContablesTask, cuentasBancoTask);

            ordenDetalle = await ordenTask;
            var cuentasPlan = await cuentasContablesTask;
            var cuentasBancoDisponibles = await cuentasBancoTask;

            cuentasContables.Clear();
            cuentasContables.AddRange(cuentasPlan);

            cuentasBanco.Clear();
            cuentasBanco.AddRange(cuentasBancoDisponibles);

            if (ordenDetalle is null)
            {
                ShowToast("Procesar compromiso", $"No se encontro el compromiso {NumeroOrden}.", ToastRenderStyle.Danger);
                return;
            }

            cuentaProveedorId = ResolveCuentaProveedorId(ordenDetalle.CuentaContableProveedor);

            // Retenciones vigentes a la FECHA DEL COMPROMISO (no "hoy"): el % que regia en esa fecha.
            await CargarRetencionesAplicablesAsync();
        }
        catch (Exception ex)
        {
            ShowToast("Procesar compromiso", "No se pudo cargar la pantalla de proceso.", ToastRenderStyle.Danger);
            Logger.LogError(ex, "Error al cargar pantalla de proceso para compromiso {NumeroOrden}", NumeroOrden);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnBancoCuentaChanged(long? value)
    {
        bancoCuentaSeleccionadaId = value;

        var mediosDisponibles = MediosDisponibles;
        if (metodoPagoSeleccionado is null || !mediosDisponibles.Any(m => m.Valor == metodoPagoSeleccionado))
        {
            metodoPagoSeleccionado = mediosDisponibles.Count > 0 ? mediosDisponibles[0].Valor : null;
        }

        await RefrescarProximoChequeAsync();
    }

    private void AbrirPopupDeducciones()
    {
        // Clonamos el estado aplicado a un borrador; asi Cancelar/Escape descartan sin afectar la partida.
        deduccionesDraft.Clear();
        deduccionesDraft.AddRange(deducciones.Select(d => d.Clone()));
        LimpiarEditor();
        popupDeduccionesVisible = true;
    }

    private void LimpiarEditor()
    {
        editorIndex = null;
        editorCuentaId = null;
        editorDescripcion = string.Empty;
        editorTipo = DeduccionTipo.Retencion;
        editorMonto = 0m;
        editorError = null;
        editorRetencionId = null;
        editorBase = 0m;
        editorRetencionAviso = null;
    }

    private async Task CargarRetencionesAplicablesAsync()
    {
        retencionesAplicables.Clear();
        tasaIsvGeneral = null;
        try
        {
            var fecha = ordenDetalle?.FechaCompromiso is { } f
                ? DateOnly.FromDateTime(f)
                : DateOnly.FromDateTime(DateTime.Today);
            var aplicables = await OrdenesPagoDirectoClient.GetRetencionesAplicablesAsync(fecha);
            retencionesAplicables.AddRange(aplicables.Retenciones);
            tasaIsvGeneral = aplicables.TasaIsvGeneral;
        }
        catch (Exception ex)
        {
            // No es fatal: el popup sigue permitiendo la linea manual (cuenta + monto a mano).
            Logger.LogWarning(ex, "No se pudieron cargar las retenciones aplicables del compromiso {NumeroOrden}", NumeroOrden);
        }
    }

    // Cambiar de modo. Cargo = manual (sin catalogo): se limpia el tipo de retencion y su aviso.
    private void SetEditorTipo(DeduccionTipo tipo)
    {
        editorTipo = tipo;
        if (tipo == DeduccionTipo.Cargo)
        {
            editorRetencionId = null;
            editorRetencionAviso = null;
        }
    }

    // Al elegir un tipo de retencion: fija cuenta (o avisa), propone base (editable) y monto (si hay tasa),
    // y arma la descripcion. NUNCA inventa % — sin tasa vigente avisa y deja el monto en manos del usuario.
    private void OnRetencionTipoChanged(int? retencionId)
    {
        editorRetencionId = retencionId;
        editorError = null;
        editorRetencionAviso = null;

        if (retencionId is null)
        {
            return; // volvio a "sin tipo": linea manual, no se pisa lo ya escrito
        }

        var ret = retencionesAplicables.FirstOrDefault(r => r.RetencionId == retencionId.Value);
        if (ret is null)
        {
            return;
        }

        var avisos = new List<string>();

        // 1) Cuenta desde prv_retencion_cuenta. Si la empresa no la configuro, avisar y NO autocompletar.
        if (ret.CuentaConfigurada && ret.CuentaAccountId is { } accId)
        {
            editorCuentaId = accId;
        }
        else
        {
            editorCuentaId = null;
            avisos.Add("La empresa no tiene una cuenta configurada para esta retencion: seleccionela abajo o configurela en el mantenimiento de retenciones.");
        }

        // 2) Base segun base_calculo (editable). Aviso explicito si SIN_ISV y no hay tasa ISV vigente.
        var calculo = RetencionCalculator.Calcular(Bruto, ret.BaseCalculo, ret.Porcentaje, tasaIsvGeneral);
        editorBase = calculo.Base;

        if (RetencionCalculator.RequiereTasaIsvYNoHay(ret.BaseCalculo, tasaIsvGeneral))
        {
            avisos.Add("No se encontro una tasa de ISV vigente: la base no se redujo (quedo igual al bruto). Revise el monto o ajuste la base a mano.");
        }

        // 3) Monto: solo si hay tasa vigente. Sin tasa (p. ej. ISV-RET) se captura a mano.
        if (calculo.PuedeCalcularMonto)
        {
            editorMonto = calculo.Monto;
        }
        else
        {
            editorMonto = 0m;
            avisos.Add("Esta retencion no tiene una tasa vigente (pendiente de confirmar con la SAR): capture el monto a mano; no se puede autocalcular.");
        }

        // 4) Descripcion: nombre + % (o solo nombre si no hay tasa).
        editorDescripcion = ret.Porcentaje is { } pct
            ? $"{ret.Nombre} ({pct:0.##}%)"
            : ret.Nombre;

        editorRetencionAviso = avisos.Count > 0 ? string.Join(" ", avisos) : null;
    }

    // Al editar la base a mano, el monto sigue a la base cuando hay un tipo con tasa seleccionado.
    private void OnEditorBaseChanged(decimal value)
    {
        editorBase = value < 0m ? 0m : value;

        var ret = editorRetencionId is { } id
            ? retencionesAplicables.FirstOrDefault(r => r.RetencionId == id)
            : null;

        if (ret?.Porcentaje is not null)
        {
            editorMonto = RetencionCalculator.MontoDesdeBase(editorBase, ret.Porcentaje);
        }
    }

    private void GuardarLineaEditor()
    {
        editorError = null;

        if (!editorCuentaId.HasValue || editorCuentaId.Value <= 0)
        {
            editorError = "Seleccione la cuenta contable de la linea.";
            return;
        }

        if (editorMonto <= 0m)
        {
            editorError = "Ingrese un monto mayor a cero.";
            return;
        }

        // F4: si es una retencion catalogada, conservar el vinculo (retencion_id/%/base) para armar
        // dto.Retenciones al enviar. No cambia el contrato de la partida (Debe/Haber por linea).
        var retCatalogo = editorTipo == DeduccionTipo.Retencion && editorRetencionId is { } rid
            ? retencionesAplicables.FirstOrDefault(r => r.RetencionId == rid)
            : null;

        var linea = new DeduccionLinea
        {
            CuentaId = editorCuentaId,
            Descripcion = editorDescripcion?.Trim() ?? string.Empty,
            Tipo = editorTipo,
            Monto = editorMonto,
            RetencionId = retCatalogo?.RetencionId,
            Porcentaje = retCatalogo?.Porcentaje,
            Base = editorTipo == DeduccionTipo.Retencion ? editorBase : 0m,
        };

        if (editorIndex is int idx && idx >= 0 && idx < deduccionesDraft.Count)
        {
            deduccionesDraft[idx] = linea;
        }
        else
        {
            deduccionesDraft.Add(linea);
        }

        LimpiarEditor();
    }

    private void EditarLineaDraft(int idx)
    {
        if (idx < 0 || idx >= deduccionesDraft.Count)
        {
            return;
        }

        var d = deduccionesDraft[idx];
        editorIndex = idx;
        editorCuentaId = d.CuentaId;
        editorDescripcion = d.Descripcion;
        editorTipo = d.Tipo;
        editorMonto = d.Monto;
        editorError = null;
        // F4: las lineas confirmadas ahora guardan el vinculo al catalogo; al editar se restaura para no
        // perder la trazabilidad estructurada (retencion_id/%/base).
        editorRetencionId = d.RetencionId;
        editorBase = d.Base;
        editorRetencionAviso = null;
    }

    private void QuitarLineaDraft(int idx)
    {
        if (idx < 0 || idx >= deduccionesDraft.Count)
        {
            return;
        }

        deduccionesDraft.RemoveAt(idx);

        // Mantener coherente el indice en edicion si quitamos otra fila.
        if (editorIndex is int e)
        {
            if (e == idx)
            {
                LimpiarEditor();
            }
            else if (idx < e)
            {
                editorIndex = e - 1;
            }
        }
    }

    private void AplicarDeducciones()
    {
        deducciones.Clear();
        deducciones.AddRange(deduccionesDraft.Select(d => d.Clone()));
        popupDeduccionesVisible = false;
    }

    private void CancelarPopupDeducciones()
    {
        popupDeduccionesVisible = false;
    }

    private string SegBtnStyle(DeduccionTipo t)
        => editorTipo == t
            ? "flex:1; font-size:0.8rem; padding:0.5rem 0.4rem; border-radius:8px; cursor:pointer; border:2px solid #185FA5; background:#e6f1fb; color:#0c447c; font-weight:700;"
            : "flex:1; font-size:0.8rem; padding:0.5rem 0.4rem; border-radius:8px; cursor:pointer; border:1px solid #cbd5e0; background:#ffffff; color:#44525e; font-weight:600;";

    private async Task ProcesarAsync()
    {
        if (ordenDetalle is null || ordenDetalle.Procesada)
        {
            return;
        }

        validationMessages.Clear();

        if (!ValidarPartida())
        {
            ShowToast("Validacion", BuildValidationToastMessage(), ToastRenderStyle.Warning);
            return;
        }

        try
        {
            isProcessing = true;

            // Modelo GENERAL (retenciones/deducciones): el DTO trae solo las lineas NO-proveedor, cada
            // una con su Debito/Credito real. El backend agrega la linea del proveedor automaticamente
            // (Debe = bruto) y valida el cuadre. La linea de banco va al Haber por el NETO ya calculado.
            var dto = new ProcesarOrdenPagoDirectoDto
            {
                Usuario = UsuarioActualTexto,
                MetodoPago = metodoPagoSeleccionado!,
                Lineas = new List<PartidaLineaOrdenPagoDto>
                {
                    new()
                    {
                        CuentaId = CuentaBancoSeleccionada!.AccountId,
                        BancoCuentaId = CuentaBancoSeleccionada.BancoCuentaId,
                        Descripcion = ordenDetalle!.Concepto,
                        Debito = 0m,
                        Credito = NetoBanco
                    }
                }
            };

            foreach (var deduccion in deducciones)
            {
                dto.Lineas.Add(new PartidaLineaOrdenPagoDto
                {
                    CuentaId = deduccion.CuentaId ?? 0,
                    Descripcion = string.IsNullOrWhiteSpace(deduccion.Descripcion) ? ordenDetalle.Concepto : deduccion.Descripcion.Trim(),
                    Debito = deduccion.Debe,
                    Credito = deduccion.Haber
                });
            }

            // F4: retenciones catalogadas en paralelo a las lineas (mismo dato, no altera la partida).
            // El backend escribe el registro fiscal hdr/dtl y valida Σ Monto == Σ credito de estas cuentas.
            foreach (var deduccion in deducciones)
            {
                if (deduccion.Tipo != DeduccionTipo.Retencion || deduccion.RetencionId is not { } retId)
                    continue;

                dto.Retenciones.Add(new RetencionAplicadaDto
                {
                    RetencionId = retId,
                    CuentaId = deduccion.CuentaId ?? 0,
                    Base = deduccion.Base,
                    Porcentaje = deduccion.Porcentaje ?? 0m,
                    Monto = deduccion.Monto
                });
            }

            var result = await OrdenesPagoDirectoClient.ProcesarAsync(NumeroOrden, dto);
            if (!result.Success)
            {
                ShowToast("Procesar compromiso", result.Message, ToastRenderStyle.Danger);
                return;
            }

            ShowToast("Exito", result.Message, ToastRenderStyle.Success);

            if (result.ChequeId is > 0)
            {
                // Pago con cheque: ofrecer imprimir compromiso / cheque / cheque + detalle.
                chequeIdEmitido = result.ChequeId.Value;
                documentoImpresionUrl = OrdenesPagoDirectoClient.GetPdfUrl(NumeroOrden);
                impresionDialogVisible = true;
            }
            else
            {
                await JS.InvokeVoidAsync("open", OrdenesPagoDirectoClient.GetPdfUrl(NumeroOrden), "_blank");
                Navigation.NavigateTo(GetReturnUrl(), true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al procesar compromiso {NumeroOrden}", NumeroOrden);
            errorNotice.ShowError("No se pudo procesar el compromiso.", ex);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo(GetReturnUrl(), true);
    }

    private void OnImpresionDialogVisibleChanged(bool value)
    {
        impresionDialogVisible = value;
        if (!value)
        {
            // Al cerrar el dialogo de impresion, volver a la lista.
            Navigation.NavigateTo(GetReturnUrl(), true);
        }
