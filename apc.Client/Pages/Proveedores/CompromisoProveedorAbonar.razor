@page "/proveedores/compromisos-proveedor/{NumeroOrden:int}/abonar"
@attribute [Authorize(Policy = PermissionNames.Contabilidad.View)]

@using DevExpress.Blazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SIAD.Core.Constants
@using SIAD.Core.DTOs.Bancos
@using SIAD.Core.DTOs.Contabilidad
@using SIAD.Core.DTOs.Presupuesto
@using apc.Client.Services.Bancos
@using apc.Client.Services.Contabilidad
@using apc.Client.Services.Presupuesto
@using apc.Client.Pages.Bancos

@inject ChequesClient ChequesClient
@inject OrdenesPagoDirectoClient OrdenesPagoDirectoClient
@inject PolizasClient PolizasClient
@inject AccountFormatState AccountFormat
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<CompromisoProveedorAbonar> Logger
@inject IToastNotificationService ToastService

<PageTitle>SIAD - Abonar Compromiso</PageTitle>

<div class="page-container">
    <DxToastProvider Name="CompromisoProveedorAbonarToast" MaxToastCount="4" />
    <ErrorNotice @ref="errorNotice" />

    <div class="d-flex justify-content-between align-items-center mb-4 header-section">
        <div>
            <h2 class="page-title">Abonos del compromiso de proveedor</h2>
            <p class="page-subtitle">Registre pagos parciales o totales y consulte el historial de abonos.</p>
        </div>
        <DxButton Text="Volver" IconCssClass="bi bi-arrow-left" RenderStyle="ButtonRenderStyle.Secondary"
                  CssClass="btn-modern shadow-sm" Click="Volver" />
    </div>

    @if (isLoading)
    {
        <div class="modern-card">
            <DxSkeletonLine />
            <DxSkeletonLine />
            <DxSkeletonLine />
        </div>
    }
    else if (saldo is null)
    {
        <div class="alert alert-warning" role="alert">No se encontro el compromiso solicitado.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="text-muted">Compromiso <strong>@saldo.NumeroOrden</strong> &middot; @ProveedorResumenTexto</span>
            <span class="badge-status @EstadoBadgeClass">@saldo.EstadoTexto</span>
        </div>

        <div class="summary-strip mb-3">
            <div class="summary-card">
                <div class="summary-label">Monto</div>
                <div class="summary-value">@saldo.Monto.ToString("N2")</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Abonado</div>
                <div class="summary-value">@saldo.Abonado.ToString("N2")</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Saldo</div>
                <div class="summary-value">@saldo.Saldo.ToString("N2")</div>
            </div>
        </div>

        @if (EstaPagado)
        {
            <div class="alert alert-info" role="alert">
                Este compromiso ya esta pagado (saldo cero). No admite nuevos abonos.
            </div>
        }
        else
        {
            <div class="modern-card mb-3">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3 section-header">
                    <div>
                        <h5 class="mb-0">Nuevo abono</h5>
                        <small class="text-muted">El monto debe ser mayor a cero y no superar el saldo pendiente.</small>
                    </div>
                    <DxButton Text="Abonar todo el saldo" IconCssClass="bi bi-cash-stack"
                              RenderStyle="ButtonRenderStyle.Secondary" CssClass="btn-modern shadow-sm"
                              Click="AbonarTodoElSaldo" Enabled="@(!isSaving)" />
                </div>

                @if (!TieneCuentaProveedorDisponible)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        El proveedor no tiene una cuenta contable valida configurada. No se puede registrar el abono.
                    </div>
                }
                @if (cuentasContra.Count == 0)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        No hay cuentas de origen disponibles para el abono.
                    </div>
                }

                <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="Monto del abono" ColSpanMd="3">
                        <DxSpinEdit TValue="decimal" @bind-Value="nuevoMonto"
                                    MinValue="0m" MaxValue="@saldo.Saldo" Increment="0.01m"
                                    DisplayFormat="N2" InputCssClass="text-end"
                                    ValidationEnabled="false" Enabled="@PuedeEditarFormulario" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Metodo de pago" ColSpanMd="3">
                        <DxComboBox Data="@metodosPago" TData="MetodoPagoItem" TValue="string"
                                    Value="@nuevoMetodo"
                                    ValueChanged="@((string v) => OnMetodoChangedAsync(v))"
                                    ValueFieldName="@nameof(MetodoPagoItem.Value)"
                                    TextFieldName="@nameof(MetodoPagoItem.Display)"
                                    NullText="Seleccione metodo" DropDownStyle="DropDownStyle.DropDownList"
                                    Enabled="@PuedeEditarFormulario" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Banco" ColSpanMd="3">
                        <DxComboBox Data="@BancosDisponibles"
                                    TData="string"
                                    TValue="string"
                                    Value="@bancoSeleccionadoNombre"
                                    ValueChanged="@OnBancoChanged"
                                    NullText="Seleccione el banco"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                    SearchDelay="200"
                                    DropDownStyle="DropDownStyle.DropDown"
                                    DropDownTriggerMode="DropDownTriggerMode.Input"
                                    AllowUserInput="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    ValidationEnabled="false" Enabled="@PuedeEditarFormulario" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Cuenta de origen" ColSpanMd="3">
                        <DxComboBox Data="@CuentasOrigenFiltradas"
                                    TData="CuentaContableLookupDto"
                                    TValue="long?"
                                    Value="@bancoCuentaSeleccionadaId"
                                    ValueChanged="@((long? v) => OnCuentaOrigenChangedAsync(v))"
                                    ValueFieldName="@nameof(CuentaContableLookupDto.BancoCuentaId)"
                                    TextFieldName="@nameof(CuentaContableLookupDto.NumeroCuenta)"
                                    NullText="@(string.IsNullOrWhiteSpace(bancoSeleccionadoNombre) ? "Seleccione primero el banco" : "Seleccione la cuenta")"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                    SearchDelay="200"
                                    DropDownStyle="DropDownStyle.DropDown"
                                    DropDownTriggerMode="DropDownTriggerMode.Input"
                                    AllowUserInput="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    ValidationEnabled="false"
                                    Enabled="@(PuedeEditarFormulario && !string.IsNullOrWhiteSpace(bancoSeleccionadoNombre))" />
                    </DxFormLayoutItem>
                </DxFormLayout>

                @if (CuentaOrigenSeleccionada is not null)
                {
                    <div class="text-muted mt-2">
                        Tipo de cuenta: <strong>@GetTextOrDash(CuentaOrigenSeleccionada.TipoCuenta)</strong>
                        &middot; Cuenta contable: <strong>@FormatCuentaOrDash(CuentaOrigenSeleccionada.Code)</strong>
                        <span>@GetTextOrDash(CuentaOrigenSeleccionada.Description)</span>
                    </div>
                }

                @if (EsMetodoCheque && bancoCuentaSeleccionadaId.HasValue)
                {
                    @if (proximoCheque is { Agotado: true })
                    {
                        <div class="alert alert-danger mt-2 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            La numeración de cheques de esta cuenta está agotada (máximo @proximoCheque.ChequeMaximo.ToString("N0")).
                            Actualice la numeración en la gestión de la cuenta.
                        </div>
                    }
                    else if (proximoCheque is not null)
                    {
                        <div class="text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Se emitirá el cheque N° <strong>@proximoCheque.ProximoCheque.ToString("N0")</strong>.
                        </div>
                    }
                }

                <div class="partida-preview mt-3">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2 section-header">
                        <div>
                            <h6 class="mb-0">Detalle contable del abono</h6>
                            <small class="text-muted">Vista previa de la partida que se generara al registrar el abono.</small>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="summary-pill">Debito: <strong>@TotalDebitoPreviewTexto</strong></span>
                            <span class="summary-pill">Credito: <strong>@TotalCreditoPreviewTexto</strong></span>
                        </div>
                    </div>

                    @if (nuevoMonto <= 0m)
                    {
                        <div class="alert alert-info mb-0" role="alert">
                            Capture el monto del abono para ver la partida contable.
                        </div>
                    }
                    else if (CuentaOrigenSeleccionada is null)
                    {
                        <div class="alert alert-info mb-0" role="alert">
                            Seleccione el banco y la cuenta de origen para ver la contrapartida del abono.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive detail-table">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="min-width:260px;">Cuenta</th>
                                        <th style="min-width:200px;">Descripcion</th>
                                        <th style="min-width:110px;" class="text-end">Debito</th>
                                        <th style="min-width:110px;" class="text-end">Credito</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var linea in LineasPartidaPreview)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">@linea.CuentaCodigo</span>
                                                    <small class="text-muted">@linea.CuentaNombre</small>
                                                </div>
                                            </td>
                                            <td>@GetTextOrDash(linea.Descripcion)</td>
                                            <td class="text-end">@linea.Debito.ToString("N2")</td>
                                            <td class="text-end">@linea.Credito.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-semibold">
                                        <td colspan="2" class="text-end">Totales</td>
                                        <td class="text-end">@TotalDebitoPreviewTexto</td>
                                        <td class="text-end">@TotalCreditoPreviewTexto</td>
                                    </tr>
                                    @if (PartidaPreviewNoCuadra)
                                    {
                                        <tr class="partida-no-cuadra-message">
                                            <td colspan="4">@PartidaPreviewNoCuadraMensaje</td>
                                        </tr>
                                    }
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="total-bar mt-3">
                    <div class="text-muted">Usuario: <strong>@UsuarioActualTexto</strong></div>
                    <DxButton Text="@(isSaving ? "Registrando..." : "Registrar abono")"
                              IconCssClass="bi bi-check2-circle" RenderStyle="ButtonRenderStyle.Success"
                              CssClass="btn-modern shadow-sm" Click="RegistrarAbonoAsync" Enabled="@CanRegistrar" />
                </div>
            </div>
        }

        <div class="modern-card">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3 section-header">
                <div>
                    <h5 class="mb-0">Historial de abonos</h5>
                    <small class="text-muted">Solo puede anularse el ultimo abono vigente.</small>
                </div>
                <span class="summary-pill">Abonos: <strong>@saldo.Abonos.Count</strong></span>
            </div>

            @if (saldo.Abonos.Count == 0)
            {
                <div class="alert alert-info mb-0" role="alert">Este compromiso aun no tiene abonos registrados.</div>
            }
            else
            {
                <div class="grid-wrapper">
                    <DxGrid Data="@saldo.Abonos" TData="AbonoCompromisoListItemDto"
                            KeyFieldName="@nameof(AbonoCompromisoListItemDto.NumeroAbono)"
                            PageSize="10" ShowFilterRow="false" ShowSearchBox="false" ShowGroupPanel="false"
                            SizeMode="SizeMode.Large" CssClass="grid-modern">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(AbonoCompromisoListItemDto.NumeroAbono)" Caption="#"
                                              Width="70px" TextAlignment="GridTextAlignment.Center" />
                            <DxGridDataColumn FieldName="@nameof(AbonoCompromisoListItemDto.Fecha)" Caption="Fecha"
                                              Width="120px" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="@nameof(AbonoCompromisoListItemDto.MetodoPago)" Caption="Metodo" MinWidth="140" />
                            <DxGridDataColumn FieldName="@nameof(AbonoCompromisoListItemDto.Monto)" Caption="Monto"
                                              Width="140px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(AbonoCompromisoListItemDto.NumeroPartida)" Caption="Partida" Width="150px">
                                <CellDisplayTemplate Context="cell">
                                    @GetTextOrDash(((AbonoCompromisoListItemDto)cell.DataItem).NumeroPartida)
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Estado" Width="120px">
                                <CellDisplayTemplate Context="cell">
                                    @if (cell.DataItem is AbonoCompromisoListItemDto item)
                                    {
                                        <span class="badge-status @(EsVigente(item) ? "active" : "inactive")">
                                            @(EsVigente(item) ? "Vigente" : "Anulado")
                                        </span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Acciones" Width="180px">
                                <CellDisplayTemplate Context="cell">
                                    @if (cell.DataItem is AbonoCompromisoListItemDto item)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn-icon btn-view" title="Ver comprobante"
                                                    @onclick="@(() => VerComprobanteAsync(item.NumeroAbono))">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                            <button type="button" class="btn-icon btn-view"
                                                    title="@(item.PartidaId is > 0 ? "Ver detalle contable" : "El abono no tiene partida contable")"
                                                    disabled="@(item.PartidaId is not > 0)"
                                                    @onclick="@(() => VerPartidaAsync(item))">
                                                <i class="bi bi-journal-text"></i>
                                            </button>
                                            <button type="button" class="btn-icon btn-delete" title="Anular abono"
                                                    disabled="@(!item.PuedeAnular || isSaving)"
                                                    @onclick="@(() => AnularAbonoAsync(item.NumeroAbono))">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </div>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </div>
            }
        </div>
    }

    <DxPopup @bind-Visible="partidaPopupVisible"
             HeaderText="@PartidaPopupTitulo"
             Width="820px"
             MaxWidth="95vw"
             Scrollable="true"
             CloseOnEscape="true"
             CloseOnOutsideClick="true">
        <BodyContentTemplate>
            @if (partidaLoading)
            {
                <DxSkeletonLine />
                <DxSkeletonLine />
                <DxSkeletonLine />
            }
            else if (!string.IsNullOrWhiteSpace(partidaError))
            {
                <div class="alert alert-warning mb-0" role="alert">@partidaError</div>
            }
            else if (partidaSeleccionada is null)
            {
                <div class="alert alert-info mb-0" role="alert">No hay partida contable para este abono.</div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
                    <div class="text-muted">
                        Partida <strong>@GetTextOrDash(partidaSeleccionada.PolizaNumber)</strong>
                        &middot; Fecha <strong>@partidaSeleccionada.PolizaDate.ToString("dd/MM/yyyy")</strong>
                        @if (!string.IsNullOrWhiteSpace(partidaSeleccionada.DocumentNumber))
                        {
                            <span> &middot; Documento <strong>@partidaSeleccionada.DocumentNumber</strong></span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="summary-pill">Debito: <strong>@partidaSeleccionada.TotalDebit.ToString("N2")</strong></span>
                        <span class="summary-pill">Credito: <strong>@partidaSeleccionada.TotalCredit.ToString("N2")</strong></span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(partidaSeleccionada.Description))
                {
                    <div class="text-muted mb-3">@partidaSeleccionada.Description</div>
                }

                @if (!partidaSeleccionada.IsBalanced)
                {
                    <div class="alert alert-warning" role="alert">
                        Precaucion: la partida no cuadra
                        (Debito: @partidaSeleccionada.TotalDebit.ToString("N2"),
                        Credito: @partidaSeleccionada.TotalCredit.ToString("N2")).
                    </div>
                }

                <div class="table-responsive detail-table">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="min-width:260px;">Cuenta</th>
                                <th style="min-width:200px;">Descripcion</th>
                                <th style="min-width:110px;" class="text-end">Debito</th>
                                <th style="min-width:110px;" class="text-end">Credito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in partidaSeleccionada.Lineas)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold">@FormatCuentaOrDash(linea.AccountCode)</span>
                                            <small class="text-muted">@GetTextOrDash(linea.AccountName)</small>
                                        </div>
                                    </td>
                                    <td>@GetTextOrDash(linea.Description)</td>
                                    <td class="text-end">@linea.DebitAmount.ToString("N2")</td>
                                    <td class="text-end">@linea.CreditAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="2" class="text-end">Totales</td>
                                <td class="text-end">@partidaSeleccionada.TotalDebit.ToString("N2")</td>
                                <td class="text-end">@partidaSeleccionada.TotalCredit.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </BodyContentTemplate>
    </DxPopup>

    <ChequeImpresionDialog Visible="impresionDialogVisible"
                           VisibleChanged="OnImpresionDialogVisibleChanged"
                           ChequeId="chequeIdEmitido"
                           DocumentoUrl="@documentoImpresionUrl"
                           DocumentoTexto="Imprimir comprobante de abono"
                           Mensaje="El abono se registró y se emitió el cheque. ¿Qué desea imprimir?" />
</div>

@code {
    [Parameter]
    public int NumeroOrden { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly List<CuentaContableLookupDto> cuentasContra = new();

    // Plan de cuentas completo: solo se usa para mostrar el nombre de la cuenta del proveedor
    // en la vista previa del asiento (el compromiso guarda el codigo, no el account_id).
    private readonly List<CuentaContableLookupDto> cuentasContables = new();

    // OrdenPagoDirectoMetodoPago es clase estatica de constantes string (Contable="CONTABLE", ...),
    // NO enum. El Value enviado al backend usa esas constantes para ser compatible con EsBancario.
    private readonly List<MetodoPagoItem> metodosPago = new()
    {
        new(OrdenPagoDirectoMetodoPago.Contable, "Contable"),
        new(OrdenPagoDirectoMetodoPago.Deposito, "Deposito"),
        new(OrdenPagoDirectoMetodoPago.Cheque, "Cheque"),
        new(OrdenPagoDirectoMetodoPago.Transferencia, "Transferencia"),
    };

    private CompromisoSaldoDto? saldo;
    private OrdenPagoDirectoDetalleDto? detalle;
    private decimal nuevoMonto;

    // Dialogo de impresion post-emision de cheque (abono con metodo CHEQUE).
    private bool impresionDialogVisible;
    private long chequeIdEmitido;
    private string? documentoImpresionUrl;
    private string? nuevoMetodo = OrdenPagoDirectoMetodoPago.Contable;
    private string? bancoSeleccionadoNombre;
    private long? bancoCuentaSeleccionadaId;
    private bool isLoading = true;
    private bool isSaving;

    // Detalle contable de un abono ya registrado (partida ABO), leido de la API de partidas.
    private bool partidaPopupVisible;
    private bool partidaLoading;
    private string? partidaError;
    private int partidaAbonoNumero;
    private PolizaConLineasDto? partidaSeleccionada;

    private ErrorNotice errorNotice = default!;
    private readonly List<string> validationMessages = new();
    private string usuarioActual = "SISTEMA";

    private bool EstaPagado => saldo is not null && saldo.Saldo <= 0m;
    private bool TieneCuentaProveedorDisponible => !string.IsNullOrWhiteSpace(detalle?.CuentaContableProveedor);
    private bool PuedeEditarFormulario => !isSaving && !EstaPagado && TieneCuentaProveedorDisponible && cuentasContra.Count > 0;
    private string UsuarioActualTexto => string.IsNullOrWhiteSpace(usuarioActual) ? "SISTEMA" : usuarioActual;
    private string ProveedorResumenTexto => BuildProveedorResumenTexto();
    private string EstadoBadgeClass => saldo?.EstadoTexto switch
    {
        "Pagado" => "inactive",
        "Anulado" => "inactive",
        "Abonado parcial" => "partial",
        _ => "pending"
    };
    private bool CanRegistrar => PuedeEditarFormulario &&
                                 nuevoMonto > 0m &&
                                 nuevoMonto <= (saldo?.Saldo ?? 0m) &&
                                 CuentaOrigenSeleccionada is not null &&
                                 !string.IsNullOrWhiteSpace(nuevoMetodo) &&
                                 !ChequeAgotado;

    // Vista previa del asiento del abono. Replica lo que arma el servicio en RegistrarAbonoAsync:
    // la cuenta de origen va al HABER por el monto del abono y la cuenta del proveedor al DEBE
    // por el mismo monto (ver BuildProviderProcessingPartidaLineasAsync). Se recalcula en cada
    // acceso a partir del monto y la cuenta de origen elegidos: no hay estado que sincronizar.
    private IReadOnlyList<PartidaPreviewLinea> LineasPartidaPreview
    {
        get
        {
            var cuentaOrigen = CuentaOrigenSeleccionada;
            if (nuevoMonto <= 0m || cuentaOrigen is null)
            {
                return Array.Empty<PartidaPreviewLinea>();
            }

            var descripcion = DescripcionAbonoPreview;
            return new List<PartidaPreviewLinea>
            {
                new(FormatCuentaOrDash(cuentaOrigen.Code), GetTextOrDash(cuentaOrigen.Description),
                    descripcion, 0m, nuevoMonto),
                new(CuentaProveedorCodigoTexto, CuentaProveedorNombreTexto,
                    descripcion, nuevoMonto, 0m)
            };
        }
    }

    // Misma descripcion que arma el servicio para las lineas del abono ("Abono - <concepto>", 200 chars).
    private string DescripcionAbonoPreview
    {
        get
        {
            var concepto = string.IsNullOrWhiteSpace(detalle?.Concepto)
                ? $"Orden pago directo {NumeroOrden}"
                : detalle!.Concepto.Trim();
            var descripcion = $"Abono - {concepto}";
            return descripcion.Length > 200 ? descripcion[..200] : descripcion;
        }
    }

    private decimal TotalDebitoPreview => LineasPartidaPreview.Sum(x => x.Debito);
    private decimal TotalCreditoPreview => LineasPartidaPreview.Sum(x => x.Credito);
    private string TotalDebitoPreviewTexto => TotalDebitoPreview.ToString("N2");
    private string TotalCreditoPreviewTexto => TotalCreditoPreview.ToString("N2");
    private bool PartidaPreviewNoCuadra =>
        LineasPartidaPreview.Count > 0 && Math.Abs(TotalDebitoPreview - TotalCreditoPreview) > 0.01m;
    private string PartidaPreviewNoCuadraMensaje =>
        $"La partida contable no cuadra. Debito: {TotalDebitoPreviewTexto}, Credito: {TotalCreditoPreviewTexto}.";

    private string CuentaProveedorCodigoTexto => FormatCuentaOrDash(detalle?.CuentaContableProveedor);

    private string CuentaProveedorNombreTexto
    {
        get
        {
            var codigo = detalle?.CuentaContableProveedor?.Trim();
            if (string.IsNullOrWhiteSpace(codigo))
            {
                return "-";
            }

            var cuenta = cuentasContables.FirstOrDefault(c =>
                string.Equals(c.Code?.Trim(), codigo, StringComparison.OrdinalIgnoreCase));
            return GetTextOrDash(cuenta?.Description);
        }
    }

    private string PartidaPopupTitulo => partidaAbonoNumero > 0
        ? $"Detalle contable del abono #{partidaAbonoNumero}"
        : "Detalle contable del abono";

    // Numeración de cheques de la cuenta de origen (solo se consulta con método CHEQUE).
    private ProximoChequeDto? proximoCheque;
    private int proximoChequeSeq; // Descarta respuestas viejas si cuenta/método cambian en vuelo.

    private bool EsMetodoCheque =>
        string.Equals(nuevoMetodo, OrdenPagoDirectoMetodoPago.Cheque, StringComparison.OrdinalIgnoreCase);

    private bool ChequeAgotado => EsMetodoCheque && proximoCheque is { Agotado: true };

    private async Task OnMetodoChangedAsync(string? value)
    {
        nuevoMetodo = value;
        await RefrescarProximoChequeAsync();
    }

    private async Task OnCuentaOrigenChangedAsync(long? value)
    {
        bancoCuentaSeleccionadaId = value;
        await RefrescarProximoChequeAsync();
    }

    private async Task RefrescarProximoChequeAsync()
    {
        var seq = ++proximoChequeSeq;
        proximoCheque = null;
        if (!EsMetodoCheque || !bancoCuentaSeleccionadaId.HasValue)
        {
            return;
        }

        try
        {
            var info = await ChequesClient.GetProximoAsync(bancoCuentaSeleccionadaId.Value);
            if (seq == proximoChequeSeq)
            {
                proximoCheque = info;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo consultar el próximo cheque de la cuenta {BancoCuentaId}", bancoCuentaSeleccionadaId);
        }
    }

    // Etiqueta para agrupar cuentas cuya ban_cuenta no tiene nombre de banco (p.ej. migradas de
    // SIMAFI con banco en blanco); sin esto quedarian inseleccionables en la cascada.
    private const string SinBancoLabel = "(Sin banco)";

    // Lista de bancos (distintos) de las cuentas de origen disponibles; el combo de cuenta filtra por banco.
    private IReadOnlyList<string> BancosDisponibles
    {
        get
        {
            var bancos = cuentasContra
                .Select(c => c.BancoNombre)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (cuentasContra.Any(c => string.IsNullOrWhiteSpace(c.BancoNombre)))
            {
                bancos.Add(SinBancoLabel);
            }
            return bancos;
        }
    }

    // Cuentas del banco elegido. Sin banco seleccionado no se lista ninguna (se elige el banco primero).
    private IReadOnlyList<CuentaContableLookupDto> CuentasOrigenFiltradas =>
        string.IsNullOrWhiteSpace(bancoSeleccionadoNombre)
            ? Array.Empty<CuentaContableLookupDto>()
            : string.Equals(bancoSeleccionadoNombre, SinBancoLabel, StringComparison.OrdinalIgnoreCase)
                ? cuentasContra.Where(c => string.IsNullOrWhiteSpace(c.BancoNombre)).ToList()
                : cuentasContra
                    .Where(c => string.Equals(c.BancoNombre?.Trim(), bancoSeleccionadoNombre, StringComparison.OrdinalIgnoreCase))
                    .ToList();

    private CuentaContableLookupDto? CuentaOrigenSeleccionada =>
        bancoCuentaSeleccionadaId.HasValue
            ? cuentasContra.FirstOrDefault(c => c.BancoCuentaId == bancoCuentaSeleccionadaId)
            : null;

    private void OnBancoChanged(string? banco)
    {
        bancoSeleccionadoNombre = string.IsNullOrWhiteSpace(banco) ? null : banco.Trim();
        // La cuenta pertenece al banco: al cambiarlo se limpia la seleccion.
        bancoCuentaSeleccionadaId = null;
        proximoChequeSeq++;
        proximoCheque = null;
    }

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        isLoading = true;
        validationMessages.Clear();
        saldo = null;
        detalle = null;

        try
        {
            await AccountFormat.EnsureLoadedAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            usuarioActual = authState.User.Identity?.Name ?? "SISTEMA";

            var saldoTask = OrdenesPagoDirectoClient.GetSaldoConAbonosAsync(NumeroOrden);
            var detalleTask = OrdenesPagoDirectoClient.GetByNumeroOrdenAsync(NumeroOrden);
            var cuentasTask = OrdenesPagoDirectoClient.GetCuentasContraProcesamientoAsync();
            var planCuentasTask = OrdenesPagoDirectoClient.GetCuentasContablesAsync();
            await Task.WhenAll(saldoTask, detalleTask, cuentasTask, planCuentasTask);

            saldo = await saldoTask;
            detalle = await detalleTask;
            cuentasContra.Clear();
            cuentasContra.AddRange(await cuentasTask);
            cuentasContables.Clear();
            cuentasContables.AddRange(await planCuentasTask);

            if (saldo is null)
            {
                ShowToast("Abonar compromiso", $"No se encontro el compromiso {NumeroOrden}.", ToastRenderStyle.Danger);
                return;
            }

            ResetFormulario();
        }
        catch (Exception ex)
        {
            ShowToast("Abonar compromiso", "No se pudo cargar la pantalla de abonos.", ToastRenderStyle.Danger);
            Logger.LogError(ex, "Error al cargar pantalla de abonos para compromiso {NumeroOrden}", NumeroOrden);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFormulario()
    {
        nuevoMonto = 0m;
        nuevoMetodo = OrdenPagoDirectoMetodoPago.Contable;
        bancoSeleccionadoNombre = null;
        bancoCuentaSeleccionadaId = null;
        proximoChequeSeq++;
        proximoCheque = null;
    }

    private void AbonarTodoElSaldo()
    {
        if (saldo is not null)
        {
            nuevoMonto = saldo.Saldo;
        }
    }

    private async Task RegistrarAbonoAsync()
    {
        if (saldo is null || EstaPagado)
        {
            return;
        }

        validationMessages.Clear();
        if (!Validar())
        {
            ShowToast("Validacion", string.Join(" | ", validationMessages), ToastRenderStyle.Warning);
            return;
        }

        try
        {
            isSaving = true;

            var cuentaOrigen = CuentaOrigenSeleccionada!;
            var dto = new AbonoCompromisoUpsertDto
            {
                Monto = nuevoMonto,
                MetodoPago = nuevoMetodo!,
                CuentaContraId = cuentaOrigen.AccountId,
                BancoCuentaId = cuentaOrigen.BancoCuentaId,
                CuentaDestinoProveedorId = null, // informativo; combo de cuenta destino pendiente
                Usuario = UsuarioActualTexto
            };

            var result = await OrdenesPagoDirectoClient.RegistrarAbonoAsync(NumeroOrden, dto);
            if (!result.Success)
            {
                ShowToast("Abonar compromiso", result.Message, ToastRenderStyle.Danger);
                return;
            }

            ShowToast("Exito", result.Message, ToastRenderStyle.Success);

            if (result.ChequeId is > 0)
            {
                // Abono con cheque: ofrecer comprobante de abono / cheque / cheque + detalle.
                chequeIdEmitido = result.ChequeId.Value;
                documentoImpresionUrl = result.NumeroAbono > 0
                    ? OrdenesPagoDirectoClient.GetComprobanteAbonoUrl(NumeroOrden, result.NumeroAbono)
                    : null;
                impresionDialogVisible = true;
            }
            else
            {
                if (result.NumeroAbono > 0)
                {
                    await JS.InvokeVoidAsync("open",
                        OrdenesPagoDirectoClient.GetComprobanteAbonoUrl(NumeroOrden, result.NumeroAbono), "_blank");
                }

                await CargarAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar abono del compromiso {NumeroOrden}", NumeroOrden);
            errorNotice.ShowError("No se pudo registrar el abono.", ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnImpresionDialogVisibleChanged(bool value)
    {
        impresionDialogVisible = value;
        if (!value)
        {
            // Al cerrar el dialogo de impresion, recargar el estado del compromiso.
            await CargarAsync();
        }
    }

    private async Task AnularAbonoAsync(int numeroAbono)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Anular el abono #{numeroAbono} del compromiso {NumeroOrden}?");
        if (!confirmado)
        {
            return;
        }

        try
        {
            isSaving = true;

            var dto = new AnularOrdenPagoDirectoDto { Motivo = "Anulacion desde pantalla de abonos" };
            var result = await OrdenesPagoDirectoClient.AnularAbonoAsync(NumeroOrden, numeroAbono, dto);
            if (!result.Success)
            {
                ShowToast("Anular abono", result.Message, ToastRenderStyle.Danger);
                return;
            }

            ShowToast("Exito", result.Message, ToastRenderStyle.Success);
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al anular abono {NumeroAbono} del compromiso {NumeroOrden}", numeroAbono, NumeroOrden);
            errorNotice.ShowError("No se pudo anular el abono.", ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task VerComprobanteAsync(int numeroAbono)
        => await JS.InvokeVoidAsync("open", OrdenesPagoDirectoClient.GetComprobanteAbonoUrl(NumeroOrden, numeroAbono), "_blank");

    /// <summary>
    /// Abre el detalle contable (lineas debito/credito) de la partida ABO que genero el abono.
    /// El abono guarda partida_id; las lineas se leen de la API de partidas.
    /// </summary>
    private async Task VerPartidaAsync(AbonoCompromisoListItemDto item)
    {
        if (item.PartidaId is not > 0)
        {
            return;
        }

        partidaAbonoNumero = item.NumeroAbono;
        partidaSeleccionada = null;
        partidaError = null;
        partidaLoading = true;
        partidaPopupVisible = true;

        try
        {
            partidaSeleccionada = await PolizasClient.ObtenerAsync(item.PartidaId.Value);
            if (partidaSeleccionada is null)
            {
                partidaError = "No se encontro la partida contable del abono.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            partidaError = "No tiene permisos para consultar el detalle contable.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la partida {PartidaId} del abono {NumeroAbono} del compromiso {NumeroOrden}",
                item.PartidaId, item.NumeroAbono, NumeroOrden);
            partidaError = "No se pudo cargar el detalle contable del abono.";
        }
        finally
        {
            partidaLoading = false;
        }
    }

    private bool Validar()
    {
        if (saldo is null)
        {
            validationMessages.Add("No se cargo el saldo del compromiso.");
            return false;
        }

        if (!TieneCuentaProveedorDisponible)
        {
            validationMessages.Add("El proveedor no tiene una cuenta contable valida configurada.");
        }

        if (nuevoMonto <= 0m)
        {
            validationMessages.Add("El monto del abono debe ser mayor a cero.");
        }
        else if (nuevoMonto > saldo.Saldo)
        {
            validationMessages.Add($"El monto no puede superar el saldo pendiente ({saldo.Saldo:N2}).");
        }

        if (string.IsNullOrWhiteSpace(bancoSeleccionadoNombre))
        {
            validationMessages.Add("Debe seleccionar el banco de origen.");
        }
        else if (CuentaOrigenSeleccionada is null)
        {
            validationMessages.Add("Debe seleccionar la cuenta de origen del banco.");
        }

        if (string.IsNullOrWhiteSpace(nuevoMetodo))
        {
            validationMessages.Add("Debe seleccionar el metodo de pago.");
        }

        return validationMessages.Count == 0;
    }

    private void Volver()
    {
        var returnUrl = NormalizeLocalUrl(ReturnUrl) ?? "/proveedores/compromisos-proveedor";
        Navigation.NavigateTo(returnUrl, true);
    }

    private static bool EsVigente(AbonoCompromisoListItemDto item)
        => string.Equals(item.Estado, "V", StringComparison.OrdinalIgnoreCase);

    private string BuildProveedorResumenTexto()
    {
        var correlativo = detalle?.CorrelativoProveedor?.ToString() ?? "-";
        var proveedor = GetTextOrDash(detalle?.Proveedor);
        if (correlativo == "-")
        {
            return proveedor;
        }
        return proveedor == "-" ? correlativo : $"{correlativo} - {proveedor}";
    }

    private void ShowToast(string title, string message, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions
        {
            Title = title,
            Text = message,
            RenderStyle = style,
            ProviderName = "CompromisoProveedorAbonarToast"
        });
    }

    private static string GetTextOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private string FormatCuentaOrDash(string? cuenta)
    {
        var formatted = AccountFormat.Format(cuenta);
        return string.IsNullOrWhiteSpace(formatted) ? "-" : formatted;
    }

    private static string? NormalizeLocalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        var normalized = url.Trim();
        return !normalized.StartsWith("/", StringComparison.Ordinal) || normalized.StartsWith("//", StringComparison.Ordinal)
            ? null
            : normalized;
    }

