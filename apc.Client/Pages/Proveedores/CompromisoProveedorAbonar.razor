<PdfPreviewPopup @ref="pdfPopup" />

@code {
    [Parameter]
    public int NumeroOrden { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly List<CuentaContableLookupDto> cuentasContra = new();

    // Plan de cuentas completo: se usa para mostrar el nombre de la cuenta del proveedor en la vista
    // previa del asiento (el compromiso guarda el codigo, no el account_id) y como origen del combo de
    // cuenta en el popup de retenciones/deducciones.
    private readonly List<CuentaContableLookupDto> cuentasContables = new();

    // Retenciones/deducciones aplicadas al abono (F3). Modelo identico al de CompromisoProveedorProcesar:
    // se edita un borrador (deduccionesDraft) en el popup y solo se vuelca a 'deducciones' al Aplicar.
    private readonly List<DeduccionLinea> deducciones = new();
    private readonly List<DeduccionLinea> deduccionesDraft = new();
    private bool popupDeduccionesVisible;

    // Editor del popup.
    private long? editorCuentaId;
    private string editorDescripcion = string.Empty;
    private DeduccionTipo editorTipo = DeduccionTipo.Retencion;
    private decimal editorMonto;
    private int? editorIndex;
    private string? editorError;

    // F2: catalogo de retenciones aplicable a la fecha del compromiso + tasa ISV general vigente. La
    // aritmetica vive en RetencionCalculator (SIAD.Core, puro y testeado); la UI solo orquesta.
    private readonly List<RetencionAplicableDto> retencionesAplicables = new();
    private decimal? tasaIsvGeneral;
    private int? editorRetencionId;        // tipo de retencion elegido en el editor (null = linea manual)
    private decimal editorBase;            // base imponible editable (modo Retencion)
    private string? editorRetencionAviso;  // aviso del autocalculo: sin tasa / sin cuenta / sin ISV vigente

    // OrdenPagoDirectoMetodoPago es clase estatica de constantes string (Contable="CONTABLE", ...),
    // NO enum. El Value enviado al backend usa esas constantes para ser compatible con EsBancario.
    private readonly List<MetodoPagoItem> metodosPago = new()
    {
        new(OrdenPagoDirectoMetodoPago.Contable, "Contable"),
        new(OrdenPagoDirectoMetodoPago.Deposito, "Deposito"),
        new(OrdenPagoDirectoMetodoPago.Cheque, "Cheque"),
        new(OrdenPagoDirectoMetodoPago.Transferencia, "Transferencia"),
    };

    private CompromisoSaldoDto? saldo;
    private OrdenPagoDirectoDetalleDto? detalle;
    private decimal nuevoMonto;

    // Dialogo de impresion post-emision de cheque (abono con metodo CHEQUE).
    private bool impresionDialogVisible;
    private long chequeIdEmitido;
    private string? documentoImpresionUrl;
    private string? nuevoMetodo = OrdenPagoDirectoMetodoPago.Contable;
    private string? bancoSeleccionadoNombre;
    private long? bancoCuentaSeleccionadaId;
    private bool isLoading = true;
    private bool isSaving;

    // Detalle contable de un abono ya registrado (partida ABO), leido de la API de partidas.
    private bool partidaPopupVisible;
    private bool partidaLoading;
    private string? partidaError;
    private int partidaAbonoNumero;
    private PolizaConLineasDto? partidaSeleccionada;

    private ErrorNotice errorNotice = default!;
    private PdfPreviewPopup? pdfPopup;
    private readonly List<string> validationMessages = new();
    private string usuarioActual = "SISTEMA";

    private bool EstaPagado => saldo is not null && saldo.Saldo <= 0m;
    private bool TieneCuentaProveedorDisponible => !string.IsNullOrWhiteSpace(detalle?.CuentaContableProveedor);
    private bool PuedeEditarFormulario => !isSaving && !EstaPagado && TieneCuentaProveedorDisponible && cuentasContra.Count > 0;
    private string UsuarioActualTexto => string.IsNullOrWhiteSpace(usuarioActual) ? "SISTEMA" : usuarioActual;
    private string ProveedorResumenTexto => BuildProveedorResumenTexto();
    private string EstadoBadgeClass => saldo?.EstadoTexto switch
    {
        "Pagado" => "inactive",
        "Anulado" => "inactive",
        "Abonado parcial" => "partial",
        _ => "pending"
    };
    private bool CanRegistrar => PuedeEditarFormulario &&
                                 nuevoMonto > 0m &&
                                 nuevoMonto <= (saldo?.Saldo ?? 0m) &&
                                 CuentaOrigenSeleccionada is not null &&
                                 !string.IsNullOrWhiteSpace(nuevoMetodo) &&
                                 (deducciones.Count == 0 || NetoBanco > 0m) &&
                                 !ChequeAgotado;

    // Vista previa del asiento del abono. Replica lo que arma el servicio en RegistrarAbonoAsync:
    // origen/banco al HABER por el NETO + retenciones/deducciones + proveedor al DEBE por el BRUTO
    // (= monto del abono). Sin deducciones el neto == bruto, asi que rinde identico al abono simple.
    // Se recalcula en cada acceso a partir del monto, la cuenta de origen y las deducciones: no hay
    // estado que sincronizar.
    private IReadOnlyList<PartidaPreviewLinea> LineasPartidaPreview
    {
        get
        {
            var cuentaOrigen = CuentaOrigenSeleccionada;
            if (nuevoMonto <= 0m || cuentaOrigen is null)
            {
                return Array.Empty<PartidaPreviewLinea>();
            }

            var descripcion = DescripcionAbonoPreview;
            var lineas = new List<PartidaPreviewLinea>
            {
                new(FormatCuentaOrDash(cuentaOrigen.Code), GetTextOrDash(cuentaOrigen.Description),
                    descripcion, 0m, NetoBanco)
            };

            foreach (var d in deducciones)
            {
                var cuenta = cuentasContables.FirstOrDefault(c => c.AccountId == (d.CuentaId ?? 0));
                lineas.Add(new PartidaPreviewLinea(
                    cuenta is not null ? FormatCuentaOrDash(cuenta.Code) : "-",
                    cuenta is not null ? GetTextOrDash(cuenta.Description) : "Sin cuenta",
                    string.IsNullOrWhiteSpace(d.Descripcion) ? descripcion : d.Descripcion.Trim(),
                    d.Debe, d.Haber));
            }

            lineas.Add(new PartidaPreviewLinea(CuentaProveedorCodigoTexto, CuentaProveedorNombreTexto,
                descripcion, Bruto, 0m));

            return lineas;
        }
    }

    // Misma descripcion que arma el servicio para las lineas del abono ("Abono - <concepto>", 200 chars).
    private string DescripcionAbonoPreview
    {
        get
        {
            var concepto = string.IsNullOrWhiteSpace(detalle?.Concepto)
                ? $"Orden pago directo {NumeroOrden}"
                : detalle!.Concepto.Trim();
            var descripcion = $"Abono - {concepto}";
            return descripcion.Length > 200 ? descripcion[..200] : descripcion;
        }
    }

    // El "bruto" del abono es el monto capturado (lo que reduce el SALDO del compromiso). El proveedor va
    // al DEBE por el bruto; el neto lo paga el banco/origen.
    private decimal Bruto => nuevoMonto;
    private decimal TotalDeduccionDebe => deducciones.Sum(x => x.Debe);
    private decimal TotalDeduccionHaber => deducciones.Sum(x => x.Haber);
    // neto = bruto + Sum(Debe deduccion) - Sum(Haber deduccion). Es el HABER que se le asienta al banco.
    private decimal NetoBanco => Bruto + TotalDeduccionDebe - TotalDeduccionHaber;

    // Totales del borrador que se edita dentro del popup (aun sin aplicar a la partida).
    private decimal DraftDebe => deduccionesDraft.Sum(x => x.Debe);
    private decimal DraftHaber => deduccionesDraft.Sum(x => x.Haber);
    private decimal DraftNeto => Bruto + DraftDebe - DraftHaber;

    // Neto proyectado con la linea que se esta capturando. Excluye la linea en edicion para no contarla dos veces.
    private decimal ProyeccionNetoBase =>
        Bruto
        + deduccionesDraft.Where((_, i) => editorIndex is null || i != editorIndex.Value).Sum(x => x.Debe)
        - deduccionesDraft.Where((_, i) => editorIndex is null || i != editorIndex.Value).Sum(x => x.Haber);
    private decimal ProyeccionNeto => ProyeccionNetoBase + (editorTipo == DeduccionTipo.Cargo ? editorMonto : -editorMonto);

    private decimal TotalDebitoPreview => LineasPartidaPreview.Sum(x => x.Debito);
    private decimal TotalCreditoPreview => LineasPartidaPreview.Sum(x => x.Credito);
    private string TotalDebitoPreviewTexto => TotalDebitoPreview.ToString("N2");
    private string TotalCreditoPreviewTexto => TotalCreditoPreview.ToString("N2");
    private bool PartidaPreviewNoCuadra =>
        LineasPartidaPreview.Count > 0 && Math.Abs(TotalDebitoPreview - TotalCreditoPreview) > 0.01m;
    private string PartidaPreviewNoCuadraMensaje =>
        $"La partida contable no cuadra. Debito: {TotalDebitoPreviewTexto}, Credito: {TotalCreditoPreviewTexto}.";

    private string CuentaProveedorCodigoTexto => FormatCuentaOrDash(detalle?.CuentaContableProveedor);

    private string CuentaProveedorNombreTexto
    {
        get
        {
            var codigo = detalle?.CuentaContableProveedor?.Trim();
            if (string.IsNullOrWhiteSpace(codigo))
            {
                return "-";
            }

            var cuenta = cuentasContables.FirstOrDefault(c =>
                string.Equals(c.Code?.Trim(), codigo, StringComparison.OrdinalIgnoreCase));
            return GetTextOrDash(cuenta?.Description);
        }
    }

    private string PartidaPopupTitulo => partidaAbonoNumero > 0
        ? $"Detalle contable del abono #{partidaAbonoNumero}"
        : "Detalle contable del abono";

    // Numeración de cheques de la cuenta de origen (solo se consulta con método CHEQUE).
    private ProximoChequeDto? proximoCheque;
    private int proximoChequeSeq; // Descarta respuestas viejas si cuenta/método cambian en vuelo.

    private bool EsMetodoCheque =>
        string.Equals(nuevoMetodo, OrdenPagoDirectoMetodoPago.Cheque, StringComparison.OrdinalIgnoreCase);

    private bool ChequeAgotado => EsMetodoCheque && proximoCheque is { Agotado: true };

    private async Task OnMetodoChangedAsync(string? value)
    {
        nuevoMetodo = value;
        await RefrescarProximoChequeAsync();
    }

    private async Task OnCuentaOrigenChangedAsync(long? value)
    {
        bancoCuentaSeleccionadaId = value;
        await RefrescarProximoChequeAsync();
    }

    private async Task RefrescarProximoChequeAsync()
    {
        var seq = ++proximoChequeSeq;
        proximoCheque = null;
        if (!EsMetodoCheque || !bancoCuentaSeleccionadaId.HasValue)
        {
            return;
        }

        try
        {
            var info = await ChequesClient.GetProximoAsync(bancoCuentaSeleccionadaId.Value);
            if (seq == proximoChequeSeq)
            {
                proximoCheque = info;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo consultar el próximo cheque de la cuenta {BancoCuentaId}", bancoCuentaSeleccionadaId);
        }
    }

    // Etiqueta para agrupar cuentas cuya ban_cuenta no tiene nombre de banco (p.ej. migradas de
    // SIMAFI con banco en blanco); sin esto quedarian inseleccionables en la cascada.
    private const string SinBancoLabel = "(Sin banco)";

    // Lista de bancos (distintos) de las cuentas de origen disponibles; el combo de cuenta filtra por banco.
    private IReadOnlyList<string> BancosDisponibles
    {
        get
        {
            var bancos = cuentasContra
                .Select(c => c.BancoNombre)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (cuentasContra.Any(c => string.IsNullOrWhiteSpace(c.BancoNombre)))
            {
                bancos.Add(SinBancoLabel);
            }
            return bancos;
        }
    }

    // Cuentas del banco elegido. Sin banco seleccionado no se lista ninguna (se elige el banco primero).
    private IReadOnlyList<CuentaContableLookupDto> CuentasOrigenFiltradas =>
        string.IsNullOrWhiteSpace(bancoSeleccionadoNombre)
            ? Array.Empty<CuentaContableLookupDto>()
            : string.Equals(bancoSeleccionadoNombre, SinBancoLabel, StringComparison.OrdinalIgnoreCase)
                ? cuentasContra.Where(c => string.IsNullOrWhiteSpace(c.BancoNombre)).ToList()
                : cuentasContra
                    .Where(c => string.Equals(c.BancoNombre?.Trim(), bancoSeleccionadoNombre, StringComparison.OrdinalIgnoreCase))
                    .ToList();

    private CuentaContableLookupDto? CuentaOrigenSeleccionada =>
        bancoCuentaSeleccionadaId.HasValue
            ? cuentasContra.FirstOrDefault(c => c.BancoCuentaId == bancoCuentaSeleccionadaId)
            : null;

    private void OnBancoChanged(string? banco)
    {
        bancoSeleccionadoNombre = string.IsNullOrWhiteSpace(banco) ? null : banco.Trim();
        // La cuenta pertenece al banco: al cambiarlo se limpia la seleccion.
        bancoCuentaSeleccionadaId = null;
        proximoChequeSeq++;
        proximoCheque = null;
    }

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        isLoading = true;
        validationMessages.Clear();
        saldo = null;
        detalle = null;

        try
        {
            await AccountFormat.EnsureLoadedAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            usuarioActual = authState.User.Identity?.Name ?? "SISTEMA";

            var saldoTask = OrdenesPagoDirectoClient.GetSaldoConAbonosAsync(NumeroOrden);
            var detalleTask = OrdenesPagoDirectoClient.GetByNumeroOrdenAsync(NumeroOrden);
            var cuentasTask = OrdenesPagoDirectoClient.GetCuentasContraProcesamientoAsync();
            var planCuentasTask = OrdenesPagoDirectoClient.GetCuentasContablesAsync();
            await Task.WhenAll(saldoTask, detalleTask, cuentasTask, planCuentasTask);

            saldo = await saldoTask;
            detalle = await detalleTask;
            cuentasContra.Clear();
            cuentasContra.AddRange(await cuentasTask);
            cuentasContables.Clear();
            cuentasContables.AddRange(await planCuentasTask);

            if (saldo is null)
            {
                ShowToast("Abonar compromiso", $"No se encontro el compromiso {NumeroOrden}.", ToastRenderStyle.Danger);
                return;
            }

            ResetFormulario();

            // Retenciones vigentes a la FECHA DEL COMPROMISO (no "hoy"): el % que regia en esa fecha.
            await CargarRetencionesAplicablesAsync();
        }
        catch (Exception ex)
        {
            ShowToast("Abonar compromiso", "No se pudo cargar la pantalla de abonos.", ToastRenderStyle.Danger);
            Logger.LogError(ex, "Error al cargar pantalla de abonos para compromiso {NumeroOrden}", NumeroOrden);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFormulario()
    {
        nuevoMonto = 0m;
        nuevoMetodo = OrdenPagoDirectoMetodoPago.Contable;
        bancoSeleccionadoNombre = null;
        bancoCuentaSeleccionadaId = null;
        proximoChequeSeq++;
        proximoCheque = null;
        deducciones.Clear();
    }

    private void AbonarTodoElSaldo()
    {
        if (saldo is not null)
        {
            nuevoMonto = saldo.Saldo;
            RecalcularRetencionesCatalogadas();
        }
    }

    // El bruto del abono lo edita el usuario; al cambiarlo, las retenciones tomadas del catalogo se
    // RECALCULAN desde el nuevo bruto (base x %) para no dejar una retencion mal calculada que igual
    // cuadraria. Las lineas manuales (sin %) y los cargos quedan con su monto fijo.
    private void OnMontoAbonoChanged(decimal value)
    {
        nuevoMonto = value < 0m ? 0m : value;
        RecalcularRetencionesCatalogadas();
    }

    private void RecalcularRetencionesCatalogadas()
    {
        foreach (var d in deducciones)
        {
            if (d.Tipo != DeduccionTipo.Retencion || d.Porcentaje is not { } pct || pct <= 0m)
            {
                continue;
            }

            var baseImp = RetencionCalculator.CalcularBase(Bruto, d.BaseCalculo, tasaIsvGeneral);
            d.Base = baseImp;
            d.Monto = RetencionCalculator.MontoDesdeBase(baseImp, pct);
        }
    }

    private async Task RegistrarAbonoAsync()
    {
        if (saldo is null || EstaPagado)
        {
            return;
        }

        validationMessages.Clear();
        if (!Validar())
        {
            ShowToast("Validacion", string.Join(" | ", validationMessages), ToastRenderStyle.Warning);
            return;
        }

        try
        {
            isSaving = true;

            var cuentaOrigen = CuentaOrigenSeleccionada!;
            var dto = new AbonoCompromisoUpsertDto
            {
                Monto = nuevoMonto,
                MetodoPago = nuevoMetodo!,
                CuentaDestinoProveedorId = null, // informativo; combo de cuenta destino pendiente
                Usuario = UsuarioActualTexto
            };

            if (deducciones.Count > 0)
            {
                // Modelo GENERAL (con retencion): origen/banco al HABER por el NETO + una linea por cada
                // retencion/cargo. El backend agrega el proveedor al DEBE por el bruto (= Monto). Se envia
                // por Lineas (CuentaContraId queda null): asi el servicio rutea al modelo GENERAL.
                var concepto = detalle?.Concepto ?? string.Empty;
                dto.Lineas.Add(new PartidaLineaOrdenPagoDto
                {
                    CuentaId = cuentaOrigen.AccountId,
                    BancoCuentaId = cuentaOrigen.BancoCuentaId,
                    Descripcion = concepto,
                    Debito = 0m,
                    Credito = NetoBanco
                });

                foreach (var d in deducciones)
                {
                    dto.Lineas.Add(new PartidaLineaOrdenPagoDto
                    {
                        CuentaId = d.CuentaId ?? 0,
                        Descripcion = string.IsNullOrWhiteSpace(d.Descripcion) ? concepto : d.Descripcion.Trim(),
                        Debito = d.Debe,
                        Credito = d.Haber
                    });
                }

                // F4: retenciones catalogadas en paralelo a las lineas (mismo dato, no altera la partida).
                // El backend escribe el registro fiscal hdr/dtl y valida Σ Monto == Σ credito de estas cuentas.
                foreach (var d in deducciones)
                {
                    if (d.Tipo != DeduccionTipo.Retencion || d.RetencionId is not { } retId)
                        continue;

                    dto.Retenciones.Add(new RetencionAplicadaDto
                    {
                        RetencionId = retId,
                        CuentaId = d.CuentaId ?? 0,
                        Base = d.Base,
                        Porcentaje = d.Porcentaje ?? 0m,
                        Monto = d.Monto
                    });
                }
            }
            else
            {
                // Abono simple (sin retencion): identico al comportamiento actual (camino contra-magnitud).
                dto.CuentaContraId = cuentaOrigen.AccountId;
                dto.BancoCuentaId = cuentaOrigen.BancoCuentaId;
            }

            var result = await OrdenesPagoDirectoClient.RegistrarAbonoAsync(NumeroOrden, dto);
            if (!result.Success)
            {
                ShowToast("Abonar compromiso", result.Message, ToastRenderStyle.Danger);
                return;
            }

            ShowToast("Exito", result.Message, ToastRenderStyle.Success);

            if (result.ChequeId is > 0)
            {
                // Abono con cheque: ofrecer comprobante de abono / cheque / cheque + detalle.
                chequeIdEmitido = result.ChequeId.Value;
                documentoImpresionUrl = result.NumeroAbono > 0
                    ? OrdenesPagoDirectoClient.GetComprobanteAbonoUrl(NumeroOrden, result.NumeroAbono)
                    : null;
                impresionDialogVisible = true;
            }
            else
            {
                if (result.NumeroAbono > 0)
                {
                    pdfPopup?.Mostrar(
                        OrdenesPagoDirectoClient.GetComprobanteAbonoUrl(NumeroOrden, result.NumeroAbono),
                        $"Comprobante de abono {result.NumeroAbono}");
                }

                await CargarAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar abono del compromiso {NumeroOrden}", NumeroOrden);
            errorNotice.ShowError("No se pudo registrar el abono.", ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OnImpresionDialogVisibleChanged(bool value)
    {
        impresionDialogVisible = value;
        if (!value)
        {
            // Al cerrar el dialogo de impresion, recargar el estado del compromiso.
            await CargarAsync();
