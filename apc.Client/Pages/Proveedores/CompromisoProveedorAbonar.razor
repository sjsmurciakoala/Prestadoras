    /// <summary>
    /// Abre el detalle contable (lineas debito/credito) de la partida ABO que genero el abono.
    /// El abono guarda partida_id; las lineas se leen de la API de partidas.
    /// </summary>
    private async Task VerPartidaAsync(AbonoCompromisoListItemDto item)
    {
        if (item.PartidaId is not > 0)
        {
            return;
        }

        partidaAbonoNumero = item.NumeroAbono;
        partidaSeleccionada = null;
        partidaError = null;
        partidaLoading = true;
        partidaPopupVisible = true;

        try
        {
            partidaSeleccionada = await PolizasClient.ObtenerAsync(item.PartidaId.Value);
            if (partidaSeleccionada is null)
            {
                partidaError = "No se encontro la partida contable del abono.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            partidaError = "No tiene permisos para consultar el detalle contable.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la partida {PartidaId} del abono {NumeroAbono} del compromiso {NumeroOrden}",
                item.PartidaId, item.NumeroAbono, NumeroOrden);
            partidaError = "No se pudo cargar el detalle contable del abono.";
        }
        finally
        {
            partidaLoading = false;
        }
    }

    private bool Validar()
    {
        if (saldo is null)
        {
            validationMessages.Add("No se cargo el saldo del compromiso.");
            return false;
        }

        if (!TieneCuentaProveedorDisponible)
        {
            validationMessages.Add("El proveedor no tiene una cuenta contable valida configurada.");
        }

        if (nuevoMonto <= 0m)
        {
            validationMessages.Add("El monto del abono debe ser mayor a cero.");
        }
        else if (nuevoMonto > saldo.Saldo)
        {
            validationMessages.Add($"El monto no puede superar el saldo pendiente ({saldo.Saldo:N2}).");
        }

        if (string.IsNullOrWhiteSpace(bancoSeleccionadoNombre))
        {
            validationMessages.Add("Debe seleccionar el banco de origen.");
        }
        else if (CuentaOrigenSeleccionada is null)
        {
            validationMessages.Add("Debe seleccionar la cuenta de origen del banco.");
        }

        if (string.IsNullOrWhiteSpace(nuevoMetodo))
        {
            validationMessages.Add("Debe seleccionar el metodo de pago.");
        }

        for (var i = 0; i < deducciones.Count; i++)
        {
            var deduccion = deducciones[i];
            if (!deduccion.CuentaId.HasValue || deduccion.CuentaId.Value <= 0)
            {
                validationMessages.Add($"La retencion/deduccion de la fila {i + 1} debe tener una cuenta contable seleccionada.");
            }
            else if (deduccion.Monto <= 0m)
            {
                validationMessages.Add($"La retencion/deduccion de la fila {i + 1} debe tener un monto mayor a cero.");
            }
        }

        if (deducciones.Count > 0 && NetoBanco <= 0m)
        {
            validationMessages.Add("El neto a pagar por banco debe ser mayor a cero. Revise las retenciones y deducciones cargadas.");
        }

        return validationMessages.Count == 0;
    }

    private void Volver()
    {
        var returnUrl = NormalizeLocalUrl(ReturnUrl) ?? "/proveedores/compromisos-proveedor";
        Navigation.NavigateTo(returnUrl, true);
    }

    private static bool EsVigente(AbonoCompromisoListItemDto item)
        => string.Equals(item.Estado, "V", StringComparison.OrdinalIgnoreCase);

    private string BuildProveedorResumenTexto()
    {
        var correlativo = detalle?.CorrelativoProveedor?.ToString() ?? "-";
        var proveedor = GetTextOrDash(detalle?.Proveedor);
        if (correlativo == "-")
        {
            return proveedor;
        }
        return proveedor == "-" ? correlativo : $"{correlativo} - {proveedor}";
    }

    private void ShowToast(string title, string message, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions
        {
            Title = title,
            Text = message,
            RenderStyle = style,
            ProviderName = "CompromisoProveedorAbonarToast"
        });
    }

    private static string GetTextOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private string FormatCuentaOrDash(string? cuenta)
    {
        var formatted = AccountFormat.Format(cuenta);
        return string.IsNullOrWhiteSpace(formatted) ? "-" : formatted;
    }

    private static string? NormalizeLocalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        var normalized = url.Trim();
        return !normalized.StartsWith("/", StringComparison.Ordinal) || normalized.StartsWith("//", StringComparison.Ordinal)
            ? null
            : normalized;
    }

    private async Task CargarRetencionesAplicablesAsync()
    {
        retencionesAplicables.Clear();
        tasaIsvGeneral = null;
        try
        {
            var fecha = detalle?.FechaCompromiso is { } f
                ? DateOnly.FromDateTime(f)
                : DateOnly.FromDateTime(DateTime.Today);
            var aplicables = await OrdenesPagoDirectoClient.GetRetencionesAplicablesAsync(fecha);
            retencionesAplicables.AddRange(aplicables.Retenciones);
            tasaIsvGeneral = aplicables.TasaIsvGeneral;
        }
        catch (Exception ex)
        {
            // No es fatal: el popup sigue permitiendo la linea manual (cuenta + monto a mano).
            Logger.LogWarning(ex, "No se pudieron cargar las retenciones aplicables del compromiso {NumeroOrden}", NumeroOrden);
        }
    }

    private void AbrirPopupDeducciones()
    {
        // Clonamos el estado aplicado a un borrador; asi Cancelar/Escape descartan sin afectar la partida.
        deduccionesDraft.Clear();
        deduccionesDraft.AddRange(deducciones.Select(d => d.Clone()));
        LimpiarEditor();
        popupDeduccionesVisible = true;
    }

    private void LimpiarEditor()
    {
        editorIndex = null;
        editorCuentaId = null;
        editorDescripcion = string.Empty;
        editorTipo = DeduccionTipo.Retencion;
        editorMonto = 0m;
        editorError = null;
        editorRetencionId = null;
        editorBase = 0m;
        editorRetencionAviso = null;
    }

    // Cambiar de modo. Cargo = manual (sin catalogo): se limpia el tipo de retencion y su aviso.
    private void SetEditorTipo(DeduccionTipo tipo)
    {
        editorTipo = tipo;
        if (tipo == DeduccionTipo.Cargo)
        {
            editorRetencionId = null;
            editorRetencionAviso = null;
        }
    }

    // Al elegir un tipo de retencion: fija cuenta (o avisa), propone base (editable) y monto (si hay tasa),
    // y arma la descripcion. NUNCA inventa % — sin tasa vigente avisa y deja el monto en manos del usuario.
    private void OnRetencionTipoChanged(int? retencionId)
    {
        editorRetencionId = retencionId;
        editorError = null;
        editorRetencionAviso = null;

        if (retencionId is null)
        {
            return; // volvio a "sin tipo": linea manual, no se pisa lo ya escrito
        }

        var ret = retencionesAplicables.FirstOrDefault(r => r.RetencionId == retencionId.Value);
        if (ret is null)
        {
            return;
        }

        var avisos = new List<string>();

        // 1) Cuenta desde prv_retencion_cuenta. Si la empresa no la configuro, avisar y NO autocompletar.
        if (ret.CuentaConfigurada && ret.CuentaAccountId is { } accId)
        {
            editorCuentaId = accId;
        }
        else
        {
            editorCuentaId = null;
            avisos.Add("La empresa no tiene una cuenta configurada para esta retencion: seleccionela abajo o configurela en el mantenimiento de retenciones.");
        }

        // 2) Base segun base_calculo (editable). El bruto del abono es el monto capturado.
        var calculo = RetencionCalculator.Calcular(Bruto, ret.BaseCalculo, ret.Porcentaje, tasaIsvGeneral);
        editorBase = calculo.Base;

        if (RetencionCalculator.RequiereTasaIsvYNoHay(ret.BaseCalculo, tasaIsvGeneral))
        {
            avisos.Add("No se encontro una tasa de ISV vigente: la base no se redujo (quedo igual al bruto). Revise el monto o ajuste la base a mano.");
        }

        // 3) Monto: solo si hay tasa vigente. Sin tasa (p. ej. ISV-RET) se captura a mano.
        if (calculo.PuedeCalcularMonto)
        {
            editorMonto = calculo.Monto;
        }
        else
        {
            editorMonto = 0m;
            avisos.Add("Esta retencion no tiene una tasa vigente (pendiente de confirmar con la SAR): capture el monto a mano; no se puede autocalcular.");
        }

        // 4) Descripcion: nombre + % (o solo nombre si no hay tasa).
        editorDescripcion = ret.Porcentaje is { } pct
            ? $"{ret.Nombre} ({pct:0.##}%)"
            : ret.Nombre;

        editorRetencionAviso = avisos.Count > 0 ? string.Join(" ", avisos) : null;
    }

    // Al editar la base a mano, el monto sigue a la base cuando hay un tipo con tasa seleccionado.
    private void OnEditorBaseChanged(decimal value)
    {
        editorBase = value < 0m ? 0m : value;

        var ret = editorRetencionId is { } id
            ? retencionesAplicables.FirstOrDefault(r => r.RetencionId == id)
            : null;

        if (ret?.Porcentaje is not null)
        {
            editorMonto = RetencionCalculator.MontoDesdeBase(editorBase, ret.Porcentaje);
        }
    }

    private void GuardarLineaEditor()
    {
        editorError = null;

        if (!editorCuentaId.HasValue || editorCuentaId.Value <= 0)
        {
            editorError = "Seleccione la cuenta contable de la linea.";
            return;
        }

        if (editorMonto <= 0m)
        {
            editorError = "Ingrese un monto mayor a cero.";
            return;
        }

        // Solo las retenciones tomadas del catalogo CON tasa vigente guardan el vinculo (%, base): asi
        // pueden RECALCULARSE si cambia el bruto del abono. Cargos, retenciones sin tasa (monto manual) y
        // lineas manuales quedan con su monto fijo.
        var retCatalogo = editorTipo == DeduccionTipo.Retencion && editorRetencionId is { } id
            ? retencionesAplicables.FirstOrDefault(r => r.RetencionId == id)
            : null;

        var linea = new DeduccionLinea
        {
            CuentaId = editorCuentaId,
            Descripcion = editorDescripcion?.Trim() ?? string.Empty,
            Tipo = editorTipo,
            Monto = editorMonto,
            RetencionId = retCatalogo?.RetencionId,
            Porcentaje = retCatalogo?.Porcentaje,
            BaseCalculo = retCatalogo?.BaseCalculo,
            Base = editorTipo == DeduccionTipo.Retencion ? editorBase : 0m,
        };

        if (editorIndex is int idx && idx >= 0 && idx < deduccionesDraft.Count)
        {
            deduccionesDraft[idx] = linea;
        }
        else
        {
            deduccionesDraft.Add(linea);
        }

        LimpiarEditor();
    }

    private void EditarLineaDraft(int idx)
    {
        if (idx < 0 || idx >= deduccionesDraft.Count)
        {
            return;
        }

        var d = deduccionesDraft[idx];
        editorIndex = idx;
        editorCuentaId = d.CuentaId;
        editorDescripcion = d.Descripcion;
        editorTipo = d.Tipo;
        editorMonto = d.Monto;
        editorError = null;
        // F4: al editar se restaura el vinculo al catalogo (retencion_id/base) para no perder la
        // trazabilidad estructurada; si se re-elige un tipo, GuardarLineaEditor lo vuelve a estampar.
        editorRetencionId = d.RetencionId;
        editorBase = d.Base;
        editorRetencionAviso = null;
    }

    private void QuitarLineaDraft(int idx)
    {
        if (idx < 0 || idx >= deduccionesDraft.Count)
        {
            return;
        }

        deduccionesDraft.RemoveAt(idx);

        // Mantener coherente el indice en edicion si quitamos otra fila.
        if (editorIndex is int e)
        {
            if (e == idx)
            {
                LimpiarEditor();
            }
            else if (idx < e)
            {
                editorIndex = e - 1;
            }
        }
    }

    private void AplicarDeducciones()
    {
        deducciones.Clear();
        deducciones.AddRange(deduccionesDraft.Select(d => d.Clone()));
        popupDeduccionesVisible = false;
    }

    private void CancelarPopupDeducciones()
    {
        popupDeduccionesVisible = false;
    }

