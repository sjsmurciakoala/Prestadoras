@using SIAD.Core.DTOs.Proveedores

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" Context="editContext">
    <DataAnnotationsValidator />

    <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
        <DxFormLayoutGroup Caption="Datos del tipo" ColSpanXs="12">
            <DxFormLayoutItem Caption="Nombre *" ColSpanXs="12">
                <DxTextBox @bind-Text="Model.Nombre" MaxLength="60" />
                <ValidationMessage For="() => Model.Nombre" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Observaciones" ColSpanXs="12">
                <DxMemo @bind-Text="Model.Observaciones" Rows="4" MaxLength="250" ResizeMode="MemoResizeMode.Vertical" />
                <ValidationMessage For="() => Model.Observaciones" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Activo" ColSpanXs="12" ColSpanMd="4">
                @* Mismo interruptor que el "Activo" del formulario de proveedor. Un tipo inactivo
                   sale de los combos pero conserva los contactos que ya lo tienen asignado. *@
                <label class="toggle-switch">
                    <input type="checkbox" @bind="Model.Activo" disabled="@IsBusy" />
                    <span class="toggle-slider"></span>
                </label>
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </DxFormLayout>

    <DxValidationSummary CssClass="mb-3" />

    <div class="d-flex justify-content-end">
        <DxButton SubmitFormOnClick="true"
                  RenderStyle="ButtonRenderStyle.Primary"
                  Text="Guardar"
                  Enabled="@(!IsBusy)" />
        <DxButton ButtonType="ButtonType.Normal"
                  CssClass="ms-2"
                  Text="Cancelar"
                  Enabled="@(!IsBusy)"
                  Click="CancelarAsync" />
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public TipoContactoUpsertDto Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private async Task HandleValidSubmit()
    {
        if (OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }

    private async Task CancelarAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
