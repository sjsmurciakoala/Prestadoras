@page "/parametros/usuarios"
@attribute [Authorize(Policy = SIAD.Core.Constants.AuthorizationPolicies.SuperAdmin)]

@using DevExpress.Blazor
@using SIAD.Core.DTOs.Usuarios
@using apc.Client.Services.Parametros
@inject UsuariosPortalClient UsuariosClient
@inject NavigationManager NavigationManager
@inject IToastNotificationService ToastService
@inject IJSRuntime JS

<PageTitle>SIAD - Usuarios</PageTitle>

<h3>Usuarios del Portal</h3>
<p class="text-muted">Administra los usuarios, roles y permisos del sistema.</p>

<div class="d-flex gap-2 mb-3 mt-3">
    <DxButton Text="Nuevo Usuario"
              RenderStyle="ButtonRenderStyle.Primary"
              IconCssClass="bi bi-person-plus"
              Click="@(() => NavigationManager.NavigateTo("/parametros/usuarios/nuevo"))" />

    <DxButton Text="Sincronizar Roles"
              RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              IconCssClass="bi bi-arrow-repeat"
              Enabled="@(!isSyncing)"
              Click="SincronizarRolesAsync" />
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-4">
        <DxWaitIndicator Visible="true" />
    </div>
}
else
{
    <DxGrid Data="@usuarios"
            KeyFieldName="Id"
            ShowFilterRow="true"
            PageSize="20"
            CssClass="mt-2">
        <Columns>
            <DxGridDataColumn FieldName="Email" Caption="Correo" Width="300px" />
            <DxGridDataColumn FieldName="EmailConfirmado" Caption="Confirmado" Width="110px">
                <CellDisplayTemplate>
                    @{
                        var confirmado = (bool)context.Value;
                    }
                    <span class="badge @(confirmado ? "bg-success" : "bg-warning text-dark")">
                        @(confirmado ? "Sí" : "No")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="Bloqueado" Caption="Bloqueado" Width="110px">
                <CellDisplayTemplate>
                    @{
                        var bloqueado = (bool)context.Value;
                    }
                    <span class="badge @(bloqueado ? "bg-danger" : "bg-success")">
                        @(bloqueado ? "Sí" : "No")
                    </span>
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="CompanyId" Caption="Empresa ID" Width="110px" />
            <DxGridDataColumn FieldName="RolesDisplay" Caption="Roles" UnboundType="GridUnboundColumnType.String"
                              AllowSort="false" AllowGroup="false">
                <CellDisplayTemplate>
                    @{
                        var usuario = (UsuarioPortalDto)context.DataItem;
                    }
                    @if (usuario.Roles is { Count: > 0 })
                    {
                        @foreach (var role in usuario.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Sin roles</span>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="Id" Caption="Acciones" Width="150px" AllowSort="false" AllowGroup="false">
                <CellDisplayTemplate>
                    @{
                        var fila = (UsuarioPortalDto)context.DataItem;
                    }
                    <div class="d-flex gap-1">
                        <DxButton RenderStyle="ButtonRenderStyle.Link"
                                  IconCssClass="bi bi-pencil"
                                  Attributes="@(new Dictionary<string, object> { ["title"] = "Editar" })"
                                  Click="@(() => NavigationManager.NavigateTo($"/parametros/usuarios/editar/{fila.Id}"))" />
                        <DxButton RenderStyle="ButtonRenderStyle.Link"
                                  IconCssClass="bi bi-key"
                                  Attributes="@(new Dictionary<string, object> { ["title"] = "Restablecer contraseña" })"
                                  Click="@(() => AbrirRestablecer(fila))" />
                        <DxButton RenderStyle="ButtonRenderStyle.Link"
                                  CssClass="text-danger"
                                  IconCssClass="bi bi-trash"
                                  Attributes="@(new Dictionary<string, object> { ["title"] = "Eliminar" })"
                                  Click="@(() => AbrirEliminar(fila))" />
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </DxGrid>
}


<DxPopup @bind-Visible="restablecerVisible" Width="min(460px, 92vw)" HeaderText="Restablecer contraseña" ShowFooter="false">
    <BodyTemplate>
        <div class="p-3">
            <p class="mb-2">
                Se asignará una contraseña nueva a <strong>@(usuarioSeleccionado?.Email)</strong>.
            </p>
            <p class="text-muted small mb-3">
                Sus sesiones abiertas se cerrarán y deberá entrar con la contraseña nueva.
                Si estaba bloqueado por intentos fallidos, se desbloquea.
            </p>

            <label class="form-label mb-1">Contraseña</label>
            <DxTextBox @bind-Text="passwordManual"
                       Password="true"
                       NullText="Dejar vacío para generarla automáticamente"
                       CssClass="w-100" />
            <div class="form-text mt-1">
                Si la escribes tú, debe tener al menos 6 caracteres con mayúscula, minúscula,
                número y símbolo.
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <DxButton Text="Cancelar"
                          Click="CancelarRestablecer"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isResetting)" />
                <DxButton Text="Restablecer"
                          Click="RestablecerConfirmadoAsync"
                          RenderStyle="ButtonRenderStyle.Primary"
                          IconCssClass="bi bi-key"
                          Enabled="@(!isResetting)" />
            </div>
        </div>
    </BodyTemplate>
</DxPopup>

<DxPopup @bind-Visible="resultadoVisible" Width="min(480px, 92vw)" HeaderText="Contraseña restablecida" ShowFooter="false">
    <BodyTemplate>
        <div class="p-3">
            <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    Cópiala ahora: <strong>no se puede volver a consultar</strong>.
                    El sistema solo guarda su huella cifrada.
                </div>
            </div>

            <div class="mb-2 text-muted small">Usuario</div>
            <div class="mb-3 fw-semibold">@(resultado?.Email)</div>

            <div class="mb-2 text-muted small">Contraseña temporal</div>
            <div class="d-flex align-items-center gap-2">
                <code class="flex-grow-1 p-2 bg-light border rounded user-select-all fs-5">@(resultado?.Password)</code>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          IconCssClass="bi bi-clipboard"
                          Text="@TextoBotonCopiar"
                          Click="CopiarPasswordAsync" />
            </div>

            <div class="d-flex justify-content-end mt-4">
                <DxButton Text="Listo"
                          Click="CerrarResultado"
                          RenderStyle="ButtonRenderStyle.Primary" />
            </div>
        </div>
    </BodyTemplate>
</DxPopup>

<DxPopup @bind-Visible="eliminarVisible" Width="min(440px, 90vw)" HeaderText="Confirmar acción" ShowFooter="false">
    <BodyTemplate>
        <div class="text-center p-4">
            <div class="mb-3 text-danger"><i class="bi bi-trash-fill" style="font-size: 3rem;"></i></div>
            <h5 class="fw-bold">¿Eliminar el usuario?</h5>
            <p class="text-muted mb-2">
                Esta acción <strong>no se puede deshacer</strong>. Si solo quieres impedirle el acceso,
                edítalo y márcalo como bloqueado.
            </p>
            <div class="fw-semibold">@(usuarioSeleccionado?.Email)</div>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <DxButton Text="Cancelar"
                          Click="CancelarEliminar"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isDeleting)" />
                <DxButton Text="Sí, eliminar"
                          Click="EliminarConfirmadoAsync"
                          RenderStyle="ButtonRenderStyle.Danger"
                          IconCssClass="bi bi-trash"
                          Enabled="@(!isDeleting)" />
            </div>
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    private List<UsuarioPortalDto> usuarios = [];
    private bool isLoading = true;
    private bool isSyncing;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        isLoading = true;

        try
        {
            usuarios = await UsuariosClient.ListarAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/Account/Login");
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowToast(new ToastOptions { Title = "Usuarios", Text = ex.Message, RenderStyle = ToastRenderStyle.Danger });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SincronizarRolesAsync()
    {
        isSyncing = true;

        try
        {
            await UsuariosClient.SincronizarRolesAsync();
            ToastService.ShowToast(new ToastOptions { Title = "Usuarios", Text = "Roles sincronizados correctamente.", RenderStyle = ToastRenderStyle.Success });
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowToast(new ToastOptions { Title = "Usuarios", Text = ex.Message, RenderStyle = ToastRenderStyle.Danger });
        }
        finally
        {
            isSyncing = false;
        }
    }

    // --- Restablecer contraseña ---

    private UsuarioPortalDto? usuarioSeleccionado;
    private bool restablecerVisible;
    private bool resultadoVisible;
    private bool isResetting;
    private string? passwordManual;
    private RestablecerPasswordResultadoDto? resultado;
    private bool copiada;

    private string TextoBotonCopiar => copiada ? "Copiada" : "Copiar";

    private void AbrirRestablecer(UsuarioPortalDto usuario)
    {
        usuarioSeleccionado = usuario;
        passwordManual = null;
        restablecerVisible = true;
    }

    private void CancelarRestablecer()
    {
        restablecerVisible = false;
        passwordManual = null;
    }

    private void CerrarResultado()
    {
        resultadoVisible = false;
        // La contraseña no se conserva en memoria más allá del popup.
        resultado = null;
    }

    private async Task RestablecerConfirmadoAsync()
    {
        if (usuarioSeleccionado is null)
        {
            return;
        }

        isResetting = true;

        try
        {
            resultado = await UsuariosClient.RestablecerPasswordAsync(
                usuarioSeleccionado.Id,
                string.IsNullOrWhiteSpace(passwordManual) ? null : passwordManual);

            copiada = false;
            passwordManual = null;
            restablecerVisible = false;
            resultadoVisible = true;

            // El restablecimiento desbloquea al usuario: la grilla debe reflejarlo.
            await CargarUsuariosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/Account/Login");
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowToast(new ToastOptions { Title = "Restablecer contraseña", Text = ex.Message, RenderStyle = ToastRenderStyle.Danger });
        }
        finally
        {
            isResetting = false;
        }
    }

    private async Task CopiarPasswordAsync()
    {
        if (resultado is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", resultado.Password);
            copiada = true;
        }
        catch (JSException)
        {
            // Sin permiso de portapapeles (o sitio servido por HTTP sin TLS): la contraseña
            // sigue visible y seleccionable en pantalla, no hace falta molestar con un error.
        }
    }

    // --- Eliminar ---

    private bool eliminarVisible;
    private bool isDeleting;

    private void AbrirEliminar(UsuarioPortalDto usuario)
    {
        usuarioSeleccionado = usuario;
        eliminarVisible = true;
    }

    private void CancelarEliminar() => eliminarVisible = false;

    private async Task EliminarConfirmadoAsync()
    {
        if (usuarioSeleccionado is null)
        {
            return;
        }

        isDeleting = true;

        try
        {
            await UsuariosClient.EliminarAsync(usuarioSeleccionado.Id);
            eliminarVisible = false;
            ToastService.ShowToast(new ToastOptions { Title = "Usuarios", Text = "Usuario eliminado correctamente.", RenderStyle = ToastRenderStyle.Success });
            await CargarUsuariosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/Account/Login");
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowToast(new ToastOptions { Title = "Usuarios", Text = ex.Message, RenderStyle = ToastRenderStyle.Danger });
        }
        finally
        {
            isDeleting = false;
        }
    }
}
