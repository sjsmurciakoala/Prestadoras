@page "/mapa"
@attribute [Authorize]
@implements IDisposable

@using System.Globalization
@using apc.Client.Services.Maps
@using apc.Client.Services.Ordenes
@using apc.Services
@using SIAD.Core.DTOs.Maps
@using SIAD.Core.DTOs.Ordenes

@inject MapClient MapClient
@inject OrdenesClient OrdenesClient
@inject IToastNotificationService ToastService
@inject NavigationManager Navigation

<PageTitle>SIAD - Mapa</PageTitle>

<div class="page-container">
    <DxToastProvider Name="@ToastProviderName" MaxToastCount="4" StickToViewport="true" />

    <div class="header-section">
        <div>
            <h2 class="page-title">Mapa</h2>
            <p class="page-subtitle">Ubicación de las cuadrillas reportada por la app Mi Trabajo</p>
        </div>
        <div class="header-actions">
            @if (ultimaActualizacion is not null)
            {
                <span class="last-update">Actualizado @ultimaActualizacion.Value.ToString("HH:mm:ss")</span>
            }
            <DxButton Text="Actualizar"
                      IconCssClass="bi bi-arrow-clockwise"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      CssClass="btn-modern btn-reset"
                      Click="RefrescarCoordenadasAsync"
                      Enabled="@(!isRefreshing)" />
        </div>
    </div>

    <div class="modern-card mb-4">
        <div class="search-toolbar">
            <DxTextBox Text="@searchText"
                       TextChanged="@((string value) => searchText = value)"
                       Placeholder="Buscar dirección o coordenadas"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                       InputDelay="0"
                       CssClass="map-search-box" />

            <DxButton Text="Buscar"
                      IconCssClass="bi bi-search"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="btn-modern"
                      Click="BuscarAsync"
                      Enabled="@(!isLoading && !string.IsNullOrWhiteSpace(searchText) && CanRenderMap)" />

            <DxButton Text="Restablecer"
                      IconCssClass="bi bi-arrow-counterclockwise"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      CssClass="btn-modern btn-reset"
                      Click="RestablecerMapa"
                      Enabled="@(!isLoading && mapConfiguration is not null)" />
        </div>

        <div class="crew-toolbar">
            <DxCheckBox @bind-Checked="@mostrarCuadrillas"
                        LabelPosition="LabelPosition.Right">
                Mostrar cuadrillas (@CuadrillasVisibles.Count de @cuadrillas.Count)
            </DxCheckBox>

            @* Binding en dos vías: con Value/ValueChanged por separado el combo puede
               emitir 0 al inicializarse y dejar el filtro en "sin limite" sin que el
               usuario lo haya elegido. *@
            <DxComboBox Data="@VigenciaOpciones"
                        @bind-Value="@vigenciaHoras"
                        TextFieldName="@nameof(VigenciaOpcion.Texto)"
                        ValueFieldName="@nameof(VigenciaOpcion.Horas)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                        CssClass="crew-filter"
                        Enabled="@mostrarCuadrillas" />
        </div>

        <div class="search-help">
            Formatos válidos: <strong>14.0723,-87.1921</strong> o una dirección como
            <strong>Tegucigalpa, Honduras</strong>.
        </div>
    </div>

    <div class="modern-card">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <DxLoadingPanel Visible="true" Text="Cargando mapa..." />
                <div style="height: 120px;"></div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="alert alert-danger" role="alert">@loadError</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(coordenadasError))
            {
                <div class="alert alert-warning" role="alert">@coordenadasError</div>
            }
            else if (mostrarCuadrillas && CuadrillasVisibles.Count == 0)
            {
                <div class="alert alert-info" role="alert">
                    No hay cuadrillas con ubicación reportada @(vigenciaHoras > 0 ? $"en las últimas {vigenciaHoras} horas" : string.Empty).
                </div>
            }

            <div class="map-layout">
                @if (mostrarCuadrillas && CuadrillasVisibles.Count > 0)
                {
                    <aside class="crew-panel">
                        <div class="crew-panel-title">Cuadrillas en el mapa</div>
                        @foreach (var cuadrilla in CuadrillasVisibles.OrderByDescending(c => c.Fecha))
                        {
                            var seguida = seguirUsuario == cuadrilla.Usuario;
                            <button type="button"
                                    class="@($"crew-item {(seguida ? "crew-item-active" : string.Empty)}")"
                                    @onclick="@(() => AlternarSeguimiento(cuadrilla))">
                                <span class="@($"crew-dot crew-dot-{EstadoSenal(cuadrilla.Fecha)}")"></span>
                                <span class="crew-info">
                                    <span class="crew-name">@(string.IsNullOrWhiteSpace(cuadrilla.Nombre) ? cuadrilla.Usuario : cuadrilla.Nombre)</span>
                                    <span class="crew-meta">@DescribirAntiguedad(cuadrilla.Fecha)</span>
                                </span>
                                @if (seguida)
                                {
                                    <i class="bi bi-crosshair crew-follow-icon" title="Siguiendo"></i>
                                }
                            </button>
                        }
                        <div class="crew-panel-help">
                            Haz clic en una cuadrilla para seguirla; el mapa se centrará en ella cada @((int)RefreshInterval.TotalSeconds) s.
                        </div>
                    </aside>
                }

                @* Clic en un marcador de cuadrilla → tarjeta con acción directa
                   (dxdocs: DxMap.MarkerClick + IMapMarker.MarkerId). *@
                @if (cuadrillaSeleccionada is not null)
                {
                    <div class="alert alert-info d-flex flex-wrap align-items-center gap-3 mb-2" role="alert">
                        <i class="bi bi-person-badge fs-4"></i>
                        <div class="flex-grow-1">
                            <strong>@(string.IsNullOrWhiteSpace(cuadrillaSeleccionada.Nombre) ? cuadrillaSeleccionada.Usuario : cuadrillaSeleccionada.Nombre)</strong>
                            <span class="text-muted ms-2">(@cuadrillaSeleccionada.Usuario) · última señal @DescribirAntiguedad(cuadrillaSeleccionada.Fecha)</span>
                        </div>
                        <DxButton Text="Crear orden de trabajo"
                                  IconCssClass="bi bi-clipboard-plus"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@(() => Navigation.NavigateTo($"/ordenes?crearPara={Uri.EscapeDataString(cuadrillaSeleccionada.Usuario)}"))" />
                        <button type="button" class="btn-close" aria-label="Cerrar"
                                @onclick="() => cuadrillaSeleccionada = null"></button>
                    </div>
                }

                <div class="map-shell">
                <DxMap Provider="@currentProvider"
                       GoogleMapId="@GoogleMapId"
                       Type="MapType.Roadmap"
                       Width="100%"
                       Height="560px"
                       Zoom="@currentZoom"
                       ControlsVisible="true"
                       AutoAdjust="@shouldAutoAdjust"
                       MarkerClick="OnMarkerClick"
                       CssClass="map-canvas">
                    <DxMapApiKeys Azure="@AzureKey" Google="@GoogleKey" />
                    <DxMapCenter GeoPosition="@currentCenterGeoPosition" />
                    <DxMapMarkers>
                        @if (!string.IsNullOrWhiteSpace(searchMarkerGeoPosition))
                        {
                            <DxMapMarker MarkerId="busqueda">
                                <DxMapMarkerLocation GeoPosition="@searchMarkerGeoPosition" />
                                <DxMapMarkerTooltip Text="@searchMarkerTooltip" />
                            </DxMapMarker>
                        }

                        @if (mostrarCuadrillas)
                        {
                            @foreach (var cuadrilla in CuadrillasVisibles)
                            {
                                <DxMapMarker @key="cuadrilla.Usuario" MarkerId="@("cuadrilla:" + cuadrilla.Usuario)">
                                    <DxMapMarkerLocation GeoPosition="@BuildGeoPosition(cuadrilla.Latitud!.Value, cuadrilla.Longitud!.Value)" />
                                    <DxMapMarkerTooltip Text="@BuildCuadrillaTooltip(cuadrilla)" />
                                </DxMapMarker>
                            }
                        }
                    </DxMapMarkers>
                </DxMap>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const string ToastProviderName = "MapaToast";
    private const decimal FallbackLatitude = 14.0723m;
    private const decimal FallbackLongitude = -87.1921m;
    private const int FallbackZoom = 13;

    /// <summary>
    /// La app movil reporta cada 30s; refrescando cada 15s la posicion en pantalla
    /// nunca queda con mas de ~45s de atraso.
    /// </summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(15);

    /// <summary>Antiguedad a partir de la cual dejamos de considerar el telefono "en linea".</summary>
    private static readonly TimeSpan UmbralEnLinea = TimeSpan.FromMinutes(5);
    private static readonly TimeSpan UmbralReciente = TimeSpan.FromMinutes(30);
    private const int ZoomSeguimiento = 17;

    private MapBootstrapDto? mapConfiguration;
    private MapProvider currentProvider = MapProvider.Azure;
    private string searchText = string.Empty;
    private string currentCenterGeoPosition = BuildGeoPosition(FallbackLatitude, FallbackLongitude);
    private string? searchMarkerGeoPosition;
    private string searchMarkerTooltip = "Resultado de búsqueda";
    private string? loadError;
    private string? coordenadasError;
    private bool isLoading = true;
    private bool isRefreshing;
    private int currentZoom = FallbackZoom;

    private IReadOnlyList<CoordenadaOrdenDto> cuadrillas = Array.Empty<CoordenadaOrdenDto>();
    private CoordenadaOrdenDto? cuadrillaSeleccionada;

    // dxdocs: DxMap.MarkerClick entrega IMapMarker.MarkerId del marcador clicado.
    private void OnMarkerClick(MapMarkerClickEventArgs e)
    {
        const string prefijo = "cuadrilla:";
        var id = e.Marker?.MarkerId;
        if (id is not null && id.StartsWith(prefijo, StringComparison.Ordinal))
        {
            var usuario = id[prefijo.Length..];
            cuadrillaSeleccionada = cuadrillas.FirstOrDefault(c => c.Usuario == usuario);
            StateHasChanged();
        }
    }
    private bool mostrarCuadrillas = true;
    private int vigenciaHoras = 24;
    private DateTime? ultimaActualizacion;
    private CancellationTokenSource? refreshCts;
    private string? seguirUsuario;

    private sealed record VigenciaOpcion(int Horas, string Texto);

    private static readonly VigenciaOpcion[] VigenciaOpciones =
    [
        new(1, "Última hora"),
        new(8, "Últimas 8 horas"),
        new(24, "Últimas 24 horas"),
        new(72, "Últimos 3 días"),
        new(0, "Sin límite")
    ];

    private string AzureKey =>
        currentProvider == MapProvider.Azure ? (mapConfiguration?.ApiKey ?? string.Empty) : string.Empty;

    private string GoogleKey =>
        currentProvider == MapProvider.Google ? (mapConfiguration?.ApiKey ?? string.Empty) : string.Empty;

    // DevExpress 25.2 usa Advanced Markers de Google → requieren Map ID.
    private string GoogleMapId =>
        currentProvider == MapProvider.Google ? (mapConfiguration?.GoogleMapId ?? string.Empty) : string.Empty;

    private bool CanRenderMap =>
        mapConfiguration is not null && !string.IsNullOrWhiteSpace(mapConfiguration.ApiKey);

    // Solo dejamos que el mapa se auto-encuadre cuando mostramos cuadrillas y el usuario
    // no ha fijado el centro por su cuenta (busqueda manual o seguimiento de un telefono).
    private bool shouldAutoAdjust =>
        string.IsNullOrWhiteSpace(searchMarkerGeoPosition)
        && string.IsNullOrWhiteSpace(seguirUsuario)
        && mostrarCuadrillas
        && CuadrillasVisibles.Count > 0;

    private List<CoordenadaOrdenDto> CuadrillasVisibles =>
        cuadrillas
            .Where(c => c.Latitud is not null && c.Longitud is not null)
            .Where(c => vigenciaHoras <= 0
                        || (c.Fecha is not null && c.Fecha.Value >= DateTime.Now.AddHours(-vigenciaHoras)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadMapConfigurationAsync();

        if (CanRenderMap)
        {
            await CargarCoordenadasAsync();
            IniciarAutoRefresco();
        }
    }

    private async Task LoadMapConfigurationAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            mapConfiguration = await MapClient.GetConfigurationAsync();

            if (mapConfiguration is null)
            {
                loadError = "No se encontró configuración para el mapa.";
                return;
            }

            if (!TryParseProvider(mapConfiguration.Provider, out currentProvider))
            {
                loadError = $"El proveedor configurado '{mapConfiguration.Provider}' no es compatible. Use 'Azure' o 'Google'.";
                return;
            }

            if (string.IsNullOrWhiteSpace(mapConfiguration.ApiKey))
            {
                loadError = $"La clave de {mapConfiguration.Provider} Maps no está configurada.";
                return;
            }

            currentCenterGeoPosition = BuildGeoPosition(mapConfiguration.DefaultLatitude, mapConfiguration.DefaultLongitude);
            currentZoom = mapConfiguration.DefaultZoom > 0 ? mapConfiguration.DefaultZoom : FallbackZoom;
            searchMarkerGeoPosition = null;
        }
        catch (Exception ex)
        {
            loadError = $"No fue posible cargar la configuración del mapa: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CargarCoordenadasAsync()
    {
        try
        {
            cuadrillas = await OrdenesClient.GetCoordenadasAsync();
            coordenadasError = null;
            ultimaActualizacion = DateTime.Now;
            RecentrarEnSeguimiento();
        }
        catch (Exception ex)
        {
            coordenadasError = $"No fue posible cargar la ubicación de las cuadrillas: {ex.Message}";
        }
    }

    /// <summary>
    /// Si el usuario eligió seguir un teléfono, movemos el centro del mapa con él en
    /// cada refresco para que no tenga que ir arrastrando el mapa a mano.
    /// </summary>
    private void RecentrarEnSeguimiento()
    {
        if (string.IsNullOrWhiteSpace(seguirUsuario))
        {
            return;
        }

        var objetivo = cuadrillas.FirstOrDefault(c =>
            c.Usuario == seguirUsuario && c.Latitud is not null && c.Longitud is not null);

        if (objetivo is null)
        {
            return;
        }

        currentCenterGeoPosition = BuildGeoPosition(objetivo.Latitud!.Value, objetivo.Longitud!.Value);
        currentZoom = ZoomSeguimiento;
    }

    private void AlternarSeguimiento(CoordenadaOrdenDto cuadrilla)
    {
        seguirUsuario = seguirUsuario == cuadrilla.Usuario ? null : cuadrilla.Usuario;

        if (seguirUsuario is null)
        {
            RestablecerMapa();
            return;
        }

        // Seguir un teléfono y mantener un marcador de búsqueda manual se pelean por el
        // centro del mapa, así que limpiamos la búsqueda al activar el seguimiento.
        searchMarkerGeoPosition = null;
        RecentrarEnSeguimiento();
    }

    private static string DescribirAntiguedad(DateTime? fecha)
    {
        if (fecha is null)
        {
            return "sin fecha";
        }

        var transcurrido = DateTime.Now - fecha.Value;

        if (transcurrido < TimeSpan.Zero)
        {
            return "ahora";
        }

        if (transcurrido < TimeSpan.FromMinutes(1))
        {
            return "hace segundos";
        }

        if (transcurrido < TimeSpan.FromHours(1))
        {
            return $"hace {(int)transcurrido.TotalMinutes} min";
        }

        if (transcurrido < TimeSpan.FromDays(1))
        {
            return $"hace {(int)transcurrido.TotalHours} h";
        }

        return fecha.Value.ToString("dd/MM/yyyy HH:mm");
    }

    private static string EstadoSenal(DateTime? fecha)
    {
        if (fecha is null)
        {
            return "offline";
        }

        var transcurrido = DateTime.Now - fecha.Value;

        if (transcurrido <= UmbralEnLinea)
        {
            return "online";
        }

        return transcurrido <= UmbralReciente ? "reciente" : "offline";
    }

    private async Task RefrescarCoordenadasAsync()
    {
        if (isRefreshing || !CanRenderMap)
        {
            return;
        }

        isRefreshing = true;
        try
        {
            await CargarCoordenadasAsync();
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private void IniciarAutoRefresco()
    {
        refreshCts = new CancellationTokenSource();
        var token = refreshCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(RefreshInterval);
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        await RefrescarCoordenadasAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Salida esperada al abandonar la pagina.
            }
        }, token);
    }

    private Task BuscarAsync()
    {
        if (!CanRenderMap)
        {
            ShowToast("Mapa", "El mapa no está listo para recibir búsquedas.", ToastRenderStyle.Warning);
            return Task.CompletedTask;
        }

        var query = searchText?.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            ShowToast("Mapa", "Escribe una dirección o coordenadas antes de buscar.", ToastRenderStyle.Warning);
            return Task.CompletedTask;
        }

        if (TryParseCoordinates(query, out var latitude, out var longitude))
        {
            var geoPosition = BuildGeoPosition(latitude, longitude);
            ApplySearchResult(geoPosition, $"Resultado de búsqueda: {latitude:F5}, {longitude:F5}");
            return Task.CompletedTask;
        }

        if (LooksLikeCoordinateInput(query))
        {
            ShowToast("Mapa", "Las coordenadas no tienen un formato válido. Usa el formato latitud,longitud.", ToastRenderStyle.Warning);
            return Task.CompletedTask;
        }

        ApplySearchResult(query, $"Resultado de búsqueda: {query}");
        return Task.CompletedTask;
    }

    private void RestablecerMapa()
    {
        if (mapConfiguration is null)
        {
            return;
        }

        searchText = string.Empty;
        searchMarkerGeoPosition = null;
        searchMarkerTooltip = "Resultado de búsqueda";
        currentCenterGeoPosition = BuildGeoPosition(mapConfiguration.DefaultLatitude, mapConfiguration.DefaultLongitude);
        currentZoom = mapConfiguration.DefaultZoom > 0 ? mapConfiguration.DefaultZoom : FallbackZoom;
    }

    private void ApplySearchResult(string geoPosition, string tooltip)
    {
        searchMarkerGeoPosition = geoPosition;
        searchMarkerTooltip = tooltip;
        currentCenterGeoPosition = geoPosition;
        currentZoom = Math.Max(mapConfiguration?.DefaultZoom ?? FallbackZoom, 15);
    }

    private void ShowToast(string title, string message, ToastRenderStyle style)
    {
        ToastService.ShowToast(new ToastOptions
        {
            Title = title,
            Text = message,
            RenderStyle = style,
            ProviderName = ToastProviderName
        });
    }

    private static string BuildCuadrillaTooltip(CoordenadaOrdenDto cuadrilla)
    {
        var nombre = string.IsNullOrWhiteSpace(cuadrilla.Nombre) ? cuadrilla.Usuario : cuadrilla.Nombre;
        var partes = new List<string> { nombre };

        if (!string.IsNullOrWhiteSpace(cuadrilla.DescripcionTipo))
        {
            partes.Add(cuadrilla.DescripcionTipo);
        }

        partes.Add(DescribirAntiguedad(cuadrilla.Fecha));

        return string.Join(" · ", partes);
    }

    private static bool TryParseProvider(string? value, out MapProvider provider)
    {
        provider = MapProvider.Azure;

        if (string.Equals(value, "Azure", StringComparison.OrdinalIgnoreCase))
        {
            provider = MapProvider.Azure;
            return true;
        }

        if (string.Equals(value, "Google", StringComparison.OrdinalIgnoreCase))
        {
            provider = MapProvider.Google;
            return true;
        }

        return false;
    }

    private static bool TryParseCoordinates(string value, out decimal latitude, out decimal longitude)
    {
        latitude = 0;
        longitude = 0;

        var parts = value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2)
        {
            return false;
        }

        if (!decimal.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out latitude) ||
            !decimal.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out longitude))
        {
            return false;
        }

        return latitude is >= -90 and <= 90 && longitude is >= -180 and <= 180;
    }

    private static bool LooksLikeCoordinateInput(string value)
        => value.Contains(',') && value.All(ch => char.IsDigit(ch) || ch is '.' or ',' or '-' or '+' or ' ');

    private static string BuildGeoPosition(decimal latitude, decimal longitude)
        => string.Format(CultureInfo.InvariantCulture, "{0:0.#####}, {1:0.#####}", latitude, longitude);

    public void Dispose()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
    }
}
