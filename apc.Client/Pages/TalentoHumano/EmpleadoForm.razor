@using DevExpress.Blazor
@using SIAD.Core.DTOs.TalentoHumano

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" Context="EditFormContext">
    <DataAnnotationsValidator />

    @if (EditFormContext.GetValidationMessages().Any())
    {
        <div class="alert alert-danger mb-3 shadow-sm">
            <h6 class="alert-heading"><i class="bi bi-exclamation-circle-fill me-2"></i>Atención</h6>
            <ValidationSummary />
        </div>
    }

    <DxFormLayout>
        <DxFormLayoutItem Caption="Código" ColSpanMd="6">
            <Template>
                <div class="form-control-plaintext">
                    @if (string.IsNullOrWhiteSpace(Model.Codigo))
                    {
                        <span class="text-muted fst-italic">Se generará automáticamente</span>
                    }
                    else
                    {
                        <span class="fw-semibold">@Model.Codigo</span>
                    }
                </div>
            </Template>
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Código SIMAFI" ColSpanMd="6">
            <Template>
                <div class="form-control-plaintext">
                    @if (string.IsNullOrWhiteSpace(Model.CodigoSimafi))
                    {
                        <span class="text-muted fst-italic">Solo desde importación</span>
                    }
                    else
                    {
                        <span class="fw-semibold">@Model.CodigoSimafi</span>
                    }
                </div>
            </Template>
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Nombre completo *" ColSpanMd="12">
            <DxTextBox @bind-Text="Model.Nombre" NullText="Nombre del empleado" MaxLength="120" />
            <ValidationMessage For="() => Model.Nombre" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Identidad" ColSpanMd="6">
            <DxTextBox @bind-Text="Model.Identidad" NullText="Ej. 0801-1990-12345" MaxLength="20" />
            <ValidationMessage For="() => Model.Identidad" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Cargo" ColSpanMd="6">
            <DxComboBox Data="@Cargos" TData="CatalogoThLookupDto" TValue="int?"
                        @bind-Value="Model.CargoId"
                        ValueFieldName="@nameof(CatalogoThLookupDto.Id)" TextFieldName="@nameof(CatalogoThLookupDto.Nombre)"
                        NullText="Sin asignar" FilteringMode="DataGridFilteringMode.Contains"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="w-100" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Departamento" ColSpanMd="6">
            <DxComboBox Data="@Departamentos" TData="CatalogoThLookupDto" TValue="int?"
                        @bind-Value="Model.DepartamentoId"
                        ValueFieldName="@nameof(CatalogoThLookupDto.Id)" TextFieldName="@nameof(CatalogoThLookupDto.Nombre)"
                        NullText="Sin asignar" FilteringMode="DataGridFilteringMode.Contains"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="w-100" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="Activo" ColSpanMd="6">
            <Template>
                <div class="pt-2">
                    <DxCheckBox @bind-Checked="Model.Activo" CheckType="CheckType.Switch" LabelText="Activo" />
                </div>
            </Template>
        </DxFormLayoutItem>
    </DxFormLayout>

    <ValidationSummary class="text-danger mb-3" />

    <div class="d-flex justify-content-end gap-2">
        <DxButton ButtonType="ButtonType.Submit" RenderStyle="ButtonRenderStyle.Primary"
                  Text="Guardar" SubmitFormOnClick="true" Enabled="@(!IsBusy)" />
        <DxButton ButtonType="ButtonType.Normal" Text="Cancelar" Enabled="@(!IsBusy)" Click="Cancel" />
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public EmpleadoEditDto Model { get; set; } = default!;
    [Parameter] public List<CatalogoThLookupDto> Cargos { get; set; } = new();
    [Parameter] public List<CatalogoThLookupDto> Departamentos { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsBusy { get; set; }

    private async Task HandleValidSubmit() { if (OnValidSubmit.HasDelegate) await OnValidSubmit.InvokeAsync(); }
    private async Task Cancel() { if (OnCancel.HasDelegate) await OnCancel.InvokeAsync(); }
}
