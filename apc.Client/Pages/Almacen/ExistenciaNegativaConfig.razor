@page "/almacen/existencia-negativa"
@attribute [Authorize]

@using DevExpress.Blazor
@using SIAD.Core.DTOs.Almacen
@using apc.Client.Services
@using apc.Client.Services.Almacen

@inject NegativoInventarioConfigClient Client
@inject IToastNotificationService ToastService

<PageTitle>SIAD - Existencia negativa en salidas</PageTitle>

<div class="page-container">
    <DxToastProvider Name="ExistenciaNegativaToast" MaxToastCount="4" StickToViewport="true" />

    <div class="header-section">
        <div>
            <h2 class="page-title">Existencia negativa en salidas</h2>
            <p class="page-subtitle">Permite registrar entregas aunque el sistema marque 0, para reflejar el físico y reconciliar después</p>
        </div>
    </div>

    <div class="modern-card position-relative" style="max-width: 760px;">
        <DxLoadingPanel Visible="isLoading" IsContentBlocked="true" Text="Cargando..." />
        <div class="p-3">
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Interruptor de <strong>toda la empresa</strong>. Con esto <strong>apagado</strong> (lo normal),
                el sistema bloquea cualquier salida que dejaría la existencia en negativo. Actívalo solo si el
                almacén entrega material que físicamente tiene aunque el sistema marque 0 — habrá que
                <strong>reconciliar</strong> después. Cada bodega puede afinar esto en su propia ficha
                (heredar, permitir o bloquear).
            </div>

            <div class="form-check form-switch p-3 border rounded mb-3 @(model.Permitir ? "border-warning bg-light" : "")">
                <input class="form-check-input" type="checkbox" role="switch" id="permitir-negativo"
                       checked="@model.Permitir"
                       @onchange="@(e => model.Permitir = (bool)(e.Value ?? false))" />
                <label class="form-check-label w-100 ps-2" for="permitir-negativo" style="cursor:pointer;">
                    <span class="fw-bold">Permitir existencia negativa en salidas</span>
                    <div class="text-muted small">
                        Cuando está activo, una salida (descargo, movimiento, ajuste o traslado) puede dejar la
                        existencia por debajo de 0. El costo promedio no se corrompe: la próxima entrada
                        re-establece el costo. Al cruzar a negativo se envía un aviso de stock.
                    </div>
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <DxButton Text="Guardar" IconCssClass="bi bi-check-lg" RenderStyle="ButtonRenderStyle.Primary"
                          Click="GuardarAsync" Enabled="@(!isSaving && !isLoading)" />
            </div>
        </div>
    </div>
</div>

@code {
    private NegativoInventarioConfigDto model = new();
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model = await Client.ObtenerAsync();
        }
        catch (Exception ex)
        {
            Toast("Error", $"No se pudo cargar la configuración: {ex.Message}", ToastRenderStyle.Danger);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarAsync()
    {
        isSaving = true;
        try
        {
            model = await Client.GuardarAsync(model);
            Toast("Éxito", "Configuración guardada.", ToastRenderStyle.Success);
        }
        catch (Exception ex)
        {
            Toast("Error", ex.Message, ToastRenderStyle.Danger);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Toast(string title, string text, ToastRenderStyle style)
        => ToastService.ShowToast(new ToastOptions
        {
            Title = title,
            Text = text,
            RenderStyle = style,
            ProviderName = "ExistenciaNegativaToast"
        });
}
