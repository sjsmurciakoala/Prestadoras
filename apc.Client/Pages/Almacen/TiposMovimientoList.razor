@page "/almacen/conceptos-movimiento"
@attribute [Authorize]

@using DevExpress.Blazor
@using SIAD.Core.DTOs.Almacen
@using SIAD.Core.DTOs.Contabilidad
@using apc.Client.Services
@using apc.Client.Services.Almacen

@inject TiposMovimientoClient TiposMovClient
@inject IToastNotificationService ToastService
@inject IJSRuntime JS

<PageTitle>SIAD - Conceptos de movimiento</PageTitle>

<div class="page-container">
    <DxToastProvider Name="TiposMovToast" MaxToastCount="4" StickToViewport="true" />

    <div class="header-section">
        <div>
            <h2 class="page-title">Conceptos de movimiento</h2>
            <p class="page-subtitle">Motivos de entrada y salida de almacén. Cada concepto se comporta según su tipo (entrada, salida o corrección de valor), sin necesidad de cambiar el sistema</p>
        </div>
        <DxButton Text="Nuevo concepto" IconCssClass="bi bi-plus-lg" RenderStyle="ButtonRenderStyle.Primary"
                  CssClass="btn-modern" Click="AbrirNuevo" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-3" role="alert">@errorMessage</div>
    }

    <div class="modern-card position-relative">
        <DxLoadingPanel Visible="isLoading" IsContentBlocked="true" Text="Cargando..." />
        <div class="grid-wrapper">
            <DxGrid @ref="grid" Data="@tiposFiltrados" KeyFieldName="@nameof(TipoMovimientoAlmacenListItemDto.Id)" PageSize="15"
                    PageSizeSelectorVisible="true"
                    PageSizeSelectorItems="new int[] { 5, 10, 15, 25, 50, 100 }"
                    PagerPosition="GridPagerPosition.Bottom" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    ShowGroupPanel="false" CssClass="grid-solicitudes"
                    LayoutAutoSaving="OnLayoutAutoSaving"
                    LayoutAutoLoading="OnLayoutAutoLoading">
                <ToolbarTemplate>
                    <div class="d-flex flex-wrap gap-2 align-items-center w-100">
                        <DxTextBox Text="@filtroBusqueda" TextChanged="@((string v) => OnBusquedaChanged(v))"
                                   TextExpression="@(() => filtroBusqueda)" Placeholder="Buscar código o nombre..."
                                   InputDelay="600" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   CssClass="me-1" Style="min-width: 240px;" />
                        <div class="d-flex align-items-center me-2">
                            <DxCheckBox Checked="@soloActivos" CheckedChanged="@((bool v) => OnSoloActivosChanged(v))"
                                        CheckType="CheckType.Switch">Solo activos</DxCheckBox>
                        </div>
                        <DxButton Text="Recargar" IconCssClass="bi bi-arrow-clockwise"
                                  RenderStyle="ButtonRenderStyle.Secondary" Click="CargarAsync" CssClass="me-1" />
                        <DxButton Text="Columnas" IconCssClass="bi bi-layout-three-columns"
                                  RenderStyle="ButtonRenderStyle.Secondary" Click="MostrarColumnChooser" CssClass="me-1" />
                        <div class="ms-auto text-muted small">Total: <span class="fw-bold">@tiposFiltrados.Count.ToString("N0")</span></div>
                    </div>
                </ToolbarTemplate>
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(TipoMovimientoAlmacenListItemDto.Codigo)" Caption="Código" Width="150px">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            { <span class="text-dark fw-semibold">@item.Codigo</span> }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(TipoMovimientoAlmacenListItemDto.Nombre)" Caption="Nombre" MinWidth="200" />
                    <DxGridDataColumn FieldName="@nameof(TipoMovimientoAlmacenListItemDto.Clase)" Caption="Tipo" Width="150px" TextAlignment="GridTextAlignment.Center">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            {
                                <span class="badge @ClaseBadgeClass(item.Clase)" title="@ClaseTooltip(item.Clase)">@ClaseTexto(item.Clase)</span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(TipoMovimientoAlmacenListItemDto.RequiereAutorizacion)" Caption="Autorización" Width="140px" TextAlignment="GridTextAlignment.Center">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            {
                                @if (item.RequiereAutorizacion)
                                { <span class="badge bg-warning text-dark" title="Usar este tipo exige un permiso adicional">Requiere</span> }
                                else
                                { <span class="text-muted">—</span> }
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(TipoMovimientoAlmacenListItemDto.EnUso)" Caption="En uso" Width="110px" TextAlignment="GridTextAlignment.Center" Visible="false">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            {
                                @if (item.EnUso)
                                { <span class="badge bg-light text-dark border" title="Ya tiene movimientos posteados: su clase no se puede cambiar">Sí</span> }
                                else
                                { <span class="text-muted">—</span> }
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Estado" Width="110px" TextAlignment="GridTextAlignment.Center">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            { <span class="badge-status @(item.Activo ? "active" : "inactive")">@(item.Activo ? "ACTIVO" : "INACTIVO")</span> }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Acciones" Width="130px" TextAlignment="GridTextAlignment.Center">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is TipoMovimientoAlmacenListItemDto item)
                            {
                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <button type="button" class="btn-icon btn-edit" title="Editar"
                                            @onclick="() => AbrirEditarAsync(item)" @onclick:stopPropagation="true">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn-icon btn-delete" title="Desactivar"
                                            disabled="@(!item.Activo)"
                                            @onclick="() => ConfirmarDesactivar(item)" @onclick:stopPropagation="true">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                </div>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
                <EmptyDataAreaTemplate><div class="p-4 text-center text-muted">No hay tipos de movimiento para mostrar.</div></EmptyDataAreaTemplate>
            </DxGrid>
        </div>
    </div>
</div>

<DxPopup @bind-Visible="formVisible" Width="min(680px, 95vw)" Height="auto" MaxHeight="90vh"
         Scrollable="true" CssClass="custom-popup" CloseOnOutsideClick="false">
    <HeaderContentTemplate>
        <div class="d-flex align-items-center gap-2">
            <div class="@PopupIconWrapperClass" style="width: 38px; height: 38px;"><i class="@PopupIcon"></i></div>
            <div>
                <div class="fw-bold fs-6 text-dark" style="line-height:1.1;">@PopupTitle</div>
                <div class="small text-muted" style="font-weight: normal; font-size: 0.8rem;">@PopupSubtitle</div>
            </div>
        </div>
    </HeaderContentTemplate>
    <BodyContentTemplate>
        @if (formLoading)
        {
            <div class="text-center p-4"><DxLoadingPanel Visible="true" Text="Cargando..." /><div style="height:80px"></div></div>
        }
        else if (!string.IsNullOrWhiteSpace(formError))
        {
            <div class="p-3"><div class="alert alert-danger" role="alert">@formError</div></div>
        }
        else
        {
            <TipoMovimientoForm Model="formModel" CuentasContables="cuentasContables" ClaseBloqueada="formClaseBloqueada"
                                OnValidSubmit="GuardarAsync" OnCancel="CerrarForm" IsBusy="isSaving" />
        }
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="confirmVisible" Width="min(420px, 90vw)" HeaderText="Confirmar acción" ShowFooter="false">
    <BodyTemplate>
        <div class="text-center p-4">
            <div class="mb-3 text-warning"><i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i></div>
            <h5 class="fw-bold">¿Desactivar concepto de movimiento?</h5>
            <p class="text-muted">No se podrá capturar con él, pero los movimientos ya registrados lo seguirán mostrando.</p>
            @if (paraDesactivar is not null) { <div class="fw-semibold">@paraDesactivar.Codigo - @paraDesactivar.Nombre</div> }
            <div class="d-flex justify-content-center gap-3 mt-4">
                <DxButton Text="Cancelar" Click="CancelarDesactivar" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" />
                <DxButton Text="Sí, desactivar" Click="DesactivarConfirmadoAsync" RenderStyle="ButtonRenderStyle.Danger" IconCssClass="bi bi-slash-circle" />
            </div>
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    private const string GridLayoutStorageKey = "almacen-conceptos-movimiento-grid-layout";

    private DxGrid? grid;
    private List<TipoMovimientoAlmacenListItemDto> tipos = new();
    private List<TipoMovimientoAlmacenListItemDto> tiposFiltrados = new();
    private List<CuentaContableLookupDto> cuentasContables = new();

    private void MostrarColumnChooser() => grid?.ShowColumnChooser();

    private Task OnLayoutAutoSaving(GridPersistentLayoutEventArgs e)
        => GridLayoutStorage.SaveAsync(JS, GridLayoutStorageKey, e);

    private Task OnLayoutAutoLoading(GridPersistentLayoutEventArgs e)
        => GridLayoutStorage.LoadAsync(JS, GridLayoutStorageKey, e);

    private string filtroBusqueda = string.Empty;
    private bool soloActivos = true;
    private bool isLoading;
    private string? errorMessage;

    private bool formVisible, formLoading, isSaving, formClaseBloqueada;
    private string? formError;
    private TipoMovimientoAlmacenDto formModel = new();

    private bool confirmVisible;
    private TipoMovimientoAlmacenListItemDto? paraDesactivar;

    private string PopupTitle => formModel.Id.HasValue ? "Editar concepto de movimiento" : "Nuevo concepto de movimiento";
    private string PopupSubtitle => formModel.Id.HasValue ? "Actualice el concepto de movimiento" : "Registre un motivo de entrada o salida";
    private string PopupIcon => formModel.Id.HasValue ? "bi bi-pencil-square" : "bi bi-arrow-left-right";
    private string PopupIconWrapperClass => formModel.Id.HasValue
        ? "bg-warning bg-opacity-10 text-warning p-2 rounded-circle d-flex justify-content-center align-items-center"
        : "bg-primary bg-opacity-10 text-primary p-2 rounded-circle d-flex justify-content-center align-items-center";

    protected override async Task OnInitializedAsync()
    {
        await CargarCuentasAsync();
        await CargarAsync();
    }

    private async Task CargarCuentasAsync()
    {
        try { cuentasContables = await TiposMovClient.GetCuentasContablesAsync(); }
        catch { cuentasContables = new(); }
    }

    private async Task CargarAsync()
    {
        try
        {
            isLoading = true; errorMessage = null;
            tipos = await TiposMovClient.GetAsync(soloActivos);
            AplicarFiltroLocal();
        }
        catch (Exception ex) { errorMessage = $"No se pudieron cargar los tipos de movimiento: {ex.Message}"; }
        finally { isLoading = false; }
    }

    /// <summary>
    /// La búsqueda se resuelve en el cliente: el endpoint sólo filtra por activos y el catálogo
    /// es de decenas de filas, no de miles. Si algún día crece, se mueve al servidor.
    /// </summary>
    private void AplicarFiltroLocal()
    {
        var q = filtroBusqueda?.Trim();
        tiposFiltrados = string.IsNullOrWhiteSpace(q)
            ? tipos
            : tipos.Where(t =>
                    t.Codigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || t.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void OnBusquedaChanged(string v) { filtroBusqueda = v; AplicarFiltroLocal(); }
    private async Task OnSoloActivosChanged(bool v) { soloActivos = v; await CargarAsync(); }

    private void AbrirNuevo()
    {
        formError = null;
        formClaseBloqueada = false;
        formModel = new TipoMovimientoAlmacenDto();
        formVisible = true;
    }

    private async Task AbrirEditarAsync(TipoMovimientoAlmacenListItemDto item)
    {
        formError = null; formLoading = true; formVisible = true;
        formClaseBloqueada = item.EnUso;
        try
        {
            var d = await TiposMovClient.GetByIdAsync(item.Id);
            if (d is null) { formError = "No se encontró el concepto de movimiento."; formModel = new(); return; }
            formModel = d;
        }
        catch (Exception ex) { formError = $"Error al cargar: {ex.Message}"; }
        finally { formLoading = false; }
    }

    private void CerrarForm()
    {
        if (isSaving) return;
        formVisible = false; formError = null; formModel = new(); formClaseBloqueada = false;
    }

    private async Task GuardarAsync()
    {
        isSaving = true;
        try
        {
            if (formModel.Id.HasValue)
            {
                await TiposMovClient.UpdateAsync(formModel.Id.Value, formModel);
                Toast("Éxito", "Concepto de movimiento actualizado.", ToastRenderStyle.Success);
            }
            else
            {
                await TiposMovClient.CreateAsync(formModel);
                Toast("Éxito", "Concepto de movimiento registrado.", ToastRenderStyle.Success);
            }
            formVisible = false; formModel = new(); formClaseBloqueada = false;
            await CargarAsync();
        }
        catch (Exception ex) { Toast("Error", ex.Message, ToastRenderStyle.Danger); }
        finally { isSaving = false; }
    }

    private void ConfirmarDesactivar(TipoMovimientoAlmacenListItemDto t) { paraDesactivar = t; confirmVisible = true; }
    private void CancelarDesactivar() { confirmVisible = false; paraDesactivar = null; }

    private async Task DesactivarConfirmadoAsync()
    {
        if (paraDesactivar is null) { confirmVisible = false; return; }
        try
        {
            var ok = await TiposMovClient.DeactivateAsync(paraDesactivar.Id);
            if (!ok) Toast("Error", "No se pudo desactivar.", ToastRenderStyle.Danger);
            else { Toast("Éxito", "Concepto de movimiento desactivado.", ToastRenderStyle.Success); await CargarAsync(); }
        }
        catch (Exception ex) { Toast("Error", ex.Message, ToastRenderStyle.Danger); }
        finally { confirmVisible = false; paraDesactivar = null; }
    }

    private static string ClaseTexto(string clase) => clase switch
    {
        "ENTRADA" => "Entrada",
        "SALIDA" => "Salida",
        "VALOR" => "Corrección de valor",
        _ => clase
    };

    private static string ClaseBadgeClass(string clase) => clase switch
    {
        "ENTRADA" => "bg-success-subtle text-success-emphasis border border-success-subtle",
        "SALIDA" => "bg-danger-subtle text-danger-emphasis border border-danger-subtle",
        "VALOR" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _ => "bg-light text-dark border"
    };

    private static string ClaseTooltip(string clase) => clase switch
    {
        "ENTRADA" => "Suma existencia y recalcula el costo promedio",
        "SALIDA" => "Resta existencia al costo promedio vigente, sin moverlo",
        "VALOR" => "Corrige sólo el costo; no mueve unidades",
        _ => clase
    };

    private void Toast(string title, string text, ToastRenderStyle style)
        => ToastService.ShowToast(new ToastOptions { Title = title, Text = text, RenderStyle = style, ProviderName = "TiposMovToast" });
}
