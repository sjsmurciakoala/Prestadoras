@page "/almacen/kardex"
@attribute [Authorize(Policy = PermissionNames.Inventario.View)]

@using DevExpress.Blazor
@using SIAD.Core.DTOs.Almacen
@using apc.Client.Services
@using apc.Client.Services.Almacen

@inject ArticulosClient ArticulosClient
@inject KardexClient KardexClient
@inject BodegasClient BodegasClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>SIAD - Estado de cuenta de artículos</PageTitle>

<div class="page-container">
    <div class="header-section">
        <div>
            <h2 class="page-title">Estado de cuenta de artículos</h2>
            <p class="page-subtitle">Histórico de entradas, salidas y saldo corrido</p>
        </div>
    </div>

    <div class="modern-card mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div style="min-width: 320px; flex: 1 1 320px;">
                <label class="filter-label">Artículo</label>
                <DxComboBox Data="@articulos"
                            Value="@articuloSeleccionado"
                            ValueChanged="@((ArticuloListItemDto? a) => OnArticuloChanged(a))"
                            TextFieldName="@nameof(ArticuloListItemDto.Descripcion)"
                            FilteringMode="DataGridFilteringMode.Contains"
                            NullText="Seleccione o busque un artículo..."
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            CssClass="w-100">
                    <ItemTemplate Context="art">
                        <div class="d-flex flex-column">
                            <span class="fw-semibold">#@art.Id — @art.Descripcion</span>
                            <span class="text-muted small">@(string.IsNullOrWhiteSpace(art.Codigo) ? "—" : art.Codigo) · Existencia: @art.Existencia.ToString("N2") @art.UnidadMedida</span>
                        </div>
                    </ItemTemplate>
                </DxComboBox>
            </div>

            <div style="min-width: 150px;">
                <label class="filter-label">Desde</label>
                <DxDateEdit @bind-Date="fechaDesde" NullText="Todas" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="w-100" />
            </div>

            <div style="min-width: 150px;">
                <label class="filter-label">Hasta</label>
                <DxDateEdit @bind-Date="fechaHasta" NullText="Todas" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="w-100" />
            </div>

            <div style="min-width: 160px;">
                <label class="filter-label">Tipo de movimiento</label>
                <DxComboBox Data="@tipos" Value="@tipoSeleccionado"
                            ValueChanged="@((TipoMovimientoDto? t) => OnTipoChanged(t))"
                            TextFieldName="@nameof(TipoMovimientoDto.Descripcion)"
                            NullText="Todos"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            CssClass="w-100" />
            </div>

            <div style="min-width: 180px;">
                <label class="filter-label">Bodega</label>
                <DxComboBox Data="@bodegas" Value="@bodegaSeleccionada"
                            ValueChanged="@((BodegaLookupDto? b) => OnBodegaChanged(b))"
                            TextFieldName="@nameof(BodegaLookupDto.Display)"
                            NullText="Todas"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            CssClass="w-100" />
            </div>

            <div>
                <DxButton Text="Consultar" IconCssClass="bi bi-search"
                          RenderStyle="ButtonRenderStyle.Primary" Click="ConsultarAsync"
                          Enabled="@(articuloSeleccionado is not null)" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mb-3" role="alert">@errorMessage</div>
    }

    @if (kardex is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card">
                    <div class="summary-label" title="@ExistenciaTooltip">@ExistenciaLabel</div>
                    <div class="summary-value">@ExistenciaTexto</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card @(kardex.SaldoDescuadrado ? "summary-warning" : "")">
                    <div class="summary-label">@(HayBodegaFiltrada ? "Saldo calculado (bodega)" : "Saldo calculado (kardex)")</div>
                    <div class="summary-value">@kardex.SaldoCalculado.ToString("N2")@UnidadSufijo()</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card">
                    <div class="summary-label">Ingresos (período)</div>
                    <div class="summary-value">@kardex.TotalIngresos.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card">
                    <div class="summary-label">Salidas (período)</div>
                    <div class="summary-value">@kardex.TotalSalidas.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card">
                    <div class="summary-label" title="Valor del inventario al cierre del kardex: suma de (entradas − salidas) × costo de cada movimiento.">
                        Saldo valorizado
                    </div>
                    <div class="summary-value">@kardex.SaldoValorizado.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="modern-card summary-card @(kardex.CostoDescuadrado ? "summary-warning" : "")">
                    <div class="summary-label" title="Costo promedio derivado del libro: saldo valorizado ÷ saldo. Es la misma regla con la que el motor valoriza las salidas.">
                        Costo prom. (kardex)
                    </div>
                    <div class="summary-value">
                        @(kardex.CostoPromedioActual.HasValue ? kardex.CostoPromedioActual.Value.ToString("N4") : "—")
                    </div>
                </div>
            </div>
        </div>

        @if (string.IsNullOrWhiteSpace(kardex.UnidadMedida))
        {
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>Unidad de medida no asignada
            </div>
        }

        @if (kardex.SaldoDescuadrado)
        {
            <div class="alert alert-warning mb-3" role="alert">
                @if (HayBodegaFiltrada)
                {
                    <text>
                        El saldo del kardex de @BodegaTexto (@kardex.SaldoCalculado.ToString("N2")) no coincide con la
                        existencia registrada de esa bodega (@(kardex.ExistenciaBodega!.Value.ToString("N2"))).
                    </text>
                }
                else
                {
                    <text>
                        El saldo calculado del kardex (@kardex.SaldoCalculado.ToString("N2")) no coincide con la
                        existencia registrada en el catálogo (@kardex.ExistenciaRegistrada.ToString("N2")).
                    </text>
                }
            </div>
        }

        @* El costo del libro contra el almacenado en la ficha de existencias: es el que usan el
           catálogo y el motor para valorizar salidas, así que una diferencia real importa. *@
        @if (kardex.CostoDescuadrado)
        {
            <div class="alert alert-warning mb-3" role="alert">
                El costo promedio que arroja el kardex (@kardex.CostoPromedioActual!.Value.ToString("N4")) no coincide
                con el costo promedio registrado@(HayBodegaFiltrada ? $" en {BodegaTexto}" : "")
                (@kardex.CostoPromedioCache!.Value.ToString("N4")).
            </div>
        }
        else if (kardex.CostoSinRegistrar)
        {
            @* Pendiente de costeo, no corrupción: el libro sí tiene con qué valorizar. *@
            <div class="alert alert-info mb-3" role="alert">
                El kardex valoriza este artículo a @kardex.CostoPromedioActual!.Value.ToString("N4"), pero su ficha de
                existencias@(HayBodegaFiltrada ? $" en {BodegaTexto}" : "") no tiene costo registrado: mientras siga así
                se reporta con valor de inventario cero y no puede despacharse.
            </div>
        }

        @* Arrastre del período: sin esto la primera fila aparece con un saldo que nada explica. *@
        @if (kardex.TieneArrastre)
        {
            <div class="modern-card mb-3 py-2">
                <div class="d-flex flex-wrap align-items-center gap-4">
                    <span class="fw-bold text-muted">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Saldo anterior
                    </span>
                    <span>
                        <span class="text-muted small">Cantidad:</span>
                        <span class="fw-semibold ms-1">@kardex.CantidadAnterior!.Value.ToString("N2")@UnidadSufijo()</span>
                    </span>
                    <span>
                        <span class="text-muted small">Valor:</span>
                        <span class="fw-semibold ms-1">@kardex.ValorAnterior!.Value.ToString("N2")</span>
                    </span>
                    <span>
                        <span class="text-muted small">Costo prom.:</span>
                        <span class="fw-semibold ms-1">
                            @(kardex.CostoPromedioAnterior.HasValue ? kardex.CostoPromedioAnterior.Value.ToString("N4") : "—")
                        </span>
                    </span>
                    <span class="text-muted small ms-auto">Acumulado antes del inicio del período</span>
                </div>
            </div>
        }

        <div class="modern-card position-relative">
            <DxLoadingPanel Visible="isLoading" IsContentBlocked="true" Text="Cargando..." />

            <div class="grid-wrapper">
                <DxGrid @ref="grid" Data="@kardex.Movimientos" KeyFieldName="@nameof(KardexMovimientoDto.Id)" PageSize="15"
                        PageSizeSelectorVisible="true"
                        PageSizeSelectorItems="new int[] { 5, 10, 15, 25, 50, 100 }"
                        PagerPosition="GridPagerPosition.Bottom" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        ShowGroupPanel="false" CssClass="grid-solicitudes"
                        LayoutAutoSaving="OnLayoutAutoSaving"
                        LayoutAutoLoading="OnLayoutAutoLoading">

                    <ToolbarTemplate>
                        <div class="d-flex flex-wrap gap-2 align-items-center w-100">
                            <span class="fw-bold">@kardex.Codigo — @kardex.Descripcion</span>
                            <DxButton Text="Ver PDF" IconCssClass="bi bi-file-earmark-pdf"
                                      RenderStyle="ButtonRenderStyle.Secondary" Click="MostrarPdf" CssClass="ms-auto me-1" />
                            <DxButton Text="Columnas" IconCssClass="bi bi-layout-three-columns"
                                      RenderStyle="ButtonRenderStyle.Secondary" Click="MostrarColumnChooser" CssClass="me-1" />
                            <DxButton Text="Excel" IconCssClass="bi bi-file-earmark-excel"
                                      RenderStyle="ButtonRenderStyle.Secondary" Click="ExportExcelAsync" CssClass="me-3" />

                            <div class="text-muted small">
                                Total: <span class="fw-bold">@kardex.Movimientos.Count.ToString("N0")</span>
                            </div>
                        </div>
                    </ToolbarTemplate>

                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.Fecha)" Caption="Fecha" Width="105px">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    <span>@(m.Fecha.HasValue ? m.Fecha.Value.ToString("dd/MM/yyyy") : "—")</span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        @* Descripción con el concepto concatenado al frente ("Compra · a proveedor X").
                           Absorbe las columnas Tipo y Documento que se quitaron; la carga inicial
                           conserva su marca porque desde ahí corre el saldo. *@
                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.DescripcionCompleta)" Caption="Descripción" MinWidth="260">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    @if (m.EsLineaDeCorte)
                                    {
                                        <span class="badge-mov mov-corte me-1" title="Saldo inicial: desde aquí corre el saldo">CARGA INICIAL</span>
                                        <span title="@m.DescripcionCompleta">@(string.IsNullOrWhiteSpace(m.Descripcion) ? "" : m.Descripcion)</span>
                                    }
                                    else
                                    {
                                        <span title="@m.DescripcionCompleta">@m.DescripcionCompleta</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        @* Columna combinada: entradas en positivo, salidas en negativo. *@
                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.CantidadFirmada)" Caption="Cantidad" Width="115px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    <span class="@(m.CantidadFirmada > 0 ? "text-success fw-semibold" : m.CantidadFirmada < 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(m.CantidadFirmada == 0 ? "—" : m.CantidadFirmada.ToString("N2"))
                                    </span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.ValorUnitario)" Caption="Valor unitario" Width="115px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    <span class="text-muted">@m.ValorUnitario.ToString("N4")</span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.ValorMovimiento)" Caption="Valor movimiento" Width="135px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    <span class="@(m.ValorMovimiento < 0 ? "text-danger" : m.ValorMovimiento > 0 ? "text-success" : "text-muted")">
                                        @m.ValorMovimiento.ToString("N2")
                                    </span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.Saldo)" Caption="Saldo" Width="120px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    @if (m.Saldo.HasValue)
                                    {
                                        <span class="text-dark fw-bold">@m.Saldo.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        @* Pre-corte: antes de la apertura no hay un saldo con
                                           significado (el histórico SIMAFI no arranca de cero). *@
                                        <span class="text-muted" title="Anterior a la carga inicial: histórico informativo">—</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.SaldoValorizado)" Caption="Saldo valorizado" Width="140px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    @if (m.SaldoValorizado.HasValue)
                                    {
                                        <span class="text-dark fw-bold">@m.SaldoValorizado.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="Anterior a la carga inicial: histórico informativo">—</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        @* "Costo ant." arranca oculta (en el selector de columnas): junto al costo
                           promedio permite leer la línea como "venía a X → queda a Y". *@
                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.CostoPromedioAnterior)" Caption="Costo anterior"
                                          Width="125px" TextAlignment="GridTextAlignment.Right" Visible="false">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    @if (m.CostoPromedioAnterior.HasValue)
                                    {
                                        <span class="text-muted">@m.CostoPromedioAnterior.Value.ToString("N4")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="@SinCostoTooltip(m)">—</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>

                        @* Costo promedio al final del grid. *@
                        <DxGridDataColumn FieldName="@nameof(KardexMovimientoDto.CostoPromedioCorrido)" Caption="Costo promedio" Width="130px" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate Context="cell">
                                @if (cell.DataItem is KardexMovimientoDto m)
                                {
                                    @if (m.CostoPromedioCorrido.HasValue)
                                    {
                                        <span class="fw-semibold">@m.CostoPromedioCorrido.Value.ToString("N4")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="@SinCostoTooltip(m)">—</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>

                    <EmptyDataAreaTemplate>
                        <div class="p-4 text-center text-muted">Este artículo no tiene movimientos en el período seleccionado.</div>
                    </EmptyDataAreaTemplate>
                </DxGrid>
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="modern-card text-center text-muted p-5">
            <i class="bi bi-journal-arrow-down" style="font-size: 2.5rem; opacity: 0.4;"></i>
            <p class="mt-3 mb-0">Seleccione un artículo para ver su kardex.</p>
        </div>
    }

    @* Visor del PDF embebido: el reporte se muestra en la misma vista, dentro de un iframe
       (el endpoint responde el PDF inline). No abre pestaña del navegador ni descarga, así que
       el bloqueador de pop-ups no interviene. La barra del visor del navegador ya trae imprimir
       y descargar. *@
    <DxPopup @bind-Visible="pdfVisible" HeaderText="@pdfTitulo" Width="min(1100px, 96vw)"
             Height="90vh" Scrollable="false" CloseOnOutsideClick="true" ShowFooter="false"
             CssClass="kardex-pdf-popup">
        <BodyTemplate>
            @if (!string.IsNullOrWhiteSpace(pdfUrl))
            {
                <iframe class="pdf-frame" src="@pdfUrl" title="@pdfTitulo"></iframe>
            }
        </BodyTemplate>
    </DxPopup>
</div>

@code {
    private const string GridLayoutStorageKey = "almacen-kardex-grid-layout";

    private DxGrid? grid;

    private void MostrarColumnChooser() => grid?.ShowColumnChooser();

    private Task OnLayoutAutoSaving(GridPersistentLayoutEventArgs e)
        => GridLayoutStorage.SaveAsync(JS, GridLayoutStorageKey, e);

    private Task OnLayoutAutoLoading(GridPersistentLayoutEventArgs e)
        => GridLayoutStorage.LoadAsync(JS, GridLayoutStorageKey, e);

    private List<ArticuloListItemDto> articulos = new();
    private List<TipoMovimientoDto> tipos = new();
    private List<BodegaLookupDto> bodegas = new();

    private ArticuloListItemDto? articuloSeleccionado;
    private TipoMovimientoDto? tipoSeleccionado;
    private BodegaLookupDto? bodegaSeleccionada;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    private KardexArticuloDto? kardex;
    private bool isLoading;
    private string? errorMessage;

    /// <summary>
    /// ¿El kardex cargado está acotado a una bodega? Se lee del DTO (eco del filtro con el
    /// que respondió el servidor), no de bodegaSeleccionada, que puede haber cambiado antes
    /// de que termine la consulta.
    /// </summary>
    private bool HayBodegaFiltrada => kardex?.BodegaId is not null;

    private string ExistenciaLabel => HayBodegaFiltrada
        ? "Existencia registrada (bodega)"
        : "Existencia registrada";

    /// <summary>
    /// Existencia del mismo ámbito que el saldo (artículo o bodega). Un "—" significa que la
    /// bodega no tiene ubicación activa para el artículo, así que no hay cifra que comparar.
    /// </summary>
    private string ExistenciaTexto => kardex?.ExistenciaComparable?.ToString("N2") ?? "—";

    private string? ExistenciaTooltip => HayBodegaFiltrada
        ? kardex!.ExistenciaBodega.HasValue
            ? $"Existencia de {BodegaTexto} (alm_articulo_bodega). El total del artículo es {kardex.ExistenciaRegistrada:N2}."
            : $"{BodegaTexto} no tiene existencia registrada (ubicación activa) para este artículo. El total del artículo es {kardex.ExistenciaRegistrada:N2}."
        : null;

    private string BodegaTexto => string.IsNullOrWhiteSpace(bodegaSeleccionada?.Display)
        ? "la bodega seleccionada"
        : bodegaSeleccionada!.Display;

    private string? UnidadMedida => kardex?.UnidadMedida;

    /// <summary>
    /// Sufijo con la unidad de medida del artículo ("286.00 UND"). Si el artículo no tiene
    /// unidad registrada no se pinta nada; en ese caso se muestra el aviso rojo bajo las tarjetas.
    /// </summary>
    private RenderFragment? UnidadSufijo() => string.IsNullOrWhiteSpace(UnidadMedida)
        ? null
        : @<span class="fs-6 fw-normal text-muted ms-1">@UnidadMedida</span>;

    /// <summary>
    /// Por qué una fila no tiene costo promedio. Son dos causas distintas y conviene no
    /// confundirlas: histórico anterior a la apertura, o saldo no positivo (no hay entre qué
    /// dividir).
    /// </summary>
    private static string SinCostoTooltip(KardexMovimientoDto m) => m.EsPreCorte
        ? "Anterior a la carga inicial: histórico informativo"
        : "Sin saldo positivo: no hay cantidad entre la cual repartir el valor";

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogosAsync();

        // Preselección por query string: ?articuloId=ID (preferente) o ?articulo=CODIGO
        // (compat, mientras otras pantallas todavía enlazan por código).
        var articuloIdBuscado = LeerArticuloIdDeQuery();
        if (articuloIdBuscado.HasValue)
        {
            articuloSeleccionado = articulos.FirstOrDefault(a => a.Id == articuloIdBuscado.Value);
        }
        else
        {
            var codigoBuscado = LeerParametroDeQuery("articulo");
            if (!string.IsNullOrWhiteSpace(codigoBuscado))
            {
                articuloSeleccionado = articulos.FirstOrDefault(a =>
                    string.Equals(a.Codigo, codigoBuscado, StringComparison.OrdinalIgnoreCase));
            }
        }

        if (articuloSeleccionado is not null)
        {
            await ConsultarAsync();
        }
    }

    private int? LeerArticuloIdDeQuery()
        => int.TryParse(LeerParametroDeQuery("articuloId"), out var id) ? id : null;

    private string? LeerParametroDeQuery(string nombre)
    {
        var query = new Uri(Navigation.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var par in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var partes = par.Split('=', 2);
            if (partes.Length == 2 && partes[0].Equals(nombre, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(partes[1]);
            }
        }

        return null;
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            // El kardex es histórico: debe poder consultarse el de un artículo
            // DESCONTINUADO (soft-delete, 2026-07-29). Sin IncluirDescontinuados el
            // maestro devuelve solo activos y su historia quedaría inaccesible.
            articulos = await ArticulosClient.GetAsync(new ArticuloFilterDto { IncluirDescontinuados = true });
            tipos = await KardexClient.GetTiposMovimientoAsync();
            bodegas = await BodegasClient.GetLookupAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar los catálogos: {ex.Message}";
        }
    }

    private async Task OnArticuloChanged(ArticuloListItemDto? articulo)
    {
        articuloSeleccionado = articulo;
        if (articulo is null)
        {
            kardex = null;
            return;
        }

        await ConsultarAsync();
    }

    private async Task OnTipoChanged(TipoMovimientoDto? tipo)
    {
        tipoSeleccionado = tipo;
        if (articuloSeleccionado is not null)
        {
            await ConsultarAsync();
        }
    }

    private async Task OnBodegaChanged(BodegaLookupDto? bodega)
    {
        bodegaSeleccionada = bodega;
        if (articuloSeleccionado is not null)
        {
            await ConsultarAsync();
        }
    }

    private async Task ConsultarAsync()
    {
        if (articuloSeleccionado is null)
        {
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;

            var filtro = new KardexFilterDto
            {
                ArticuloId = articuloSeleccionado.Id,
                FechaDesde = fechaDesde.HasValue ? DateOnly.FromDateTime(fechaDesde.Value) : null,
                FechaHasta = fechaHasta.HasValue ? DateOnly.FromDateTime(fechaHasta.Value) : null,
                TipoTransaccion = tipoSeleccionado?.Codigo,
                BodegaId = bodegaSeleccionada?.Id
            };

            kardex = await KardexClient.GetByArticuloAsync(filtro);
            if (kardex is null)
            {
                errorMessage = "No se encontró el kardex del artículo seleccionado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el kardex: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool pdfVisible;
    private string? pdfUrl;
    private string pdfTitulo = "Kardex";

    /// <summary>
    /// Muestra el PDF del kardex EMBEBIDO en la misma vista (iframe dentro de un popup), en vez
    /// de abrir una pestaña del navegador: bajo InteractiveServer un window.open viaja por
    /// SignalR, pierde el gesto del usuario y el bloqueador de pop-ups lo tapa. Desde la barra
    /// del visor el usuario puede imprimir o descargar.
    /// </summary>
    private void MostrarPdf()
    {
        if (articuloSeleccionado is null)
        {
            return;
        }

        var filtro = new KardexFilterDto
        {
            ArticuloId = articuloSeleccionado.Id,
            FechaDesde = fechaDesde.HasValue ? DateOnly.FromDateTime(fechaDesde.Value) : null,
            FechaHasta = fechaHasta.HasValue ? DateOnly.FromDateTime(fechaHasta.Value) : null,
            TipoTransaccion = tipoSeleccionado?.Codigo,
            BodegaId = bodegaSeleccionada?.Id
        };

        pdfTitulo = kardex is not null ? $"Estado de cuenta — {kardex.Codigo} · {kardex.Descripcion}" : "Estado de cuenta";
        pdfUrl = KardexClient.GetPdfArticuloUrl(filtro);
        pdfVisible = true;
    }

    private async Task ExportExcelAsync()
    {
        if (grid is null || kardex is null)
        {
            return;
        }

        var stamp = DateTime.Now.ToString("yyyyMMdd_HHmm");
        await grid.ExportToXlsxAsync($"kardex_{kardex.Codigo}_{stamp}.xlsx", new GridXlExportOptions());
    }
}
