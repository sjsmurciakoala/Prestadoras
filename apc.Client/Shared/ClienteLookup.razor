@using System.Linq.Expressions
@using DevExtreme.AspNet.Data
@using DevExtreme.AspNet.Data.ResponseModel
@using SIAD.Core.DTOs.CaptacionPagos
@using apc.Client.Services.Cobros
@inject CobrosClient CobrosHttp

@* Lookup de cliente con búsqueda REMOTA mientras se escribe (sin perder foco).
   Patrón oficial DevExpress: CustomData + SearchMode=AutoSearch — el combo
   invoca LoadCustomData en cada cambio de texto (respetando SearchDelay) con
   el texto en options.SearchValue, y pagina con Skip/Take al hacer scroll.
   Docs: DxListEditorBase.CustomData / DxDropDownListEditorBase.SearchMode. *@
<DxComboBox TData="ClienteComboDto" TValue="string"
            CustomData="@LoadCustomData"
            TextFieldName="@nameof(ClienteComboDto.NombreCompleto)"
            ValueFieldName="@nameof(ClienteComboDto.Clave)"
            SearchMode="ListSearchMode.AutoSearch"
            SearchFilterCondition="ListSearchFilterCondition.Contains"
            SearchDelay="@SearchDelay"
            ListRenderMode="ListRenderMode.Virtual"
            Value="@Value"
            ValueChanged="OnValueChanged"
            ValueExpression="ValueExpression"
            NullText="@NullText"
            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
            Enabled="@(!Disabled)" />

@code {
    /// <summary>Conservado por compatibilidad de firma; la carga ahora es remota vía CustomData.</summary>
    [Parameter] public IReadOnlyList<ClienteComboDto> Items { get; set; } = Array.Empty<ClienteComboDto>();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? NullText { get; set; } = "Seleccione cliente...";
    /// <summary>Conservado por compatibilidad; con carga remota no aplica mínimo.</summary>
    [Parameter] public int MinSearchLength { get; set; } = 0;
    [Parameter] public int SearchDelay { get; set; } = 300;
    [Parameter] public bool Disabled { get; set; }

    private const int PageSize = 50;

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value);

    private async Task<LoadResult> LoadCustomData(DataSourceLoadOptionsBase options, CancellationToken ct)
    {
        // DevExtreme.AspNet.Data 5.x entrega el texto tecleado como expresión de
        // filtro (["campo","contains","texto"]); se extrae el primer operando.
        var query = ExtractSearchText(options.Filter);
        var skip = options.Skip;
        var take = options.Take > 0 ? options.Take : PageSize;

        // El endpoint filtra por clave/nombre en servidor; se pide una página
        // extra para saber si hay más resultados (scroll virtual).
        var items = await CobrosHttp.GetClientesAsync(query, take: skip + take + 1);
        var page = items.Skip(skip).Take(take).ToList();

        return new LoadResult
        {
            data = page,
            totalCount = items.Count > skip + take ? skip + take + PageSize : skip + page.Count
        };
    }

    private static string? ExtractSearchText(System.Collections.IList? filter)
    {
        if (filter is null) return null;

        if (filter.Count == 3
            && filter[1] is string op
            && op is "contains" or "startswith" or "="
            && filter[2] is string texto)
        {
            return texto;
        }

        foreach (var item in filter)
        {
            if (item is System.Collections.IList anidado)
            {
                var resultado = ExtractSearchText(anidado);
                if (resultado is not null) return resultado;
            }
        }

        return null;
    }
}
