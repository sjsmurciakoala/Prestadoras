@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Datos personales</PageTitle>

<StatusMessage />
<div class="title title-secondary">
    <div class="title-content-text-secondary">Datos personales</div>
</div>
<div>Su cuenta contiene datos personales que usted nos proporcionó. Desde aquí puede descargarlos o eliminarlos.</div>
<div>
    <strong>Al eliminar estos datos se borra su cuenta de forma permanente, y no se puede recuperar.</strong>
</div>
<div class="block-content">
    <div class="button-group">
        <form action="Account/Manage/DownloadPersonalData" method="post" class="w-100">
            <AntiforgeryToken />
            <DxButton SubmitFormOnClick="true" CssClass="w-100" Text="Descargar"></DxButton>
        </form>
        <NavLink href="Account/Manage/DeletePersonalData" class="button-link w-100">
            <DxButton CssClass="w-100" Text="Eliminar" RenderStyleMode="ButtonRenderStyleMode.Outline" RenderStyle="ButtonRenderStyle.Danger"></DxButton>    
        </NavLink>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
