<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-apc-30987f5c-af7c-444f-b186-dc47e7101675</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);Data\genhash\**</DefaultItemExcludes>
    <!-- Declarar RIDs soportados aqui hace que el restore genere targets net9.0/win-x64
         en project.assets.json. Sin esto, publish -r win-x64 falla NETSDK1047. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" Version="25.2.4" />
    <PackageReference Include="DevExpress.Blazor.PdfViewer" Version="25.2.4" />
    <PackageReference Include="DevExpress.AspNetCore.Reporting" Version="25.2.4" />
    <PackageReference Include="DevExpress.Reporting.Core" Version="25.2.4" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <!--
    El CSS aislado de apc.Client (133 archivos .razor.css, ~350 KB: el menu lateral, el layout y
    casi todas las paginas) NO llega al navegador por si solo, y por eso el portal salia sin
    estilos en la barra de navegacion.

    Motivo: apc.Client es una aplicacion Blazor WebAssembly, no una libreria. El SDK genera su
    bundle como "ApplicationBundle" -propio de esa app, AssetMode=CurrentProject- en vez de como
    "ProjectBundle", que es el unico que el proyecto que la referencia fusiona dentro de su propio
    apc.styles.css. El archivo se construye y hasta se copia, pero queda listado solo en
    apc.Client.staticwebassets.endpoints.json, un manifiesto que el host no carga: MapStaticAssets()
    usa apc.staticwebassets.endpoints.json. Nadie lo sirve y la peticion responde 404.

    Se copia al wwwroot del host ANTES de que se resuelvan los static web assets, para que sea un
    archivo mas del sitio y viaje igual en build, en run y en publish. App.razor lo enlaza junto a
    apc.styles.css.

    Si el bundle no aparece, el build FALLA a proposito: un fallo silencioso aqui se traduce en un
    portal publicado sin estilos, que es justo lo que se quiere impedir.
  -->
  <Target Name="CopiarCssAisladoDelCliente"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_BundleCssCliente>$(MSBuildThisFileDirectory)..\apc.Client\obj\$(Configuration)\net9.0\scopedcss\bundle\apc.Client.styles.css</_BundleCssCliente>
    </PropertyGroup>
    <Error Condition="!Exists('$(_BundleCssCliente)')"
           Text="No se encontro el CSS aislado de apc.Client en $(_BundleCssCliente). Sin el, el portal se publica sin los estilos del menu." />
    <Copy SourceFiles="$(_BundleCssCliente)"
          DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\apc.Client.styles.css"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\apc.Client\apc.Client.csproj" />
    <ProjectReference Include="..\SIAD.Reports\SIAD.Reports.csproj" />
    <ProjectReference Include="..\SIAD.Services\SIAD.Services.csproj" />
    <ProjectReference Include="..\SIAD.Data\SIAD.Data.csproj" />
    <ProjectReference Include="..\SIAD.Core\SIAD.Core.csproj" />
    <ProjectReference Include="..\SIAD.Reports\SIAD.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Local.json es por dev/server: cada entorno mantiene el suyo, NO va al publish.
         OJO: en el SDK web los appsettings*.json son items Content, no None — el guard debe ser
         Content Update (con None Update no matchea y el archivo VIAJA al publish; bug 2026-07-14). -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Reportes\Rpt_DE_Transacciones_Bancarias.cs" />
    <Compile Remove="Reportes\Rpt_DE_Transacciones_Bancarias.Designer.cs" />
    <EmbeddedResource Remove="Reportes\Rpt_DE_Transacciones_Bancarias.resx" />
    <Compile Remove="Reportes\Rpt_Dev_Lista_Transacciones_Bancarias.cs" />
    <Compile Remove="Reportes\Rpt_Dev_Lista_Transacciones_Bancarias.Designer.cs" />
    <EmbeddedResource Remove="Reportes\Rpt_Dev_Lista_Transacciones_Bancarias.resx" />
  </ItemGroup>

</Project>
